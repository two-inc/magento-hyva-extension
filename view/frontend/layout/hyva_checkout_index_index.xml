<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<head>
		<!--
			The company popover itself, loaded from the BASE plugin rather than
			reimplemented here (TWO-25503). It is framework-free with a UMD tail,
			so with no RequireJS on the page it attaches
			`window.TwoCompanySearchPanel`.

			`Two_Gateway::` resolves because two-inc/magento2 is a hard composer
			dependency and Magento deploys a module's web assets for every
			frontend theme — verified on the deployed static tree, where
			`Two_Gateway/js/model/surcharge.js` serves under Hyva/default.

			Its STYLING is not shared the same way: the base stylesheet also
			restyles ten classes this checkout already paints (the term chips),
			so the popover's rules are carried in custom.css until they are split
			into a stylesheet of their own.
		-->
		<script src="Two_Gateway::js/model/company-search-panel.js"/>
		<css src="Two_GatewayHyva::css/custom.css"/>
	</head>
    <body>
        <referenceBlock name="before.body.end">
            <block name="two_getway_payment_method"
                template="Two_GatewayHyva::js/payment/company-name-payment.phtml" after="-">
                <arguments>
                    <argument name="branded_view_model" xsi:type="object">
                        Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
