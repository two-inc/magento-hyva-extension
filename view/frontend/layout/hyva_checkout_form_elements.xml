<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="entity-form.field-renderers">
            <!--
                Deliberately NOT gated on the company-search flag any more.

                The address step is the checkout's single company field, so it
                has to be able to supply a company identifier on every store —
                and the identifier input lives in this renderer. Leaving the
                flag on the block meant a store with company search switched
                off got Hyvä's plain text field and no identifier input
                anywhere in the address step.

                The flag still decides everything it decided before: the
                lookup itself, the results dropdown and the mode links are all
                conditional inside the template, and the component refuses to
                search when it is off. What is unconditional now is the field
                pair — name plus identifier — because that pair is what
                placement needs.
            -->
            <block name="form-field.company" as="company" template="Two_GatewayHyva::form/field/companyName.phtml">
                <arguments>
                    <argument name="branded_view_model" xsi:type="object">
                        Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
