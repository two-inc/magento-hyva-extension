<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block name="checkout-shipping-address-company-search"
                ifconfig="payment/two_payment/enable_company_search"
                template="Two_GatewayHyva::component/payment/method/shipping_company.phtml" after="-"/>
        </referenceBlock>
        <referenceBlock name="checkout.payment.methods">
            <!-- Swap in our MethodList so the list refreshes when a carrier
                 is selected (shipping cost feeds the minimum-order gate) -->
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Two\GatewayHyva\Magewire\Checkout\Payment\MethodList
                </argument>
            </arguments>
            <block name="checkout.payment.method.two-payment-method" as="two_payment" ifconfig="payment/two_payment/active" template="Two_GatewayHyva::component/payment/method/gateway_method.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Two\GatewayHyva\Magewire\Checkout\Payment\GatewayMethod
                    </argument>
                    <argument name="branded_view_model" xsi:type="object">
                        Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface
                    </argument>
                    <argument name="method_code" xsi:type="string">two_payment</argument>
                    <argument name="metadata" xsi:type="array">
                        <item name="icon" xsi:type="array">
                            <item name="src" xsi:type="string">Two_GatewayHyva::images/cc/logo.svg</item>
                            <!-- optional attributes, specify as needed -->
                            <item name="attributes" xsi:type="array">
                                <item name="width" xsi:type="number">32</item>
                                <item name="height" xsi:type="number">32</item>
                            </item>
                        </item>
                        <item name="additional_icon_provider" xsi:type="array">
                            <item name="template" xsi:type="string">
                                Two_GatewayHyva::component/tooltip.phtml
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="price-summary.total-segments">
            <!-- Same template registered under both codes: "both" display
                 mode emits both segments (excl-tax + incl-tax rows), any
                 other mode emits only two_surcharge. The block's `as` alias
                 is how Hyva Checkout's TotalSegment block resolves its
                 segment, so the incl row needs its own block/alias pair. -->
            <block name="price-summary.total-segment.two_surcharge"
                   as="two_surcharge"
                   template="Two_GatewayHyva::checkout/price-summary/total-segments/two_surcharge.phtml"/>
            <block name="price-summary.total-segment.two_surcharge_incl"
                   as="two_surcharge_incl"
                   template="Two_GatewayHyva::checkout/price-summary/total-segments/two_surcharge.phtml"/>
            <!-- Fallback for any quote total with no dedicated block here —
                 e.g. a fee extension whose own Hyva-compat module isn't
                 installed. -->
            <block name="price-summary.total-segment.two_other_totals"
                   as="two_other_totals"
                   class="Two\GatewayHyva\Block\Checkout\PriceSummary\OtherTotals"
                   template="Two_GatewayHyva::checkout/price-summary/total-segments/two_other_totals.phtml"/>
        </referenceBlock>
    </body>
</page>
