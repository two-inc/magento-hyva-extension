declare(strict_types=1);

use Hyva\Checkout\Model\Form\EntityFieldInterface;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component\Form as MagewireFormComponent;
use Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface;
use Two\GatewayHyva\ViewModel\CheckoutConfig;

/** @var Template $block */
/** @var EntityFieldInterface $element */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */
/** @var MagewireFormComponent $magewire */

/** @var BrandedHyvaViewModelInterface $brandedViewModel */
$brandedViewModel = $block->getData('branded_view_model');
$gwBase = $brandedViewModel->getAlpineFnPrefix() . 'GatewayHyva';

$configModel = $viewModels->require(CheckoutConfig::class);
/** @Tailwind md:w-1/4 md:w-2/4 md:w-3/4 md:w-4/4 mb-2 */
$element = $block->getData("element");
$attributes = $element->getAttributes();
$renderer = $element->getRenderer();
$form = $block->getData("form");
?>
<div class="<?= $escaper->escapeHtmlAttr(
    $element->renderClass(
        [
            "field",
            "font-medium",
            "text-gray-700",
            $element->isRequired() ? "required" : "not-required",
        ],
        "field-wrapper-inner",
    ),
) ?>">
    <?= /* @noEscape */ $renderer->renderLabel($element) ?>
    <?= /* @noEscape */ $renderer->renderBefore($element) ?>

    <?php
    /*
     * TWO-25326 §7.1 (2026-08-03 ruling): exactly ONE company-search control
     * per platform. When the admin setting points that one control at the
     * payment tile instead, this surface must NOT also render it — it gets a
     * single plain field with no enhancement at all, in the `else` branch
     * below.
     */
    $isCompanySearchInPaymentTile = $configModel->getIsCompanySearchInPaymentTile();
    ?>
    <?php if (!$isCompanySearchInPaymentTile): ?>
    <?php
    /*
     * THE company-search control, included from the one file both mount
     * points share (TWO-25326, 2026-08-05 ruling — see the doc comment in
     * form/field/company-search-control.phtml for why the tile no longer has
     * a second copy of its own).
     *
     * `$twoControlInputAttributes` carries this field's real
     * name/id/value/validation from the entity-field config, so it submits and
     * restores exactly as any other Hyvä address field does. It is built here
     * rather than inside the control because it is the one genuinely
     * surface-specific thing about the input: only this surface has an
     * `EntityFieldInterface` to render it from.
     */
    $twoControlAlpineData = 'x-data="' . $escaper->escapeHtmlAttr($gwBase . 'CompanySearchField') . '"';
    $twoControlInputClass = $escaper->escapeHtmlAttr(
        $element->renderClass(["block w-full form-input grow renderer-text"]),
    );
    $twoControlInputAttributes = ($element->hasAttributes() ? $element->renderAttributes($escaper) : '')
        . ($element->isRequired() ? ' required data-validate=\'{"required":true}\'' : '');
    include $block->getTemplateFile('Two_GatewayHyva::form/field/company-search-control.phtml');
    ?>
    <?php else: ?>
        <?php
        /*
         * TWO-25326 §7.1: the one company-search control lives in the
         * payment tile in this configuration, so the address step gets a
         * PLAIN field for the same underlying attribute — no search, no
         * dropdown, no Alpine component at all. `renderAttributes()` still
         * carries this field's real name/id/value/validation from the
         * entity-field config, so it submits and restores exactly as any
         * other Hyvä address field does; nothing here is company-search
         * specific.
         *
         * No `input-group` class here, for the same reason the control itself
         * does not carry one (TWO-25326 tile bugfix batch, bug 3): that class
         * is Hyvä's shared styling for an input grouped with a real addon, and
         * this wrapper holds exactly ONE bare input and no addon at all.
         * `group`/`flex`/`gap-4` are layout-only and stay.
         */
        ?>
        <div class="group flex gap-4">
            <input
                type="text"
                class="<?= $escaper->escapeHtmlAttr(
                    $element->renderClass(["block w-full form-input grow renderer-text"]),
                ) ?>"
                <?php if ($element->hasAttributes()): ?>
                    <?= /* @noEscape */ $element->renderAttributes($escaper) ?>
                <?php endif; ?>
                <?php if ($element->isRequired()): ?>
                    required
                    data-validate='{"required":true}'
                <?php endif; ?>
                autocomplete="off"
            />
        </div>
    <?php endif ?>
    <?php if ($element->hasTooltip()): ?>
        <?= /* @noEscape */ $element
                ->getRenderer()
                ->renderTooltip($element) ?>
    <?php endif; ?>
</div>
<?php
/*
 * Outside the field wrapper, as before. The wrapper's own closing tag used to
 * be emitted twice on the plain-field branch and once on the search branch —
 * one `</div>` did double duty as the search control's group closer — which
 * left the plain-field rendering with one unbalanced tag. Both branches now
 * close exactly what they open.
 */
?>
<?= /* @noEscape */ $element->getRenderer()->renderAfter($element) ?>
