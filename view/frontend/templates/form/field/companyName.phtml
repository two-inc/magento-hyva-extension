declare(strict_types=1);

use Hyva\Checkout\Model\Form\EntityFieldInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component\Form as MagewireFormComponent;
use Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface;

/** @var Template $block */
/** @var EntityFieldInterface $element */
/** @var Escaper $escaper */
/** @var MagewireFormComponent $magewire */

/** @var BrandedHyvaViewModelInterface $brandedViewModel */
$brandedViewModel = $block->getData('branded_view_model');
$gwBase = $brandedViewModel->getAlpineFnPrefix() . 'GatewayHyva';

/** @Tailwind md:w-1/4 md:w-2/4 md:w-3/4 md:w-4/4 mb-2 */
$element = $block->getData("element");
$attributes = $element->getAttributes();
$renderer = $element->getRenderer();
$form = $block->getData("form");
?>
<div class="<?= $escaper->escapeHtmlAttr(
    $element->renderClass(
        [
            "field",
            "font-medium",
            "text-gray-700",
            $element->isRequired() ? "required" : "not-required",
        ],
        "field-wrapper-inner",
    ),
) ?>">
    <?= /* @noEscape */ $renderer->renderLabel($element) ?>
    <?= /* @noEscape */ $renderer->renderBefore($element) ?>

    <div class="group input-group flex gap-4">
        <div x-data="<?= $gwBase ?>CompanySearchField" class="relative w-full" @click.outside="closeDropdown">
            <input type="text" class="<?= $escaper->escapeHtmlAttr(
                $element->renderClass([
                    "block w-full form-input grow renderer-text",
                ]),
            ) ?>"
            <?php if ($element->hasAttributes()): ?>
                <?= /* @noEscape */ $element->renderAttributes($escaper) ?>
            <?php endif; ?>
            <?php if ($element->isRequired()): ?>
                required
                data-validate='{"required":true}'
            <?php endif; ?>
            autocomplete="off"
            @input.debounce.500ms="getItems"
            />
            <?php
            /*
             * Both mode links carry a term for the company-search flag, in the
             * getter rather than in a PHP branch around the markup. With the
             * lookup switched off there is no search to go back to and nothing
             * for "manual" to be the opposite of, so neither link should
             * render.
             *
             * Keeping the fact in component state rather than in PHP means the
             * markup is the same on both configurations, so the flag can be
             * exercised at runtime — the suite mounts the shipped markup and
             * flips `isCompanySearchEnabled` on the component. That is a weaker
             * check than rendering the off-configuration's own markup, which the
             * harness does not do: it renders the template with the flag on.
             * What it does buy is that a PHP branch cannot hide the off state
             * from the suite entirely.
             */
            ?>
            <!-- Search for company link (shows in manual mode) -->
            <div x-show="manualModeActive" class="mt-1 text-right">
                <span @click.stop="enableSearch" @mousedown.stop class="text-blue-600 text-sm cursor-pointer">
                    <?= $escaper->escapeHtml(__("Search for company")) ?>
                </span>
            </div>
            <?php
            /*
             * Persistent route into manual entry.
             *
             * The other one lives inside the results dropdown, whose
             * `showDropdown` term requires `items.length > 0` — so a buyer
             * whose search returned nothing, failed or was never run had no
             * way into manual entry at all. That is the only path on this
             * surface that lets a company with no registry identifier be
             * entered, so it cannot depend on the search having succeeded.
             *
             * Bound to a bare `searchModeActive` getter rather than to
             * `!manualMode`: CSP-friendly Alpine looks the WHOLE attribute
             * string up as a key on the component, so a negation needs a
             * getter of its own either way, and a bare name is also what the
             * suite's binding reader resolves.
             */
            ?>
            <div x-show="searchModeActive" class="mt-1 text-right">
                <span @click.stop="enterManually" @mousedown.stop
                      class="two-company-manual-entry text-blue-600 text-sm cursor-pointer">
                    <?= $escaper->escapeHtml(__("Enter details manually")) ?>
                </span>
            </div>
            <!-- Search Results Dropdown -->
            <div
                x-show="showDropdown"
                @click.stop
                @mousedown.stop
                class="w-full z-40 border border-gray-200 rounded-b-lg bg-white absolute mt-1 shadow-lg"
            >
                <div class="flex flex-col w-full max-h-[250px] overflow-y-auto">
                    <?php
                    /*
                     * The key must be unique per row and `companyId` is not:
                     * the search response may omit a national identifier, which
                     * maps to ''. Two such hits in one response collided, and
                     * Alpine renders one row per distinct key, so the buyer
                     * silently lost a matching company. The getter falls back to
                     * the list position.
                     */
                    ?>
                    <template x-for="(item, index) in items" :key="<?= $gwBase ?>GetCompanyId">
                        <div
                            :data-index="index"
                            @click.stop="handleItemClick"
                            @mousedown.stop
                            class="cursor-pointer hover:bg-gray-100 p-2 border-b border-gray-100"
                        >
                            <span x-html="item.companyDisplayName"></span>
                        </div>
                    </template>
                </div>
                <!-- Enter manually link inside dropdown -->
                <div class="px-2 py-3 border-t border-gray-200">
                    <span @click.stop="enterManually" @mousedown.stop class="text-blue-600 text-sm cursor-pointer">
                        <?= $escaper->escapeHtml(
                            __("Enter details manually"),
                        ) ?>
                    </span>
                </div>
            </div>
            <?php
            /*
             * Company Number, on the address step.
             *
             * Semantics are the payment tile's, deliberately unchanged rather
             * than reinvented: the field is always rendered and `:disabled` is
             * the ONLY thing that locks it, derived by
             * applyCompanyIdEditability() from "is there a registry-supplied
             * identifier for the name this field currently sits beside".
             * Unlocked when there is not — a hit that arrived without a
             * national identifier, a name typed without picking a hit, manual
             * entry, or a store with the lookup switched off — and locked when
             * one has been written, so a registry number cannot be typed over.
             *
             * `company_id` in the class list is load-bearing: the greyed-out
             * look for the locked state is `input.company_id:disabled` in
             * custom.css, which both surfaces share.
             *
             * It carries NO `name`, so nothing about the address entity's own
             * submission changes — the value is client-side state that reaches
             * placement through the company-selection blob and the payment
             * step, exactly as the company NAME chosen here already does.
             */
            ?>
            <?php
            /*
             * `two_address_company_id`, NOT `company_id`.
             *
             * The payment tile's own number inputs already claim `company_id`
             * and `manual_company_id`, and its bridge resolves that field by
             * `document.getElementById("company_id")`. Both steps can be in the
             * document at once, and a duplicate id makes that lookup return
             * whichever came first in document order — the address step's — so
             * the tile would write its value into this field instead of its own.
             * A distinct id keeps the label association without touching the
             * tile's lookup.
             */
            ?>
            <div class="field two-company-id mt-2">
                <label for="two_address_company_id" class="block font-semibold text-gray-700">
                    <?= $escaper->escapeHtml(__("Company Number")) ?>
                </label>
                <input
                    type="text"
                    id="two_address_company_id"
                    class="company_id block w-full form-input grow renderer-text"
                    autocomplete="off"
                    data-two-company-id="true"
                    :disabled="companyIdDisabled"
                    :value="companyId"
                    @input.debounce.300ms="onCompanyIdInput"
                />
            </div>
        </div>
        <?php if ($element->hasTooltip()): ?>
            <?= /* @noEscape */ $element
                    ->getRenderer()
                    ->renderTooltip($element) ?>
        <?php endif; ?>
    </div>
    <?= /* @noEscape */ $element->getRenderer()->renderAfter($element) ?>
</div>
