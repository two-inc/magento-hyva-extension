declare(strict_types=1);

use Hyva\Checkout\Model\Form\EntityFieldInterface;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component\Form as MagewireFormComponent;
use Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface;
use Two\GatewayHyva\ViewModel\CheckoutConfig;

/** @var Template $block */
/** @var EntityFieldInterface $element */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */
/** @var MagewireFormComponent $magewire */

/** @var BrandedHyvaViewModelInterface $brandedViewModel */
$brandedViewModel = $block->getData('branded_view_model');
$gwBase = $brandedViewModel->getAlpineFnPrefix() . 'GatewayHyva';

$configModel = $viewModels->require(CheckoutConfig::class);
$companySearchMinChars = $configModel->getCompanySearchMinChars();
/** @Tailwind md:w-1/4 md:w-2/4 md:w-3/4 md:w-4/4 mb-2 */
$element = $block->getData("element");
$attributes = $element->getAttributes();
$renderer = $element->getRenderer();
$form = $block->getData("form");
?>
<div class="<?= $escaper->escapeHtmlAttr(
    $element->renderClass(
        [
            "field",
            "font-medium",
            "text-gray-700",
            $element->isRequired() ? "required" : "not-required",
        ],
        "field-wrapper-inner",
    ),
) ?>">
    <?= /* @noEscape */ $renderer->renderLabel($element) ?>
    <?= /* @noEscape */ $renderer->renderBefore($element) ?>

    <div class="group input-group flex gap-4">
        <?php
        /*
         * `two-company-search` is what reserves the trailing padding on the
         * input so the spinner never sits on top of a long company name. It
         * also supplies `position: relative`, which this wrapper already had
         * as a Tailwind utility — the duplicate is deliberate, so the CSS
         * class alone is sufficient and does not depend on the merchant's
         * Tailwind build having emitted `relative`.
         */
        ?>
        <div x-data="<?= $gwBase ?>CompanySearchField" class="two-company-search relative w-full" @click.outside="closeDropdown">
            <input type="text" class="<?= $escaper->escapeHtmlAttr(
                $element->renderClass([
                    "block w-full form-input grow renderer-text",
                ]),
            ) ?>"
            <?php
            /*
             * Empty-field hint (TWO-25288). The address step had none, so an
             * empty company field gave no clue that typing into it searches a
             * company registry rather than just recording free text.
             *
             * Emitted BEFORE renderAttributes() deliberately: duplicate
             * attributes are resolved first-occurrence-wins, and Hyvä's field
             * renderer is free to emit a `placeholder` of its own from the
             * customer attribute's frontend config. Ours has to win, or the hint
             * is silently absent on any install where it does.
             *
             * Static attribute AND an Alpine binding, not either alone: the
             * static one is in the server-rendered HTML so the hint is there
             * before Alpine boots, and the binding is what blanks it once the
             * buyer switches to manual entry.
             */
            ?>
            placeholder="<?= $escaper->escapeHtmlAttr(__('Enter company name to search')) ?>"
            :placeholder="<?= $gwBase ?>GetCompanyNamePlaceholder"
            <?php if ($element->hasAttributes()): ?>
                <?= /* @noEscape */ $element->renderAttributes($escaper) ?>
            <?php endif; ?>
            <?php if ($element->isRequired()): ?>
                required
                data-validate='{"required":true}'
            <?php endif; ?>
            autocomplete="off"
            <?php
            /*
             * Points at the minimum-characters hint below, so a screen reader
             * announces it as a description of this field rather than leaving it
             * as unassociated text elsewhere in the DOM. `x-show` toggles
             * `display`, and assistive technology ignores a described-by target
             * that is hidden, so the association is correct in both states.
             */
            ?>
            aria-describedby="two-company-search-min-chars"
            <?php
            /*
             * TWO-25288 element 5. TWO `@input` handlers, undebounced first.
             *
             * The manual-entry row inside the dropdown must be reachable as
             * soon as the query is long enough to search, which is BEFORE the
             * debounced request fires and long before a result comes back.
             * `noteCompanyQuery` opens the panel on typed length alone;
             * `getItems` still owns the request, and its debounce has to stay
             * where it is or every keystroke goes on the wire.
             *
             * Two attributes rather than one because the names differ —
             * `@input` and `@input.debounce.500ms` — so Alpine registers a
             * listener for each. Duplicate attribute names would not work: the
             * HTML parser keeps only the first.
             */
            ?>
            @input="noteCompanyQuery"
            @input.debounce.500ms="getItems"
            <?php
            /*
             * Arrow-key result navigation, mirroring the payment tile's
             * `OnArrowDown`/`OnArrowUp`/`OnEnterSelect` (gateway_method.phtml).
             * This surface never had it: the dropdown was reachable and
             * openable by keyboard, but once open a keyboard user had no way
             * to move through the results other than Tab-ing item by item —
             * there is no `role="listbox"` here (see the note on the
             * manual-entry row above), so Tab is genuinely the only other
             * route, and it visits the WHOLE page, not just the dropdown.
             * `.prevent` on each stops Enter submitting the address form and
             * the arrow keys moving the caret in the input.
             */
            ?>
            <?php
            /*
             * No `.prevent` modifier on any of these three — deliberately,
             * and different from how this looks on the payment tile.
             *
             * This one input is shared between search AND manual-entry mode
             * (the payment tile's equivalent is two separate elements, one
             * per mode), and a modifier-level `.prevent` fires before Alpine
             * ever calls the handler — it cannot be made conditional on
             * `manualMode` from here. Arrow keys never need to prevent the
             * native caret move (matching the payment tile, which does not
             * prevent them either); Enter DOES need to keep submitting the
             * address form in every case except "a row is highlighted", so
             * that one case is handled inside OnEnterSelect() itself, which
             * receives the real `$event` Alpine passes to a bare handler
             * name and calls `preventDefault()` only then.
             */
            ?>
            @keydown.arrow-down="<?= $gwBase ?>OnArrowDown"
            @keydown.arrow-up="<?= $gwBase ?>OnArrowUp"
            @keydown.enter="<?= $gwBase ?>OnEnterSelect"
            />
            <!--
                In-field searching indicator (TWO-25288). `isSearching` has
                existed in this component's state and been driven correctly for
                some time, but nothing on this surface bound it, so the address
                form searched with no visible feedback at all.

                Same element and same two classes as the payment tile, so one
                stylesheet rule serves both surfaces: the positioning class
                carries position, size and the loading GIF applied as a
                `background-image`. The chip-loading class paints nothing here —
                it is the shared loading hook this markup has always carried,
                kept as a legacy/overlay hook, and its declarations are inert on
                this element. Childless by design — a background image needs no
                child nodes.
            -->
            <span
                x-show="isSearching"
                class="two-company-search__spinner two-term-chip__loading"
                aria-hidden="true"
            ></span>
            <?php
            /*
             * Minimum-characters hint (TWO-25288). Below the threshold the
             * component returns early from getItems() and this surface rendered
             * nothing whatsoever, so one or two characters produced silence
             * indistinguishable from a search that had failed.
             *
             * The number is INTERPOLATED from the same value the guard compares
             * against — never restated as a literal — so the count a buyer is
             * told and the count enforced cannot drift. That drift is the actual
             * defect; the wording is incidental.
             *
             * A FIXED count, not a remaining-count: a message that counts down
             * as you type re-renders on every keystroke and reads as validation
             * failing repeatedly.
             *
             * Sits OUTSIDE the results dropdown, unlike the payment tile's
             * equivalent. The two are mutually exclusive by construction — the
             * panel opens at or above the threshold and this hint shows only
             * below it — so nesting the hint inside the panel would put it
             * somewhere it could never be seen.
             */
            ?>
            <div
                id="two-company-search-min-chars"
                x-show="<?= $gwBase ?>ShouldShowMinCharsMessage"
                class="two-company-search__min-chars mt-1 text-sm text-gray-700"
            ><?= $escaper->escapeHtml(
                __('Please enter %1 or more characters', $companySearchMinChars),
            ) ?></div>
            <?php
            /*
             * Both mode links carry a term for the company-search flag, in the
             * getter rather than in a PHP branch around the markup. With the
             * lookup switched off there is no search to go back to and nothing
             * for "manual" to be the opposite of, so neither link should
             * render.
             *
             * Keeping the fact in component state rather than in PHP means the
             * markup is the same on both configurations, so the flag can be
             * exercised at runtime — the suite mounts the shipped markup and
             * flips `isCompanySearchEnabled` on the component. That is a weaker
             * check than rendering the off-configuration's own markup, which the
             * harness does not do: it renders the template with the flag on.
             * What it does buy is that a PHP branch cannot hide the off state
             * from the suite entirely.
             */
            ?>
            <?php
            /*
             * The way BACK from manual entry, and keyboard-operable for the
             * same reason the two manual-entry affordances now are (TWO-25288
             * element 5).
             *
             * Included in that change rather than left alone deliberately:
             * making the route INTO manual entry reachable by keyboard while
             * leaving the route out of it mouse-only would build a trap that did
             * not exist before — a keyboard user could switch to manual entry
             * and then have no way to switch back.
             */
            ?>
            <!-- Search for company link (shows in manual mode) -->
            <div x-show="manualModeActive" class="mt-1 text-right">
                <span
                    role="button"
                    tabindex="0"
                    @click.stop="enableSearch"
                    @keydown.enter.stop.prevent="enableSearch"
                    @keydown.space.stop.prevent="enableSearch"
                    @mousedown.stop
                    class="two-company-search-again text-blue-600 text-sm cursor-pointer"
                ><?= $escaper->escapeHtml(__("Search for company")) ?></span>
            </div>
            <?php
            /*
             * Manual entry has exactly ONE route on this surface: the row
             * inside the results dropdown, below (TWO-25288 / 4.2 follow-up).
             *
             * A second copy used to live here, below the field, gated on
             * `persistentManualEntryVisible` so it could stand in for the row
             * while the panel was shut — an untouched field, a query too short
             * to search, a full-length query a click outside had dismissed.
             * That is exactly the set of states in which this affordance must
             * NOT be visible per the design set 2026-07-28: it is meant to
             * read as "nothing on this registry matches what you're currently
             * searching for", which is only true while a search is actually
             * live. Shown before any query, or beside a company the buyer had
             * already picked, it reads as a claim about the buyer's own
             * company rather than about the current search — wrong in both
             * cases, not merely redundant with the row.
             *
             * Deleted rather than re-gated onto `showDropdown` directly:
             * binding the SAME condition here as the row already uses would
             * put two identical links on screen at once whenever the panel is
             * open, which the pre-existing dropdown-open test in
             * `company-manual-entry.test.js` already called out as a defect in
             * its own right. The row is the sole surviving affordance and it
             * already carries the correct gate.
             */
            ?>
            <!-- Search Results Dropdown -->
            <div
                x-show="showDropdown"
                @click.stop
                @mousedown.stop
                class="w-full z-40 border border-gray-200 rounded-b-lg bg-white absolute mt-1 shadow-lg"
            >
                <div class="flex flex-col w-full max-h-[250px] overflow-y-auto">
                    <?php
                    /*
                     * The key must be unique per row and `companyId` is not:
                     * the search response may omit a national identifier, which
                     * maps to ''. Two such hits in one response collided, and
                     * Alpine renders one row per distinct key, so the buyer
                     * silently lost a matching company. The getter falls back to
                     * the list position.
                     */
                    ?>
                    <template x-for="(item, index) in items" :key="<?= $gwBase ?>GetCompanyId">
                        <div
                            :data-index="index"
                            @click.stop="handleItemClick"
                            @mousedown.stop
                            <?php
                            /*
                             * Visual highlight for the arrow-key-navigated row,
                             * mirroring the payment tile's `GetItemClass` /
                             * `OnItemMouseover` pair. The mouseover listener
                             * keeps mouse and keyboard highlighting on the same
                             * piece of state, so hovering a row with the mouse
                             * and then pressing an arrow key moves from where
                             * the buyer's mouse actually is, not from wherever
                             * the keyboard last left it.
                             */
                            ?>
                            @mouseover="<?= $gwBase ?>OnItemMouseover"
                            :class="<?= $gwBase ?>GetItemClass"
                            class="cursor-pointer hover:bg-gray-100 p-2 border-b border-gray-100"
                        >
                            <span x-html="item.companyDisplayName"></span>
                        </div>
                    </template>
                </div>
                <?php
                /*
                 * Manual entry, route two: the LAST row inside the dropdown
                 * (TWO-25288 element 5). Deliberately the last child of the
                 * panel and below the results scroller, so it reads as the
                 * final option after the buyer has looked down the list and not
                 * found themselves.
                 *
                 * `role="button"` with `tabindex="0"`, NOT `role="option"`.
                 * This panel is not a listbox: the result rows are plain divs
                 * with no `role="listbox"` on the container, no `role="option"`
                 * on them and no `aria-activedescendant` on the input. A lone
                 * `option` here would be an option with no owning list — invalid
                 * ARIA, and announced worse than no role at all. A button is
                 * also the honest description: this performs an action rather
                 * than selecting a value from the list.
                 *
                 * Enter AND Space, because a `role="button"` is expected to
                 * answer both. `.prevent` on each is load-bearing — without it
                 * Space scrolls the page and Enter submits the address form.
                 * `.stop`, and the `@mousedown.stop`, are what keep the
                 * address-book modal from reading the interaction as a click
                 * outside itself and closing; enterManually() stops propagation
                 * again from inside for the same reason.
                 *
                 * The accessible name is the visible text, so there is no
                 * `aria-label` that can drift out of step with it.
                 */
                ?>
                <div class="px-2 py-3 border-t border-gray-200">
                    <span
                        role="button"
                        tabindex="0"
                        @click.stop="enterManually"
                        @keydown.enter.stop.prevent="enterManually"
                        @keydown.space.stop.prevent="enterManually"
                        @mousedown.stop
                        class="two-company-manual-entry-row text-blue-600 text-sm cursor-pointer"
                    ><?= $escaper->escapeHtml(__("My company is not on the list")) ?></span>
                </div>
            </div>
            <?php
            /*
             * Company Number, on the address step.
             *
             * Semantics are the payment tile's, deliberately unchanged rather
             * than reinvented: the field is always rendered and `:disabled` is
             * the ONLY thing that locks it, derived by
             * applyCompanyIdEditability() from "is there a registry-supplied
             * identifier for the name this field currently sits beside".
             * Unlocked when there is not — a hit that arrived without a
             * national identifier, a name typed without picking a hit, manual
             * entry, or a store with the lookup switched off — and locked when
             * one has been written, so a registry number cannot be typed over.
             *
             * `company_id` in the class list is load-bearing: the greyed-out
             * look for the locked state is `input.company_id:disabled` in
             * custom.css, which both surfaces share.
             *
             * It carries NO `name`, so nothing about the address entity's own
             * submission changes — the value is client-side state that reaches
             * placement through the company-selection blob and the payment
             * step, exactly as the company NAME chosen here already does.
             */
            ?>
            <?php
            /*
             * `two_address_company_id`, NOT `company_id`.
             *
             * The payment tile's own number inputs already claim `company_id`
             * and `manual_company_id`, and its bridge resolves that field by
             * `document.getElementById("company_id")`. Both steps can be in the
             * document at once, and a duplicate id makes that lookup return
             * whichever came first in document order — the address step's — so
             * the tile would write its value into this field instead of its own.
             * A distinct id keeps the label association without touching the
             * tile's lookup.
             */
            ?>
            <?php
            /*
             * Bug 4.3 (2026-07-28) — canonical cross-platform design: once a
             * search result is selected, the company number is NOT its own
             * field. It renders as plain text immediately below the company
             * NAME field, right-aligned to that field's edge. Same visual
             * pattern as 1.1/2.3/3.2 on WooCommerce/PrestaShop/Luma; Hyvä's
             * own mechanism (Alpine + this CSP-nonce build) differs, but the
             * rendered result matches.
             *
             * Gated on `companyIdDisplayVisible` (== hasVouchedCompanyId()):
             * a REGISTRY-supplied number is what "a result is selected" means
             * here. A hand-typed number — no registry hit backs it, so
             * nothing was "selected" — still needs the real editable input
             * below, unchanged: manual entry and a store with the lookup
             * switched off both depend on it staying typeable.
             */
            ?>
            <div
                x-show="companyIdDisplayVisible"
                class="two-company-id-display mt-1 text-right text-sm text-gray-700"
                x-text="companyId"
                aria-label="<?= $escaper->escapeHtmlAttr(__("Company Number")) ?>"
            ></div>
            <div class="field two-company-id mt-2" x-show="!companyIdDisplayVisible">
                <label for="two_address_company_id" class="block font-semibold text-gray-700">
                    <?= $escaper->escapeHtml(__("Company Number")) ?>
                </label>
                <input
                    type="text"
                    id="two_address_company_id"
                    class="company_id block w-full form-input grow renderer-text"
                    autocomplete="off"
                    data-two-company-id="true"
                    :disabled="companyIdDisabled"
                    :value="companyId"
                    @input.debounce.300ms="onCompanyIdInput"
                />
            </div>
        </div>
        <?php if ($element->hasTooltip()): ?>
            <?= /* @noEscape */ $element
                    ->getRenderer()
                    ->renderTooltip($element) ?>
        <?php endif; ?>
    </div>
    <?= /* @noEscape */ $element->getRenderer()->renderAfter($element) ?>
</div>
