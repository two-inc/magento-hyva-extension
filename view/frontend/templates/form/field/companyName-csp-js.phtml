declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface;
use Two\GatewayHyva\ViewModel\CheckoutConfig;
use Two\GatewayHyva\ViewModel\GetQuoteDetails;
use Magento\Framework\Escaper;

/** @var \Magento\Framework\View\Element\Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */
/** @var Escaper $escaper */

/** @var BrandedHyvaViewModelInterface $brandedViewModel */
$brandedViewModel = $block->getData('branded_view_model');
$gwBase = $brandedViewModel->getAlpineFnPrefix() . 'GatewayHyva';

$configModel = $viewModels->require(CheckoutConfig::class);
$quoteModel = $viewModels->require(GetQuoteDetails::class);
$hyvaCsp = $viewModels->require(HyvaCsp::class);

$checkoutApiUrl = $configModel->getCheckoutApiUrl();
$isAddressSearchEnabled = $configModel->getIsAddressSearchEnabled();
$quoteDetails = $quoteModel->getQuoteDetails();
$quoteDetailsJson = json_encode($quoteDetails, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);

/** Generated with hyva-csp-helper.php */
?>
<script>
function <?= $gwBase ?>CompanySearchField() {
    return {
        isOpen: false,
        search: '',
        items: [],
        selectedIndex: -1,
        isSelecting: false,
        manualMode: false,
        checkoutApiUrl: '<?= $checkoutApiUrl ?>',
        isAddressSearchEnabled: '<?= $isAddressSearchEnabled ?>',
        quoteData: <?= $quoteDetailsJson ?>,
        countrySelectionShown: false,
        // Company-search request state. `isSearching` drives an in-field
        // spinner and `isSearchUnavailable` a "try again / enter manually"
        // notice, so a failed search is never rendered as a genuine
        // zero-result one. NOTE: the markup that binds these lives in
        // companyName.phtml, which is being changed concurrently by the
        // CSP-Alpine work — the state lands here now and the template chrome
        // follows in that PR rather than colliding with it.
        isSearching: false,
        isSearchUnavailable: false,
        searchAbortController: null,

        init() {
            // Restore manualMode from storage
            const data = JSON.parse(hyva.getBrowserStorage().getItem('shipping_company_selection') || "{}");
            this.manualMode = data.manual_mode || false;
        },

        showDropdown() {
            return this.isOpen && this.items.length > 0;
        },

        /** Cancel any in-flight company search. Safe to call repeatedly. */
        abortCompanySearch() {
            if (this.searchAbortController) {
                this.searchAbortController.abort();
                this.searchAbortController = null;
            }
            this.isSearching = false;
        },

        async getItems() {
            if (this.isSelecting) { this.isSelecting = false; return; }
            if (this.manualMode) return;
            this.search = this.$el.value;
            this.selectedIndex = -1;
            this.isSearchUnavailable = false;
            if (this.search.length < 3) {
                this.abortCompanySearch();
                this.items = [];
                return;
            }

            // Get country code using centralized helper (defined in gateway_method-csp-js.phtml)
            const countryCode = window.twoGatewayGetCountryCode(this.quoteData);

            // If no country available from any source, show a friendly message once
            if (!countryCode) {
                if (!this.countrySelectionShown) {
                    this.countrySelectionShown = true;
                    window.dispatchMessages([{
                        type: 'warning',
                        text: '<?= $escaper->escapeJs(__('Please select a country first')) ?>'
                    }], 5000);
                }
                return;
            }
            this.countrySelectionShown = false;

            // Supersede any in-flight search so a slow response for an
            // earlier query cannot repopulate the dropdown.
            this.abortCompanySearch();
            const controller = new AbortController();
            this.searchAbortController = controller;
            this.isSearching = true;

            const result = await window.twoGatewayCompanySearch({
                checkoutApiUrl: this.checkoutApiUrl,
                countryCode: countryCode,
                query: this.search,
                limit: 10,
                signal: controller.signal,
            });

            // The buyer typed on, or this component was torn down, while the
            // request was in flight. Writing anything now would fight the
            // newer search — stay silent.
            if (result.status === 'aborted' || this.searchAbortController !== controller) return;

            this.searchAbortController = null;
            this.isSearching = false;
            this.items = result.items;
            // A timeout, non-2xx, network error or degraded 200 must not be
            // rendered as "no companies found".
            this.isSearchUnavailable = result.status === 'failed' || result.status === 'degraded';
            if (this.items.length > 0) this.isOpen = true;
        },

        handleItemClick(event) {
            // Stop all event propagation to prevent address book modal from closing
            event.stopPropagation();
            event.stopImmediatePropagation();
            if (event.preventDefault) event.preventDefault();

            const index = event.currentTarget.dataset.index;
            if (index !== undefined && this.items[index]) {
                this.selectItem(this.items[index]);
            }
        },

        selectItem(item) {
            // The buyer has chosen; anything still on the wire is stale and
            // would reopen a dropdown they have just dismissed.
            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.isSelecting = true;
            this.isOpen = false;
            this.items = [];
            this.search = item.companyName;
            this.manualMode = false;

            const input = this.$root.querySelector('input[type="text"]');
            if (input) {
                input.value = item.companyName;
                // Use bubbles: false to prevent address book modal from closing
                input.dispatchEvent(new Event('input', { bubbles: false }));
            }

            // Preserve quote_id for session detection
            const existingData = JSON.parse(hyva.getBrowserStorage().getItem('shipping_company_selection') || "{}");
            const companyData = {
                quote_id: existingData.quote_id || '',
                company_name: item.companyName,
                company_id: item.companyId,
                manual_mode: false
            };
            hyva.getBrowserStorage().setItem('shipping_company_selection', JSON.stringify(companyData));

            window.dispatchEvent(new CustomEvent("shipping-company-selected", {
                detail: companyData
            }));

            // Address lookup if enabled
            if (this.isAddressSearchEnabled && item.lookupId) {
                this.addressLookup(item.lookupId);
            }
        },

        async addressLookup(lookupId) {
            // Capture root element before async call since $root may not be available in callbacks
            const rootEl = this.$root;
            // Shared helper: carries the same 30s timeout as the search and
            // checks response.ok. Without that check an error body parsed as
            // an address payload and silently produced "no addresses".
            const data = await window.twoGatewayCompanyDetail(this.checkoutApiUrl, lookupId);
            if (data && data.addresses && data.addresses.length > 0) {
                this.setAddressData(data.addresses[0], rootEl);
            }
        },

        setAddressData(address, rootEl) {
            // Find the address section containing this company field
            // Traverse up levels from the component root to find the container with all address inputs
            let container = rootEl;
            for (let i = 0; i < 4 && container; i++) {
                container = container.parentElement;
            }

            if (!container) {
                console.warn('Could not find address container');
                return;
            }

            const cityInput = container.querySelector('input[name="city"]');
            const postcodeInput = container.querySelector('input[name="postcode"]');
            const streetInput = container.querySelector('input[name="street[0]"]');

            if (cityInput) {
                cityInput.value = address.city || "";
            }

            if (postcodeInput) {
                postcodeInput.value = address.postal_code || "";
            }

            if (streetInput) {
                streetInput.value = address.street_address || "";
            }

            // Trigger 'input' event with bubbles: false to prevent modal closure
            [cityInput, postcodeInput, streetInput].forEach(input => {
                if (input) {
                    input.dispatchEvent(new Event('input', { bubbles: false }));
                }
            });
        },

        enterManually(event) {
            // Stop event propagation to prevent address book modal from closing
            if (event) {
                event.stopPropagation();
                event.stopImmediatePropagation();
            }

            this.manualMode = true;
            this.isOpen = false;
            this.items = [];
            this.saveManualModeToStorage(true);
            const input = this.$root.querySelector('input[type="text"]');
            if (input) input.focus();
        },

        enableSearch(event) {
            // Stop event propagation to prevent address book modal from closing
            if (event) {
                event.stopPropagation();
                event.stopImmediatePropagation();
            }

            this.manualMode = false;
            this.saveManualModeToStorage(false);
            const input = this.$root.querySelector('input[type="text"]');
            if (input) input.focus();
        },

        saveManualModeToStorage(manualMode) {
            const data = JSON.parse(hyva.getBrowserStorage().getItem('shipping_company_selection') || "{}");
            data.manual_mode = manualMode;
            hyva.getBrowserStorage().setItem('shipping_company_selection', JSON.stringify(data));
        },

        closeDropdown() {
            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.isOpen = false;
            this.items = [];
        },
    }
}
document.addEventListener('alpine:init', () => {
    Alpine.data('<?= $gwBase ?>CompanySearchField', <?= $gwBase ?>CompanySearchField);
});
</script>
<?php $hyvaCsp->registerInlineScript(); ?>
