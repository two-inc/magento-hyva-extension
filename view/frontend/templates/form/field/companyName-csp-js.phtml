use Two\GatewayHyva\ViewModel\CheckoutConfig;
use Two\GatewayHyva\ViewModel\GetQuoteDetails;
use Magento\Framework\Escaper;

/** @var \Magento\Framework\View\Element\Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */
/** @var Escaper $escaper */

/** @var BrandedHyvaViewModelInterface $brandedViewModel */
$brandedViewModel = $block->getData('branded_view_model');
$gwBase = $brandedViewModel->getAlpineFnPrefix() . 'GatewayHyva';

$configModel = $viewModels->require(CheckoutConfig::class);
$quoteModel = $viewModels->require(GetQuoteDetails::class);
$hyvaCsp = $viewModels->require(HyvaCsp::class);

$checkoutApiUrl = $configModel->getCheckoutApiUrl();
$isAddressSearchEnabled = $configModel->getIsAddressSearchEnabled();
$companySearchMinChars = $configModel->getCompanySearchMinChars();
$quoteDetails = $quoteModel->getQuoteDetails();
// Same flag set as gateway_method-csp-js.phtml, for the same reason: this
// lands in an inline script and carries buyer-supplied values (email,
// telephone, name, product names and descriptions). JSON_HEX_TAG is the
// load-bearing one — without it a product named with a script end tag closes
// the block early, which is both script injection and a second way to move
// where HyvaCsp thinks this element starts and ends. JSON_UNESCAPED_SLASHES
// is deliberately absent: it strips the incidental protection plain
// json_encode() gives by escaping the slash in an end tag.
// JSON_INVALID_UTF8_SUBSTITUTE and the `?: '{}'` are not belt-and-braces. A
// single malformed byte in a product name makes json_encode() return false, and
// this value is interpolated bare, so the template would emit `quote : ,` — a
// syntax error that kills every Alpine.data() registration in the block. That is
// this very outage arriving through data. Substitute the bad byte, and if the
// encode still fails fall back to an empty object: the country lookup then falls
// through to reading the DOM, which degrades instead of dying.
$quoteDetailsJson = json_encode(
    $quoteDetails,
    JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
    | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE,
) ?: '{}';

/** Generated with hyva-csp-helper.php */
?>
<script>
    /*
     * Resolved AT CALL TIME, not at script-eval time, and never by calling
     * `window.twoGatewayReadCompanySelection(...)` bare.
     *
     * Call-time matters: the accessors are published by
     * gateway_method-csp-js.phtml, and this template does not reliably render
     * after it. shipping_company.phtml goes into `head.additional` and so runs
     * BEFORE the publisher; resolving at eval time there would bind the fallback
     * permanently and silently disable carry-over. Deferring makes all three
     * consumers order-independent instead of two-of-three-happen-to-be-fine.
     *
     * The fallback matters because these call sites sit inside the `alpine:init`
     * / `DOMContentLoaded` handlers that also register the pickers and start the
     * payment-form observer: a bare call on a page without the publisher would
     * throw BEFORE those registrations and leave a dead checkout step.
     * Degrading to "no carry-over between steps" is survivable; that is not.
     *
     * Uniquely named per template because these share one global lexical scope,
     * so a name reused across two templates is a redeclaration SyntaxError that
     * kills whichever block is evaluated second.
     *
     * (Deliberately not writing the script start tag in that sentence: Hyva
     * picks the element to sign with a LAST-occurrence, case-insensitive search
     * for it, so a second literal anywhere in the file — a comment included —
     * leaves the real tag unsigned and the enforced checkout CSP refuses the
     * whole block. Test/Unit/View/CspInlineScriptTemplateTest guards it.)
     */
    const twoAddressReadSelection = function() {
        return (window.twoGatewayReadCompanySelection
            || function() { return {}; })();
    };
    const twoAddressWriteSelection = function(patch) {
        return (window.twoGatewayWriteCompanySelection
            || function() { return {}; })(patch);
    };

function <?= $gwBase ?>CompanySearchField() {
    return {
        isOpen: false,
        search: '',
        items: [],
        selectedIndex: -1,
        isSelecting: false,
        manualMode: false,
        checkoutApiUrl: '<?= $escaper->escapeJs($checkoutApiUrl) ?>',
        isAddressSearchEnabled: '<?= $escaper->escapeJs((string) $isAddressSearchEnabled) ?>',
        quoteData: <?= $quoteDetailsJson ?>,
        // The one threshold for this repo, emitted from PHP
        // (CheckoutConfig::COMPANY_SEARCH_MIN_CHARS) rather than written as a
        // literal here — the guard below and the hint that claims the number
        // must be unable to disagree (TWO-25288). Cast to an int so the
        // comparison stays numeric; a quoted value would compare a string.
        minSearchChars: <?= (int) $companySearchMinChars ?>,
        // Placeholder copy (TWO-25288). Held as state, not written inline in
        // the markup only, because the manual-entry mode has to be able to
        // blank it: "Enter company name to search" over a field the buyer is
        // typing into by hand is wrong.
        companyNamePlaceholder: '<?= $escaper->escapeJs(__('Enter company name to search')) ?>',
        countrySelectionShown: false,
        // Company-search request state. `isSearching` drives an in-field
        // spinner and `isSearchUnavailable` a "try again / enter manually"
        // notice, so a failed search is never rendered as a genuine
        // zero-result one. NOTE: the markup that binds these lives in
        // companyName.phtml, which is being changed concurrently by the
        // CSP-Alpine work — the state lands here now and the template chrome
        // follows in that PR rather than colliding with it.
        isSearching: false,
        isSearchUnavailable: false,
        searchAbortController: null,

        init() {
            // Restore manualMode from storage
            const data = twoAddressReadSelection();
            this.manualMode = data.manual_mode || false;
        },

        showDropdown() {
            return this.isOpen && this.items.length > 0;
        },

        /**
         * Bound as `:placeholder` (TWO-25288). The markup also carries a static
         * `placeholder` attribute with the same source string, so the hint is
         * present in the server-rendered HTML before Alpine boots; this getter
         * is what lets manual mode clear it afterwards.
         */
        <?= $gwBase ?>GetCompanyNamePlaceholder() {
            return this.manualMode ? '' : this.companyNamePlaceholder;
        },

        /**
         * Bound as `x-show` on the min-characters hint (TWO-25288).
         *
         * Below the threshold getItems() returns early and this surface used to
         * render nothing at all, so a buyer typing one or two characters got
         * silence and no way to tell a too-short query from a broken search.
         *
         * NOT rendered at zero length: an empty field is the placeholder's job,
         * and stacking both reads as an error on a field nobody has touched.
         * Suppressed in manual mode, where no search runs at all.
         *
         * A bare method rather than an inline expression because Hyvä's
         * CSP-friendly Alpine build resolves an attribute expression as a
         * property lookup and cannot evaluate operators.
         */
        <?= $gwBase ?>ShouldShowMinCharsMessage() {
            return !this.manualMode
                && this.search.length > 0
                && this.search.length < this.minSearchChars;
        },

        // Bound as the dropdown's `x-for :key`, so it must be UNIQUE per row.
        // `companyId` is '' for every hit whose national identifier the search
        // response omitted — which it is allowed to do — so two such hits in
        // one response collided on '', and Alpine renders one row per distinct
        // key: the buyer lost a company that matched, term-dependently. Fall
        // back to the list position, unique by construction, prefixed so it can
        // never collide with a real identifier either.
        //
        // Mirrors <?= $gwBase ?>GetCompanyId() on the payment tile. That surface
        // was fixed on its own; this one is the same bug in the same shape.
        <?= $gwBase ?>GetCompanyId() {
            return this.item.companyId || `two-idx-${this.index}`;
        },

        /** Cancel any in-flight company search. Safe to call repeatedly. */
        abortCompanySearch() {
            if (this.searchAbortController) {
                this.searchAbortController.abort();
                this.searchAbortController = null;
            }
            this.isSearching = false;
        },

        async getItems() {
            // Every early return must leave the spinner down and nothing on
            // the wire, or `isSearching` latches true.
            if (this.isSelecting) {
                this.isSelecting = false;
                this.abortCompanySearch();
                return;
            }
            if (this.manualMode) {
                this.abortCompanySearch();
                return;
            }
            this.search = this.$el.value;
            this.selectedIndex = -1;
            this.isSearchUnavailable = false;
            if (this.search.length < this.minSearchChars) {
                this.abortCompanySearch();
                this.items = [];
                return;
            }

            // Get country code using centralized helper (defined in gateway_method-csp-js.phtml)
            const countryCode = window.twoGatewayGetCountryCode(this.quoteData);

            // If no country available from any source, show a friendly message once
            if (!countryCode) {
                if (!this.countrySelectionShown) {
                    this.countrySelectionShown = true;
                    window.dispatchMessages([{
                        type: 'warning',
                        text: '<?= $escaper->escapeJs(__('Please select a country first')) ?>'
                    }], 5000);
                }
                this.abortCompanySearch();
                return;
            }
            this.countrySelectionShown = false;

            // Supersede any in-flight search so a slow response for an
            // earlier query cannot repopulate the dropdown.
            this.abortCompanySearch();
            const controller = new AbortController();
            this.searchAbortController = controller;
            this.isSearching = true;

            // try/catch: the helper is a window global, and an absent one
            // would throw out of getItems as an unhandled rejection with
            // `isSearching` latched true. Request failures are handled inside
            // the helper, so the catch means something structural.
            let result;
            try {
                result = await window.twoGatewayCompanySearch({
                    checkoutApiUrl: this.checkoutApiUrl,
                    countryCode: countryCode,
                    query: this.search,
                    limit: 10,
                    signal: controller.signal,
                });
            } catch (error) {
                console.error('Company search failed:', error);
                result = { status: 'failed', items: [] };
            }

            // The buyer typed on, or this component was torn down, while the
            // request was in flight. Writing anything now would fight the
            // newer search — stay silent.
            if (result.status === 'aborted' || this.searchAbortController !== controller) return;
            // enterManually() may have fired while this was in flight.
            // showDropdown() has no manualMode term, so writing items here
            // would reopen the dropdown over the manual-entry fields.
            if (this.manualMode) {
                this.isSearching = false;
                this.searchAbortController = null;
                return;
            }
            // Magewire may have re-rendered the address form while this was in
            // flight and replaced the node this component is bound to. Writing
            // `items` then populates a component that is no longer in the
            // document: no dropdown appears, and this dead copy is left holding
            // search state.
            //
            // Checked here rather than by putting `wire:ignore` on the x-data
            // node in companyName.phtml, which is the payment form's remedy for
            // the same class of problem. That subtree is not equivalent: the
            // payment form documents having no wire:model inputs inside it,
            // whereas this one wraps a Magewire-bound address field rendered by
            // Hyva's own form renderer, and opting it out of the diff-merge
            // cycle would stop the field updating.
            // Fails CLOSED: once Alpine has torn the subtree down there is no
            // `_x_dataStack` to walk up to, so `$root` is undefined — the state
            // this most needs to catch.
            if (!this.$root || !this.$root.isConnected) {
                this.isSearching = false;
                this.searchAbortController = null;
                return;
            }

            this.searchAbortController = null;
            this.isSearching = false;
            this.items = result.items;
            // A timeout, non-2xx, network error or degraded 200 must not be
            // rendered as "no companies found".
            this.isSearchUnavailable = result.status === 'failed' || result.status === 'degraded';
            if (this.items.length > 0) this.isOpen = true;
        },

        handleItemClick(event) {
            // Stop all event propagation to prevent address book modal from closing
            event.stopPropagation();
            event.stopImmediatePropagation();
            if (event.preventDefault) event.preventDefault();

            const index = event.currentTarget.dataset.index;
            if (index !== undefined && this.items[index]) {
                this.selectItem(this.items[index]);
            }
        },

        selectItem(item) {
            // The buyer has chosen; anything still on the wire is stale and
            // would reopen a dropdown they have just dismissed.
            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.isSelecting = true;
            this.isOpen = false;
            this.items = [];
            this.search = item.companyName;
            this.manualMode = false;

            const input = this.$root.querySelector('input[type="text"]');
            if (input) {
                input.value = item.companyName;
                // Use bubbles: false to prevent address book modal from closing
                input.dispatchEvent(new Event('input', { bubbles: false }));
            }

            // A merging write, never a rebuild from a key list: dropping
            // `quote_id` that way is what silently disarmed the new-order clear.
            const companyData = twoAddressWriteSelection({
                company_name: item.companyName,
                company_id: item.companyId,
                manual_mode: false
            });

            window.dispatchEvent(new CustomEvent("shipping-company-selected", {
                detail: companyData
            }));

            // Address lookup if enabled
            if (this.isAddressSearchEnabled && item.lookupId) {
                this.addressLookup(item.lookupId);
            }
        },

        async addressLookup(lookupId) {
            // Capture root element before async call since $root may not be available in callbacks
            const rootEl = this.$root;
            // Shared helper: carries the same 30s timeout as the search and
            // checks response.ok. Without that check an error body parsed as
            // an address payload and silently produced "no addresses".
            const data = await window.twoGatewayCompanyDetail(this.checkoutApiUrl, lookupId);
            if (data && data.addresses && data.addresses.length > 0) {
                this.setAddressData(data.addresses[0], rootEl);
            }
        },

        setAddressData(address, rootEl) {
            // Find the address section containing this company field
            // Traverse up levels from the component root to find the container with all address inputs
            let container = rootEl;
            for (let i = 0; i < 4 && container; i++) {
                container = container.parentElement;
            }

            if (!container) {
                console.warn('Could not find address container');
                return;
            }

            const cityInput = container.querySelector('input[name="city"]');
            const postcodeInput = container.querySelector('input[name="postcode"]');
            const streetInput = container.querySelector('input[name="street[0]"]');

            if (cityInput) {
                cityInput.value = address.city || "";
            }

            if (postcodeInput) {
                postcodeInput.value = address.postal_code || "";
            }

            if (streetInput) {
                streetInput.value = address.street_address || "";
            }

            // Trigger 'input' event with bubbles: false to prevent modal closure
            [cityInput, postcodeInput, streetInput].forEach(input => {
                if (input) {
                    input.dispatchEvent(new Event('input', { bubbles: false }));
                }
            });
        },

        enterManually(event) {
            // Stop event propagation to prevent address book modal from closing
            if (event) {
                event.stopPropagation();
                event.stopImmediatePropagation();
            }

            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.manualMode = true;
            this.isOpen = false;
            this.items = [];
            this.saveManualModeToStorage(true);
            const input = this.$root.querySelector('input[type="text"]');
            if (input) input.focus();
        },

        enableSearch(event) {
            // Stop event propagation to prevent address book modal from closing
            if (event) {
                event.stopPropagation();
                event.stopImmediatePropagation();
            }

            this.manualMode = false;
            this.saveManualModeToStorage(false);
            const input = this.$root.querySelector('input[type="text"]');
            if (input) input.focus();
        },

        saveManualModeToStorage(manualMode) {
            twoAddressWriteSelection({ manual_mode: manualMode });
        },

        closeDropdown() {
            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.isOpen = false;
            this.items = [];
        },
    }
}
document.addEventListener('alpine:init', () => {
    Alpine.data('<?= $gwBase ?>CompanySearchField', <?= $gwBase ?>CompanySearchField);
});
</script>
