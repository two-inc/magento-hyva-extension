            }

            const cityInput = container.querySelector('input[name="city"]');
            const postcodeInput = container.querySelector('input[name="postcode"]');
            const streetInput = container.querySelector('input[name="street[0]"]');

            if (cityInput) {
                cityInput.value = address.city || "";
            }

            if (postcodeInput) {
                postcodeInput.value = address.postal_code || "";
            }

            if (streetInput) {
                streetInput.value = address.street_address || "";
            }

            // Trigger 'input' event with bubbles: false to prevent modal closure
            [cityInput, postcodeInput, streetInput].forEach(input => {
                if (input) {
                    input.dispatchEvent(new Event('input', { bubbles: false }));
                }
            });
        },

        enterManually(event) {
            // Stop event propagation to prevent address book modal from closing
            if (event) {
                event.stopPropagation();
                event.stopImmediatePropagation();
            }

            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.manualMode = true;
            this.isOpen = false;
            this.items = [];
            this.selectedIndex = -1;
            this.query = '';
            this.searchCompletedFor = null;
            this.saveManualModeToStorage(true);
            // Manual entry is one of the reasons the number field has to be
            // typeable; no separate unlock, the same single writer decides.
            this.applyCompanyIdEditability();
            /*
             * TWO-25326 §2: activating this control must PLACE FOCUS in the
             * manual company-name field, and it must actually land there.
             *
             * Deferred to the next tick because the panel this button lives in
             * is being closed in the same call: focusing before Alpine has
             * flushed that leaves focus fighting the teardown. `companyNameField()`
             * rather than a document-order text-input lookup, for the same
             * reason as in selectItem().
             */
            this.$nextTick(() => {
                this.focusAndVerify(this.companyNameField());
            });
        },

        enableSearch(event) {
            // Stop event propagation to prevent address book modal from closing
            if (event) {
                event.stopPropagation();
                event.stopImmediatePropagation();
            }

            this.manualMode = false;
            this.saveManualModeToStorage(false);
            // Goes through the single writer rather than assigning a lock
            // directly: leaving manual mode must not re-lock a number the buyer
            // still has to fill in, because the name in the field has no
            // registry-supplied identifier either way.
            this.applyCompanyIdEditability();

            /*
             * TWO-25326 §3: returning to search mode opens the dropdown and
             * puts focus in its QUERY field, not back on the company-name
             * field. openDropdown() owns both, including the focus-landed
             * check, and it re-runs the search itself once the query is long
             * enough — which on this path it never is, since the query field
             * starts empty.
             *
             * The previous revision focused the company-name field and
             * re-searched whatever text it held. Neither is right any more:
             * that field is no longer a search box, and its contents are the
             * buyer's manually-typed company name, not a query.
             */
            this.openDropdown('');
        },

        saveManualModeToStorage(manualMode) {
            twoAddressWriteSelection({ manual_mode: manualMode });
        },

        /**
         * Shut the panel and reset everything that belongs to it.
         *
         * The query text is part of that (TWO-25326 §1): it is the panel's
         * state, not the buyer's captured company, so a reopened panel starts
         * from the min-characters hint rather than from a term that was
         * abandoned. `searchCompletedFor` goes with it or "No matches found"
         * would be waiting, already true, the next time the panel opens.
         */
        closeDropdown() {
            this.abortCompanySearch();
            this.isSearchUnavailable = false;
            this.isOpen = false;
            this.items = [];
            this.selectedIndex = -1;
            this.query = '';
            this.searchCompletedFor = null;
            const q = this.queryField();
            if (q) q.value = '';
        },

        // Arrow-key result navigation. Mirrors the payment tile's
        // nextItem()/prevItem()/adjustScroll()/selectHighlightedItem() —
        // this surface never had them, so keyboard users could open the
        // dropdown but never move through it without a mouse. Clamped, not
        // wrapping: arriving at either end and pressing the same direction
        // again is a no-op, matching the payment tile.
        <?= $gwBase ?>OnArrowDown() {
            this.nextItem();
        },
        <?= $gwBase ?>OnArrowUp() {
            this.prevItem();
        },
        <?= $gwBase ?>OnEnterSelect(event) {
            // This input is shared between search AND manual-entry mode —
            // unlike the payment tile, where the two modes are separate
            // elements — so Enter has to keep submitting the address form
            // exactly as it always did, EXCEPT when there is a highlighted
            // row VISIBLY on offer to select. Only that one case calls
            // `preventDefault()`; every other Enter press falls through to
            // the native submit unchanged.
            //
            // `showDropdown()` is the gate, not a bare `manualMode` check —
            // it already folds that in via `searchModeActive`, and it is the
            // only term that answers "is a row VISIBLY on offer". The race it
            // used to be justified by is gone: `noteCompanyQuery()` no longer
            // closes the panel, and it now clears `items`/`selectedIndex`
            // synchronously below the threshold rather than leaving that to
            // the debounced tick. The gate stays because the three terms are
            // still the honest question, not because of that race.
            if (!this.showDropdown() || this.selectedIndex < 0 || this.items.length === 0) {
                return;
            }
            event.preventDefault();
            this.selectHighlightedItem();
        },
        <?= $gwBase ?>OnItemMouseover(event) {
            this.selectedIndex = parseInt(event.currentTarget.dataset.index, 10);
        },
        <?= $gwBase ?>GetItemClass() {
            return this.selectedIndex === this.index
                ? 'bg-gray-100'
                : '';
        },

        nextItem() {
            if (this.selectedIndex < this.items.length - 1) {
                this.selectedIndex++;
                this.adjustScroll();
            }
        },

        prevItem() {
            if (this.selectedIndex > 0) {
                this.selectedIndex--;
                this.adjustScroll();
            }
        },

        adjustScroll() {
            this.$nextTick(() => {
                // The actual dropdown scroll container in THIS component's
                // markup (companyName.phtml) — not `.two-company-search-results`,
                // which is a payment-tile-only class name that does not exist
                // here and would silently never match.
                const dropdown = this.$root.querySelector('.two-company-search__results');
                const highlighted = this.$root.querySelectorAll('[data-index]')[this.selectedIndex];

                if (dropdown && highlighted) {
                    const dropdownRect = dropdown.getBoundingClientRect();
                    const itemRect = highlighted.getBoundingClientRect();

                    if (itemRect.bottom > dropdownRect.bottom) {
                        dropdown.scrollTop += itemRect.bottom - dropdownRect.bottom;
                    } else if (itemRect.top < dropdownRect.top) {
                        dropdown.scrollTop -= dropdownRect.top - itemRect.top;
                    }
                }
            });
        },

        selectHighlightedItem() {
            if (this.selectedIndex >= 0 && this.items.length > 0 && this.items[this.selectedIndex]) {
                this.selectItem(this.items[this.selectedIndex]);
            }
        },
    }
}
document.addEventListener('alpine:init', () => {
    Alpine.data('<?= $gwBase ?>CompanySearchField', <?= $gwBase ?>CompanySearchField);
});
</script>
