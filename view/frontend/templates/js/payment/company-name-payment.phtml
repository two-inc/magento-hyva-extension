declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface;
use Two\GatewayHyva\ViewModel\GetQuoteDetails;
use Hyva\Theme\Model\ViewModelRegistry;

/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

/**
 * The brand's own payment method code. Supplied as a layout argument — see
 * hyva_checkout_index_index.xml, in this same commit, because without it
 * getData() returns null and the first getMethodCode() call fatals.
 *
 * @var BrandedHyvaViewModelInterface $brandedViewModel
 */
$brandedViewModel = $block->getData('branded_view_model');

$quoteModel = $viewModels->require(GetQuoteDetails::class);
$quoteDetails = $quoteModel->getQuoteDetails() ?? [];
$currentQuoteId = $quoteDetails['quote_id'] ?? '';
$methodCode = $brandedViewModel->getMethodCode();
?>
<script>
    /*
     * Resolved AT CALL TIME, not at script-eval time, and never by calling
     * `window.twoGatewayReadCompanySelection(...)` bare.
     *
     * Call-time matters: the accessors are published by
     * gateway_method-csp-js.phtml, and this template does not reliably render
     * after it. shipping_company.phtml goes into `head.additional` and so runs
     * BEFORE the publisher; resolving at eval time there would bind the fallback
     * permanently and silently disable carry-over. Deferring makes all three
     * consumers order-independent instead of two-of-three-happen-to-be-fine.
     *
     * The fallback matters because these call sites sit inside the `alpine:init`
     * / `DOMContentLoaded` handlers that also register the pickers: a bare call
     * on a page without the publisher would throw BEFORE those registrations and
     * leave a dead checkout step.
     * Degrading to "no carry-over between steps" is survivable; that is not.
     *
     * Uniquely named per template because these share one global lexical scope,
     * so a name reused across two templates is a redeclaration SyntaxError that
     * kills whichever block is evaluated second.
     *
     * (Deliberately not writing the script start tag in that sentence: Hyva
     * picks the element to sign with a LAST-occurrence, case-insensitive search
     * for it, so a second literal anywhere in the file — a comment included —
     * leaves the real tag unsigned and the enforced checkout CSP refuses the
     * whole block. Test/Unit/View/CspInlineScriptTemplateTest guards it.)
     */
    const twoPaymentReadSelection = function() {
        return (window.twoGatewayReadCompanySelection
            || function() { return {}; })();
    };
    const twoPaymentWriteSelection = function(patch) {
        return (window.twoGatewayWriteCompanySelection
            || function() { return {}; })(patch);
    };

    /**
     * Current quote ID from PHP - used to detect new checkout sessions
     */
    const currentQuoteId = '<?= $escaper->escapeJs((string) $currentQuoteId) ?>';

    document.addEventListener("DOMContentLoaded", () => {

        /**
         * Drop the previous ORDER's company from this store view's selection.
         *
         * Quote only. The storage key carries the store view, so a store change
         * needs no comparison — each view keeps its own selection.
         *
         * Byte-identical in shape to the sibling in shipping_company.phtml, and
         * deliberately so: that template is behind the company-search config
         * flag, so on a store with the flag OFF this is the only clearer there
         * is and it has to behave the same.
         */
        const clearStaleCompanyDataIfNeeded = () => {
            const storedData = twoPaymentReadSelection();
            const storedQuoteId = String(storedData.quote_id || '');

            if (currentQuoteId && storedQuoteId && storedQuoteId !== currentQuoteId) {
                twoPaymentWriteSelection({
                    quote_id: currentQuoteId,
                    company_name: '',
                    company_id: '',
                    manual_mode: false
                });
                return;
            }

            if (!storedQuoteId && currentQuoteId) {
                twoPaymentWriteSelection({ quote_id: currentQuoteId });
            }
        };
        clearStaleCompanyDataIfNeeded();

        /*
         * The same new-order clear for the BILLING company record
         * (TWO-25326 review round 3).
         *
         * Not optional housekeeping: the billing record is a second storage key
         * with the same lifetime problem as the first, and without this a
         * company named on one order's payment step would be restored, as a
         * captured read-only label, onto the NEXT order — for a buyer who never
         * chose it and cannot see where it came from.
         *
         * Guarded on the helpers existing: this template runs before
         * gateway_method-csp-js.phtml publishes them, so the call happens on
         * DOMContentLoaded, by which point it has.
         */
        const clearStaleBillingCompanyIfNeeded = () => {
            if (!window.twoGatewayReadBillingCompany
                || !window.twoGatewayWriteBillingCompany
                || !window.twoGatewayClearBillingCompany) {
                return;
            }
            const billingData = window.twoGatewayReadBillingCompany();
            if (Object.keys(billingData).length === 0) return;

            const billingQuoteId = String(billingData.quote_id || '');
            if (currentQuoteId && billingQuoteId && billingQuoteId !== currentQuoteId) {
                window.twoGatewayClearBillingCompany();
                return;
            }
            if (!billingQuoteId && currentQuoteId) {
                window.twoGatewayWriteBillingCompany({ quote_id: currentQuoteId });
            }
        };
        clearStaleBillingCompanyIfNeeded();

    });


    /** Listen for the event that triggers when a payment method is activated during checkout */
    window.addEventListener("checkout:payment:method-activate", (event) => {
        const paymentMethod = event.detail.method;

        /** Check if the selected payment method is this brand's Two method */
        if (paymentMethod === '<?= $escaper->escapeJs($methodCode) ?>') {
            /*
             * ORDER-INTENT RESOLUTION. The tile's company is the invoice-role
             * one, so its own BILLING record is the only record read here — a
             * company picked in the tile before Two became the active payment
             * method never got its intent fired, and this handler is the retry.
             *
             * Guarded on the helper existing: this template can run before
             * gateway_method-csp-js.phtml has published it.
             */
            const billingCompanySelectionData = (window.twoGatewayReadBillingCompany
                || function () { return {}; })();
            const capturedCompany = billingCompanySelectionData.company_name || "";
            const capturedCompanyId = billingCompanySelectionData.company_id || "";

            // Trigger order intent if we have company data
            if (capturedCompany && capturedCompanyId) {
                window.dispatchEvent(new Event("dispatch-order-intent"));
            }
        }
    });
</script>
<?php $hyvaCsp->registerInlineScript(); ?>
