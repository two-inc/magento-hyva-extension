declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Two\GatewayHyva\ViewModel\BrandedHyvaViewModelInterface;
use Two\GatewayHyva\ViewModel\GetQuoteDetails;
use Hyva\Theme\Model\ViewModelRegistry;

/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

/**
 * The brand's own payment method code. Supplied as a layout argument — see
 * hyva_checkout_index_index.xml, in this same commit, because without it
 * getData() returns null and the first getMethodCode() call fatals.
 *
 * @var BrandedHyvaViewModelInterface $brandedViewModel
 */
$brandedViewModel = $block->getData('branded_view_model');

$quoteModel = $viewModels->require(GetQuoteDetails::class);
$quoteDetails = $quoteModel->getQuoteDetails() ?? [];
$currentQuoteId = $quoteDetails['quote_id'] ?? '';
$methodCode = $brandedViewModel->getMethodCode();
?>
<script>
    /*
     * Resolved AT CALL TIME, not at script-eval time, and never by calling
     * `window.twoGatewayReadCompanySelection(...)` bare.
     *
     * Call-time matters: the accessors are published by
     * gateway_method-csp-js.phtml, and this template does not reliably render
     * after it. shipping_company.phtml goes into `head.additional` and so runs
     * BEFORE the publisher; resolving at eval time there would bind the fallback
     * permanently and silently disable carry-over. Deferring makes all three
     * consumers order-independent instead of two-of-three-happen-to-be-fine.
     *
     * The fallback matters because these call sites sit inside the `alpine:init`
     * / `DOMContentLoaded` handlers that also register the pickers and start the
     * payment-form observer: a bare call on a page without the publisher would
     * throw BEFORE those registrations and leave a dead checkout step.
     * Degrading to "no carry-over between steps" is survivable; that is not.
     *
     * Uniquely named per template because these share one global lexical scope,
     * so a name reused across two templates is a redeclaration SyntaxError that
     * kills whichever block is evaluated second.
     *
     * (Deliberately not writing the script start tag in that sentence: Hyva
     * picks the element to sign with a LAST-occurrence, case-insensitive search
     * for it, so a second literal anywhere in the file — a comment included —
     * leaves the real tag unsigned and the enforced checkout CSP refuses the
     * whole block. Test/Unit/View/CspInlineScriptTemplateTest guards it.)
     */
    const twoPaymentReadSelection = function() {
        return (window.twoGatewayReadCompanySelection
            || function() { return {}; })();
    };
    const twoPaymentWriteSelection = function(patch) {
        return (window.twoGatewayWriteCompanySelection
            || function() { return {}; })(patch);
    };

    /**
     * Track initialization state to prevent duplicate order intents
     */
    let paymentFieldsInitialized = false;

    /**
     * Current quote ID from PHP - used to detect new checkout sessions
     */
    const currentQuoteId = '<?= $escaper->escapeJs((string) $currentQuoteId) ?>';

    /**
     * Check if billing address is set to be the same as shipping address.
     * This respects Hyva Checkout's billingAsShipping checkbox state.
     */
    const isBillingAsShipping = () => {
        const checkbox = document.querySelector('#billing-as-shipping');
        return checkbox ? checkbox.checked : true; // Default to true if checkbox not found
    };

    /**
     * Update payment fields with company data and handle event synchronization.
     * Only updates if billing is same as shipping OR if forceUpdate is true.
     */
    const updatePaymentFields = (companyName, companyId, triggerOrderIntent = false, forceUpdate = false) => {
        // Only sync if billing is same as shipping, unless force update is requested
        if (!forceUpdate && !isBillingAsShipping()) {
            return;
        }
        const companyNameInput = document.querySelector('[data-name="company_name"]');
        const companyIdInput = document.querySelector('[data-name="company_id"]');

        if (companyNameInput && companyIdInput) {
            /*
             * Values only — this function does NOT touch `disabled` or the
             * background colour any more.
             *
             * It used to write `disabled = false; value = …; disabled = true`
             * plus a grey background, and never reverse it. That made every
             * shipping sync lock the field unconditionally, so once any
             * identifier-BEARING company had synced here, picking an
             * identifier-LESS one left `company_id` empty AND disabled: a
             * required field the buyer had no way to fill. The lock is now
             * derived state in the Alpine component
             * (`companyIdDisabled`, bound as `:disabled`), which the
             * `update-company-data` event below recomputes from what actually
             * arrived, and the grey comes from `input.company_id:disabled` in
             * custom.css.
             */
            companyNameInput.value = companyName;
            companyIdInput.value = companyId;

            // Sync with Alpine.js component using event dispatch
            const alpineComponent = companyNameInput.closest('[x-data]');
            if (alpineComponent) {
                alpineComponent.dispatchEvent(new CustomEvent('update-company-data', {
                    detail: {
                        companyName,
                        companyId
                    }
                }));
            }

            // Update saved company details
            const updatedCompanyDetails = {
                company_name: companyName,
                company_id: companyId
            };
            hyva.getBrowserStorage().setItem('already_saved_company_details', JSON.stringify(updatedCompanyDetails));

            // Trigger order intent if requested
            if (triggerOrderIntent) {
                window.dispatchEvent(new Event("dispatch-order-intent"));
            }
        }
    };

    document.addEventListener("DOMContentLoaded", () => {

        /**
         * Drop the previous ORDER's company from this store view's selection.
         *
         * Quote only. The storage key carries the store view, so a store change
         * needs no comparison — each view keeps its own selection.
         *
         * Byte-identical in shape to the sibling in shipping_company.phtml, and
         * deliberately so: that template is behind the company-search config
         * flag, so on a store with the flag OFF this is the only clearer there
         * is and it has to behave the same.
         */
        const clearStaleCompanyDataIfNeeded = () => {
            const storedData = twoPaymentReadSelection();
            const storedQuoteId = String(storedData.quote_id || '');

            if (currentQuoteId && storedQuoteId && storedQuoteId !== currentQuoteId) {
                twoPaymentWriteSelection({
                    quote_id: currentQuoteId,
                    company_name: '',
                    company_id: '',
                    manual_mode: false
                });
                return;
            }

            if (!storedQuoteId && currentQuoteId) {
                twoPaymentWriteSelection({ quote_id: currentQuoteId });
            }
        };
        clearStaleCompanyDataIfNeeded();

        /**
         * Initialize previously saved company details only if it doesn't exist.
         * This preserves company information across page reloads while allowing clean state for new sessions.
         */
        if (!hyva.getBrowserStorage().getItem('already_saved_company_details')) {
            hyva.getBrowserStorage().setItem('already_saved_company_details', JSON.stringify({}));
        }

        /**
         * Initialize payment fields with persisted shipping company data on page load.
         * This ensures payment section reflects the current shipping selection after page refresh.
         */
        const initializePaymentFieldsFromShipping = () => {
            const shippingCompanySelectionData = twoPaymentReadSelection();
            const shippingCompany = shippingCompanySelectionData.company_name || "";
            const shippingCompanyId = shippingCompanySelectionData.company_id || "";

            // Also check if shipping field has persisted data (backend persistence)
            const shippingField = document.getElementById('shipping-company');
            const persistedShippingValue = shippingField ? shippingField.value : "";


            if (shippingCompany && shippingCompanyId) {
                // Use stored shipping selection data
                updatePaymentFields(shippingCompany, shippingCompanyId);
                paymentFieldsInitialized = true;
            } else if (persistedShippingValue) {
                // If shipping field has persisted value but no storage data,
                // we should restore the storage data for consistency
                const shippingCompanyIdField = document.getElementById('shipping-company_id');
                const persistedShippingIdValue = shippingCompanyIdField ? shippingCompanyIdField.value : "";

                if (persistedShippingIdValue) {
                    // A merging write. This used to substitute a two-key object
                    // for the whole blob, which silently dropped `quote_id` —
                    // and the clearer above needs both quote ids non-empty, so
                    // one page load through here disarmed the new-order clear
                    // for the rest of the quote. `manual_mode` has to survive
                    // too, or a reload throws a buyer who is mid-manual-entry on
                    // the ADDRESS form back into search mode.
                    twoPaymentWriteSelection({
                        quote_id: shippingCompanySelectionData.quote_id || currentQuoteId,
                        company_name: persistedShippingValue,
                        company_id: persistedShippingIdValue
                    });
                    updatePaymentFields(persistedShippingValue, persistedShippingIdValue);
                    paymentFieldsInitialized = true;
                }
            }
        };

        // Use MutationObserver to watch for payment form elements
        const observeForPaymentForm = () => {
            if (paymentFieldsInitialized) return;

            const companyNameInput = document.querySelector('[data-name="company_name"]');
            const companyIdInput = document.querySelector('[data-name="company_id"]');

            if (companyNameInput && companyIdInput) {
                // Payment form is already ready, initialize immediately
                initializePaymentFieldsFromShipping();
                paymentFieldsInitialized = true;

                // Check if this brand's Two method is already selected on page
                // load and trigger order intent if needed
                const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');
                if (activePaymentMethod && activePaymentMethod.value === '<?= $escaper->escapeJs($methodCode) ?>') {
                    const shippingCompanySelectionData = twoPaymentReadSelection();
                    if (shippingCompanySelectionData.company_name && shippingCompanySelectionData.company_id) {
                        window.dispatchEvent(new Event("dispatch-order-intent"));
                    }
                }
                return;
            }

            // Set up MutationObserver to watch for payment form elements
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.type === 'childList') {
                        const companyNameInput = document.querySelector('[data-name="company_name"]');
                        const companyIdInput = document.querySelector('[data-name="company_id"]');

                        if (companyNameInput && companyIdInput) {
                            initializePaymentFieldsFromShipping();
                            paymentFieldsInitialized = true;

                            // Check if this brand's Two method is already selected and trigger order intent
                            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');
                            if (activePaymentMethod && activePaymentMethod.value === '<?= $escaper->escapeJs($methodCode) ?>') {
                                const shippingCompanySelectionData = twoPaymentReadSelection();
                                if (shippingCompanySelectionData.company_name && shippingCompanySelectionData.company_id) {
                                    window.dispatchEvent(new Event("dispatch-order-intent"));
                                }
                            }
                            observer.disconnect(); // Stop observing once we've found the elements
                        }
                    }
                });
            });

            // Start observing the document for changes
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        };

        // Start observing for payment form
        observeForPaymentForm();
    });


    /** Listen for the event that triggers when a payment method is activated during checkout */
    window.addEventListener("checkout:payment:method-activate", (event) => {
        const paymentMethod = event.detail.method;

        /** Check if the selected payment method is this brand's Two method */
        if (paymentMethod === '<?= $escaper->escapeJs($methodCode) ?>') {
            /** Initialize payment method but don't overwrite existing company data */
            /** The company data should only be updated by shipping section selections */

            /** Retrieve previously saved company details to check if order intent should be dispatched */
            const shippingCompanySelectionData = twoPaymentReadSelection();
            const alreadySavedCompanyDetails = JSON.parse(hyva.getBrowserStorage().getItem('already_saved_company_details') || "{}");

            const shippingCompany = shippingCompanySelectionData.company_name || "";
            const shippingCompanyId = shippingCompanySelectionData.company_id || "";
            const savedShippingCompany = alreadySavedCompanyDetails.company_name || "";
            const savedShippingCompanyId = alreadySavedCompanyDetails.company_id || "";

            /** If we have shipping company data but payment fields are empty, populate them */
            if (shippingCompany && shippingCompanyId) {
                const companyNameInput = document.querySelector('[data-name="company_name"]');
                const companyIdInput = document.querySelector('[data-name="company_id"]');

                if (companyNameInput && companyIdInput && !companyNameInput.value) {
                    // Use the centralized update function for consistency and Alpine.js sync
                    updatePaymentFields(shippingCompany, shippingCompanyId);
                    paymentFieldsInitialized = true; // Mark as initialized to prevent duplicates
                }
            }

            // Trigger order intent if we have company data
            if (shippingCompany && shippingCompanyId) {
                window.dispatchEvent(new Event("dispatch-order-intent"));
            }
        }
    });


    /** Listen for shipping company selection events to update payment fields */
    window.addEventListener("shipping-company-selected", (event) => {
        // Only sync if billing is same as shipping
        if (!isBillingAsShipping()) {
            return;
        }

        /** Retrieve the latest shipping company selection data */
        const shippingCompanySelectionData = twoPaymentReadSelection();
        const shippingCompany = shippingCompanySelectionData.company_name || "";
        const shippingCompanyId = shippingCompanySelectionData.company_id || "";

        /*
         * Gated on the NAME alone. The identifier may legitimately be empty —
         * the search response is allowed to omit `national_identifier` — and
         * requiring it here skipped the sync entirely for such a pick, so the
         * payment tile kept the PREVIOUS company's name AND identifier and
         * place-order submitted company A while the buyer had selected company
         * B. Nothing prompts a re-entry, so the buyer never sees it. Writing
         * the empty identifier THROUGH is what keeps the two fields describing
         * the same company — the same reasoning as fillCompanyData() no longer
         * bailing on an empty id.
         */
        if (shippingCompany !== "") {
            /** Update payment method fields with shipping selection */
            const companyNameInput = document.querySelector('[data-name="company_name"]');
            const companyIdInput = document.querySelector('[data-name="company_id"]');

            if (companyNameInput && companyIdInput) {
                // Check if this brand's Two method is active for order intent
                // The identifier is part of the intent request, so an empty one
                // dispatches nothing — matching fillCompanyData()'s
                // `companyId &&` term. Without this, relaxing the gate above
                // would have started firing intents for companies with no
                // identifier: requests the listener discards, which still read
                // as real submissions in the event log.
                const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');
                const shouldTriggerOrderIntent = Boolean(activePaymentMethod)
                    && activePaymentMethod.value === '<?= $escaper->escapeJs($methodCode) ?>'
                    && shippingCompanyId !== "";

                // Use the centralized update function for consistency and Alpine.js sync
                updatePaymentFields(shippingCompany, shippingCompanyId, shouldTriggerOrderIntent, true);
            }
        }
    });

    /**
     * Listen for Hyva Checkout's billing_as_shipping_address_updated Magewire event.
     * When user toggles the "billing same as shipping" checkbox, we need to
     * sync or clear payment company fields accordingly.
     */
    document.addEventListener('DOMContentLoaded', () => {
        // Wait for Magewire to be available, then register event listener
        const registerMagewireListener = () => {
            if (typeof Magewire !== 'undefined' && Magewire.on) {
                Magewire.on('billing_as_shipping_address_updated', (data) => {
                    const billingAsShipping = data?.billingAsShipping;

                    if (billingAsShipping) {
                        // Billing is now same as shipping - sync company data from shipping
                        const shippingCompanySelectionData = twoPaymentReadSelection();
                        const shippingCompany = shippingCompanySelectionData.company_name || "";
                        const shippingCompanyId = shippingCompanySelectionData.company_id || "";

                        // Name alone, for the same reason as the
                        // shipping-company-selected handler above: an
                        // identifier-less shipping company must still overwrite
                        // whatever the payment tile is currently holding, or
                        // toggling billing back to "same as shipping" leaves
                        // the previous company's details in place.
                        if (shippingCompany) {
                            updatePaymentFields(shippingCompany, shippingCompanyId, false, true);
                        }
                    }
                    // When billingAsShipping is false, let the user enter their own billing company
                });
            } else {
                // Retry after a short delay if Magewire is not ready
                setTimeout(registerMagewireListener, 100);
            }
        };

        registerMagewireListener();
    });
</script>
<?php $hyvaCsp->registerInlineScript(); ?>
