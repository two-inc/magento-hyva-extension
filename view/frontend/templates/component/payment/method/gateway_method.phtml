             * The input carries the canonical `payment[company_name]` in BOTH
             * modes — there is one field now, not a visible/hidden mirror pair —
             * so `twoValidatePaymentForm()`'s doSave() and fillCompanyData()
             * keep reading it by exactly the name and id they always did.
             */
            $twoControlAlpineData = '';
            $twoControlCaptureHost = 'tile';
            $twoControlInputClass = 'company_name block w-full form-input grow renderer-text'
                . ' border border-gray-300 rounded-md p-2 focus:ring focus:ring-indigo-300 validate';
            $twoControlInputAttributes = 'id="company_name" name="payment[company_name]"'
                . ' data-name="company_name" required data-validate=\'{"required": true}\'';
            ?>
            <div class="w-full min-w-0">
                <label for="company_name" class="font-semibold text-gray-700">
                    <?= $escaper->escapeHtmlAttr(__("Company Name")) ?>
                </label>
                <p class="text-xs text-gray-500 mt-1 mb-1">
                    <?= $escaper->escapeHtmlAttr(__("Select your company from the dropdown to continue.")) ?>
                </p>
                <?php include $block->getTemplateFile(
                    'Two_GatewayHyva::form/field/company-search-control.phtml',
