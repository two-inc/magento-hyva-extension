            <?php endif ?>
            <?php
            /*
             * TWO-25326 §7.2/§7.3 (2026-08-03 ruling): the sibling "not
             * approved / no intent" text. Same shape and same reasoning as
             * the approved notice above — a persistent inline element rather
             * than a toast, gated on the identical brand switch (see
