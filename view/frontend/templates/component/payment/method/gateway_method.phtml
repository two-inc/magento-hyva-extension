             */
            ?>
            <?php if ($isCompanySearchInPaymentTile): ?>
            <?php
            /*
             * TWO-25326: the ONE captured-company label.
             *
             * Reads "<name> (<number>)" and replaces three separate things the
             * tile used to show once a company had been captured — an editable
