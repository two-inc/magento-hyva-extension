             */
            ?>
            <div class="flex flex-col field field-reserved required" :class="companyNumberBlockHiddenClass">
              <label for="company_id" class="font-semibold text-gray-700">
                <?= $escaper->escapeHtmlAttr(__("Company Number")) ?>
              </label>
              <!--
                  `:disabled` is the ONLY thing that locks this field. It used
                  to be set imperatively from company-name-payment.phtml, which
                  disabled it on every shipping sync and never reversed it — so
                  a company whose national identifier the search response
                  omitted left the buyer with a required field that was empty
                  AND uneditable. The lock is now derived state
                  (`manualMode || companyIdEntryRequired`, see
                  applyCompanyIdEditability()) with exactly one writer.

                  The greyed-out look is `input.company_id:disabled` in
                  custom.css, NOT a `:style` binding: CSP-friendly Alpine does
                  not EVALUATE an attribute expression at all — it looks the
                  whole string up as a key on the component — so an object
                  literal `:style="{ backgroundColor: … }"` is not something it
                  can compute, and a STRING `:style` would set the whole style
                  attribute, which is where `x-show` writes `display: none`.

                  `:class="companyIdHiddenClass"` hides the input once the
                  number is locked AND actually present, because the captured
                  number is then carried by the tile label above instead.
                  `companyIdDisabled` can only be true when NOT in manual mode
                  (see applyCompanyIdEditability()), so this never hides the
                  field while the buyer still needs to fill it in (empty,
                  enabled, required); the non-empty `companyId` term (see
                  `companyIdHintVisible`) is what stops it being hidden a tick
                  before its value has arrived. A class-name STRING, not an
                  object literal, for the same CSP reason as above.
              -->
              <?php
              /*
               * ONE input, not the visible/hidden mirror pair this block used
               * to carry (TWO-25326, 2026-08-05). The pair existed because the
               * old tile-local search control duplicated every field between a
               * search-mode copy and a manual-mode copy and swapped their
               * `:id`/`:name` bindings so that only the visible one submitted
               * canonically. The shared control has ONE company-name field in
               * both modes, so the number needs one too — and eight
               * id/name-resolution getters, each a place for the two copies to
               * disagree about which is canonical, are gone with it.
               */
              ?>
              <input
                type="text"
                :class="companyIdHiddenClass"
                id="company_id"
                name="payment[company_id]"
                :disabled="companyIdDisabled"
                data-name="company_id"
                required
                data-validate='{"required": true}'
                class="company_id border border-gray-300 rounded-md p-2 focus:ring focus:ring-indigo-300 validate"
              />
            </div>
            <?php endif // !$isCompanySearchInPaymentTile ?>

