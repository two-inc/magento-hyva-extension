$isAddressAutopopulationEnabled = $configModel->getIsAddressAutopopulationEnabled()
    ? "true"
    : "false";
// Where `rest/V1/two/...` lives. The link base URL rather than a hand-built
// host, so a store served under a subdirectory or a store-coded URL reaches
