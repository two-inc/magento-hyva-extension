        if (orderIntentDebounceTimeout) {
            clearTimeout(orderIntentDebounceTimeout);
        }

        orderIntentDebounceTimeout = setTimeout(() => {
            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

            if (!activePaymentMethod) {
                // The spinner was raised optimistically on the pick (bug 5), so
                // every path that then declines to make a request has to take it
                // back down. These two early returns did not, which left a
                // "Checking availability" row up forever — reachable by picking a
                // company and switching payment method inside the 500ms debounce.
                // Cheap before; a permanent bordered box now.
                if (twoPaymentComponentInstance) {
                    twoPaymentComponentInstance.setOrderIntentChecking(false);
                }
                return;
            }

            const selectedPaymentValue = activePaymentMethod.value;
            const isTwoPaymentSelected = selectedPaymentValue === "<?= $brandedViewModel->getMethodCode() ?>";

            if (!isTwoPaymentSelected) {
                if (twoPaymentComponentInstance) {
                    twoPaymentComponentInstance.setOrderIntentChecking(false);
                }
                return;
            }

            /**
             * @returns {boolean} false only when the component is not mountable
             *   yet, which is the one case worth retrying.
             */
            const executeOrderIntent = () => {
                const component = twoPaymentComponentInstance;
                if (!component) {
                    return false;
                }

                if (!component.isOrderIntentEnabled) {
                    component.setOrderIntentChecking(false);
                    return true;
                }

                // Get the current company ID from the component
                const currentCompanyId = component.companyId
                    || document.getElementById("company_id")?.value || '';

                // Nothing to check, or already decided for exactly this company.
                if (!currentCompanyId.trim()
                    || component.hasOrderIntentDecisionFor(currentCompanyId, component.companyName)) {
                    component.setOrderIntentChecking(false);
                    return true;
                }

                /*
                 * The request is now definitely going out — past every gate. Two
                 * things belong exactly here rather than at the call sites:
                 *
                 *   - no verdict may be on screen while a check runs. The tile's
                 *     own pick path clears too, but this event is dispatched from
                 *     four other places (the address-area company sync) that
                 *     change neither company name nor id, so no watcher fires and
                 *     nothing else would clear;
                 *   - the previous FAILURE for this company is forgotten, because
                 *     the question is being asked again. Only now, not when the
                 *     dispatch was requested: the gates above can decline to
                 *     send, and forgetting a failure for a request that never
                 *     leaves would leave a blocked order reporting nothing.
                 */
                component.clearOrderIntentNotices();
                component.forgetOrderIntentError(currentCompanyId);

                orderIntentSeq += 1;
                const seq = orderIntentSeq;
                const requestedCompanyId = currentCompanyId;
                // Captured with the id, for the same reason: a reply that lands
                // after the buyer has moved on must be filed under the company
                // it was ASKED about, name included. Read off the component
                // rather than the DOM so it matches the name the verdict's copy
                // will be built from.
                // `undefined` when there is no name, NOT ''. The two differ only
                // for a LATE reply, which is the case that matters: `undefined`
                // reaches the "name genuinely unknown" branch and records `null`,
                // which no live name can match, whereas '' is a value the record
                // WOULD match. For a reply about the company still on screen both
                // end up recording '' — that company is simply nameless, and the
                // gate then treats it as decided while it stays that way.
                const requestedCompanyName = component.companyName || undefined;
                component.setOrderIntentChecking(true);

