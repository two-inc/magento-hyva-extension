    function twoValidatePaymentForm(form, wire) {
        let timeout = null;
        let dirty = false;

        // hyva.formValidation() is third-party and is copied by value as
        // before, unchanged: we RELY on it exposing no accessors — nothing
        // in this repo can check that, Hyvä checkout being a commercial
        // package with no distribution here — and defining onto the object
        // it returns would mutate a Hyvä-owned value. THIS literal is
        // composed live, so a getter added to it later cannot be frozen the
        // way TWO-25332's were.
        return twoGatewayComposeLive(
            Object.assign({}, hyva.formValidation(form)), {
                init() {
                    const doSave = async (isWithValidation = true) => {
                        clearTimeout(timeout);

                        if (isWithValidation) {
                            // Clear stale flash messages from a prior attempt so a
                            // resubmit doesn't render outdated errors (mirrors the
                            // Luma renderer's messageContainer.clear()).
                            // Hyva's stepTo() fires the same event when navigating.
                            window.dispatchEvent(new Event('clear-messages'));

                            try {
                                await this.validate();
                            } catch (error) {
                                // Swallow so the autosave/navigation task resolves;
                                // the validator registered in init() is what blocks
                                // Place Order on an invalid form.
                                console.error("Form validation failed:", error);
                                return;
                            }
                        }
                        if (this.isOrderIntentEnabled) {
                            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

                            if (activePaymentMethod) {
                                const selectedPaymentValue = activePaymentMethod.value;
                                const isTwoPaymentSelected = selectedPaymentValue === "<?= $brandedViewModel->getMethodCode() ?>";

                                if (isTwoPaymentSelected) {
                                    const formRef = form;

                                    await new Promise((resolve, reject) => {
                                        const timeoutId = setTimeout(() => {
                                            reject("Order intent operation timed out");
                                        }, 5000);

                                        const checkAndProceed = () => {
                                            try {
                                                const formElements = [
                                                    'department',
                                                    'project',
                                                    'poNumber',
                                                    'orderNote',
                                                    'invoiceEmails',
                                                    'company_name',
                                                    'company_id'
                                                ];

                                                const paymentData = {
                                                    additionalData: Object.fromEntries(
                                                        formElements.map(field => {
                                                            const element = formRef.querySelector(`[name="payment[${field}]"]`);
                                                            return [field === 'company_name' ? 'companyName' : field === 'company_id' ? 'companyId' : field, element?.value || ""];
                                                        })
                                                    )
                                                };

                                                paymentData.additionalData.organization_number = paymentData.additionalData.companyId;

                                                Magewire.find("<?= $brandedViewModel->getMagewireBlockName() ?>")
                                                    .call('setPaymentData', paymentData)
                                                    .then(() => {
                                                        clearTimeout(timeoutId);
                                                        resolve();
                                                    })
                                                    .catch((error) => {
                                                        console.error("Error setting payment data:", error);
                                                        clearTimeout(timeoutId);
                                                        resolve();
                                                    });

                                            } catch (error) {
                                                console.error("Error in payment data processing:", error);
                                                clearTimeout(timeoutId);
                                                resolve();
                                            }
                                        };

                                        setTimeout(checkAndProceed, 1000);
                                    });
                                }
                            }
                        }

                        try {
                            if (!dirty) {
                                return;
                            }

                            dirty = false;
                            await wire.store();
                        } catch (exception) {
                            console.error("Error in wire.store():", exception);
                        }

                    }

                    const interactionCallback = () => {
                        dirty = true;

                        clearTimeout(timeout);

                        try {
                            timeout = setTimeout(() => {
                                doSave(false);
                            }, wire.autoSaveTimeout);
                        } catch (error) {
                            console.error("Error in interactionCallback setTimeout:", error);
                        }
                    }

                    hyvaCheckout.navigation.addTask(doSave, {
                        name: '<?= str_replace('checkout.payment.method.', '', $brandedViewModel->getMagewireBlockName()) ?>'
                    });

                    // Block Place Order while the payment form is invalid.
                    // The doSave task above swallows validation
                    // failures (a rejected navigation task would abort with
                    // Hyva's generic "Something went wrong" alert), so without
                    // this validator order.place() proceeds with
                    // setPaymentData skipped. A false return aborts placement
                    // silently, leaving hyva.formValidation's field-level
                    // messages (e.g. terms-not-accepted) as the feedback.
                    hyvaCheckout.validation.register(
                        '<?= str_replace('checkout.payment.method.', '', $brandedViewModel->getMagewireBlockName()) ?>_form',
                        async () => {
                            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

                            if (!activePaymentMethod || activePaymentMethod.value !== "<?= $brandedViewModel->getMethodCode() ?>") {
                                return true;
                            }

                            let isFormValid = true;
                            try {
                                await this.validate();
                            } catch (error) {
                                isFormValid = false;
                            }

                            // Not left to the field's own `required`: in the
                            // default markup mode the company pair is hidden
                            // inputs, which carry no validation at all.
                            const companyIdField = form.querySelector('[name="payment[company_id]"]');
                            const capturedCompanyId = companyIdField ? String(companyIdField.value || '') : '';

                            if (capturedCompanyId.trim() === '') {
                                if (typeof window.dispatchMessages === 'function') {
                                    window.dispatchMessages([{
                                        type: 'error',
                                        text: '<?= $escaper->escapeJs($companyRequiredMessage) ?>',
                                    }], 5000);
                                } else {
                                    // Refusing with nothing on screen is worse
                                    // than the error this replaces, so leave a
                                    // trace rather than failing silently.
                                    console.error('Two: no message channel for the company-required refusal.');
                                }
                                return false;
                            }

                            return isFormValid;
                        },
                        form
                    );

                    const addEventListeners = (el) => {
                        if (el !== form) return;

                        this.$nextTick(() => {
                            Array.from(form.querySelectorAll('[wire\\:auto-save]')).forEach(field => {
                                ['input', 'change'].map(eventName => {
                                    field.removeEventListener(eventName, interactionCallback);
                                    field.addEventListener(eventName, interactionCallback);
                                })
                            })
                        })
                    }

                    addEventListeners(form);
                    Magewire.hook('element.updated', addEventListeners);
                }
            }
        )
    }

