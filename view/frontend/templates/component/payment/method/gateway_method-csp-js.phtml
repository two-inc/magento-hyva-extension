             * only way back — found in live testing (2026-08-04/05) to read as
             * a confusing hide-and-reshow rather than a stable control.
             */
            saveManualModeToStorage(manualMode) {
                window.twoGatewayWriteBillingCompany({ manual_mode: manualMode });
            },

            // Manual/search toggling, keyboard navigation, dropdown teardown
            // and the company-id lock formula (`applyCompanyIdEditability()`)
            // are the shared engine's — `enterManually()`, `enableSearch()`,
            // `nextItem()`/`prevItem()`/`adjustScroll()`,
            // `selectHighlightedItem()`, `closeCompanyList()`. This tile's
            // `editableCompanyIdExtraUnlock` is the engine default (`false`):
            // the formula here has always been exactly
            // `!(manualMode || companyIdEntryRequired)`, with no extra term —
            // unlike the address step, which unlocks whenever search itself
            // is switched off (see that surface's own options).

            // Additive (TWO-25288): whether there is an actual registry id to
            // show. Deliberately NOT just `companyIdDisabled` — on
            // initialize() with a restored selection, `companyIdEntryRequired`
            // (and so `companyIdDisabled`) is derived synchronously from
            // storage, while `this.companyId` itself is only populated by the
            // `$nextTick(() => fillCompanyData(...))` below, one tick later.
            // Gating on `companyIdDisabled` alone would paint the hint/hide
            // the input for that first tick with no number behind it yet —
            // the same flash-of-wrong-state class `initialize()`'s own doc
            // comment above already guards the `:disabled` binding against.
            // Requiring `companyId` too makes both derived getters below wait
            // for the real value, same tick it arrives.
            get companyIdHintVisible() {
                return this.companyIdDisabled && Boolean(this.companyId);
            },

            // Additive (TWO-25288): purely derived, no new writer. Hides the
            // now-redundant search-mode company_id input once its value is
            // shown via the inline hint next to the company name field
            // instead. Returns a class-NAME STRING, not an object literal —
            // `:class` bindings in this CSP-friendly Alpine build only work
            // as a key lookup (see chipClasses / GetItemClass above), not
            // expression evaluation.
            get companyIdHiddenClass() {
                return this.companyIdHintVisible ? 'hidden' : '';
            },

            // TWO-25326, ruling of 2026-08-03: the ONE gate for both the
            // inline order-intent notice and the captured-company label beside
            // it. The label is shown exactly when the notice is shown and
            // hidden exactly when it is hidden, so both `x-show` bindings name
            // THIS getter rather than each testing a condition of its own.
            //
            // That is the whole reason it exists. A parallel "is a company
            // captured" check would agree with the notice most of the time and
            // diverge precisely in the states the ruling asks about: a company
            // captured with no intent dispatched yet, an intent that was
            // declined or errored, and a brand that suppressed the notice
            // (`orderIntentApprovedNoticeCopy` null, so
            // resolveOrderIntentApprovedNotice() always returns '').
            //
            // `orderIntentApprovedNotice` is seeded to '' in the component
            // literal specifically so this is never undefined — see the comment
            // on that property. Boolean() rather than the bare string so the
            // getter answers a boolean to a test that compares against one.
            //
            // READ THIS BEFORE ASSUMING THE LABEL IS ALWAYS AVAILABLE. Two
            // configurations mean the notice never fires at all, and so that the
            // §7 label never renders either: order intent disabled for the
            // merchant (the `isOrderIntentEnabled` gate before dispatch), and a
            // Dutch buyer whose company is not a BV. Both are permanent rather
            // than transient, and on this surface the consequence is sharper
            // than on Luma — capture still hides the search block AND the
            // Company Number block, so those buyers see no company name
            // anywhere on the tile and a bare "Change company" button next to
            // nothing. That follows literally from "shown exactly when the
            // notice is shown", so it is a consequence of the ruling rather
            // than a defect here, but it is a product decision and not one to
            // paper over by widening this getter.
            //
            // This getter, and every other one in this literal, reaches the
            // component the <form> mounts as a LIVE accessor only because
            // PaymentFormWithValidation() composes with property descriptors
            // (TWO-25332). Composing it with object spread — as it did until
            // then — evaluated each getter once and copied the frozen result,
            // which disabled the whole §7 label apparatus in production
            // without failing a single test. See that function's comment.
            get orderIntentMessageVisible() {
                return Boolean(this.orderIntentApprovedNotice);
            },

            // Sibling of orderIntentMessageVisible for the "not available"
            // text (TWO-25326 §7.2/§7.3). Named distinctly rather than folded
            // into one "any message visible" getter: the two texts are shown
            // in two DIFFERENT elements (styled approved-green vs
            // unavailable), so the template needs to ask which one.
            get twoTileNotAvailableVisible() {
                return Boolean(this.orderIntentNotAvailableNotice);
            },

            // "<name> (<number>)", built here rather than in the template:
            // bound attribute expressions are looked up as a KEY on the
            // component, never evaluated, so a concatenation in the markup
            // would resolve to nothing at all.
            //
            // The parts are guarded rather than assumed. Under the superseded
            // capture gate a non-empty `companyId` was guaranteed whenever this
            // was read; the intent-message gate does not guarantee it, so an
            // unguarded concatenation could paint "Example Ltd ()" or a bare
            // " (12345678)". Same shape as the sibling platforms' single-line
            // builders: no name at all means no label text.
            get companyTileLabelText() {
                const companyName = (this.companyName || '').trim();
                if (!companyName) return '';

                const companyId = (this.companyId || '').trim();
                return companyId ? companyName + ' (' + companyId + ')' : companyName;
            },

            // TWO-25326 tile bugfix batch, bug 5 (2026-08-05 ruling): the
            // editable company-name search control's visibility is governed
            // ONLY by mode (search vs manual), never by capture state. This
            // SUPERSEDES the §7 design, which additionally hid the block once
            // `companyIdHintVisible` (a registry number locked in), reached
            // back out of via a "Change company" button — found in live
            // testing to read as a confusing hide-and-reshow rather than a
            // stable control. The field itself is the buyer's route to a
            // different company now: typing over it re-runs `getItems()`
            // exactly as it always did before any company was captured.
            get companySearchBlockVisible() {
                return !this.showManual;
            },

            // Companion to `companyIdHiddenClass`, hiding the whole Company
            // Number block — its static caption included — rather than only
            // the input. Class-NAME STRING for the same reason: `:class` here
            // is a key lookup, not expression evaluation. UNCHANGED by the
            // 2026-08-05 ruling above: that ruling is about the EDITABLE
            // search control and the "Change company" swap specifically, and
            // this block's own capture gate is not part of it — see the
            // comment on the markup that binds this.
            get companyNumberBlockHiddenClass() {
                return this.companyIdHintVisible ? 'hidden' : '';
            },

            fillCompanyData(companyId = '', companyName = '', triggerOrderIntent = true) {
                companyName = typeof companyName === 'string' && companyName ? companyName : '';
                companyId = typeof companyId === 'string' ? companyId : '';
                /*
                 * The NAME is what makes this call meaningful; the id is
                 * allowed to be empty, because the search response is allowed
                 * to omit the national identifier.
                 *
                 * It used to bail on an empty id, which left the buyer looking
                 * at the newly selected company's name beside the PREVIOUS
                 * company's id — in a disabled field they could not correct,
                 * and read straight back out by buildOrderIntentRequestBody()
                 * and by the checkout's own `payment[company_id]`. Writing both
                 * fields unconditionally is what keeps name and id describing
                 * the same company.
                 */
                if (!companyName) return;

                this.companyName = companyName;
                this.companyId = companyId;

                const companyNameInput = document.getElementById("company_name");
                if (companyNameInput) companyNameInput.value = companyName;

                // Value only. The locked state is `companyIdDisabled`, which
                // the field's `:disabled` is bound to and which
                // applyCompanyIdEditability() is the sole writer of — the
                // callers above set `companyIdEntryRequired` and call it
                // BEFORE getting here.
                const companyIdInput = document.getElementById("company_id");
                if (companyIdInput) companyIdInput.value = companyId;

                // Only trigger order intent if company ID changed to prevent
                // duplicate messages — and only when there IS one. An intent
                // for an empty company id is a request the listener would
                // discard anyway; dispatching it just makes the empty case look
                // like a real submission in the event log.
                if (this.isOrderIntentEnabled && triggerOrderIntent && companyId
                    && companyId !== this.lastOrderIntentCompanyId) {
                    window.dispatchEvent(new Event("dispatch-order-intent"));
                }
            },

            // Order Intent methods
            async placeOrderIntent() {
                try {
                    const quoteData = JSON.parse(JSON.stringify(this.quote));

                    if (this.shouldSkipOrderIntent(quoteData)) return null;

                    const orderIntentRequestBody = this.buildOrderIntentRequestBody(quoteData);
                    const queryParams = new URLSearchParams({
                        client: this.orderIntentConfig_extensionPlatformName,
                        client_v: this.orderIntentConfig_extensionDBVersion
                    });

                    const response = await fetch(`${this.checkoutApiUrl}/v1/order_intent?${queryParams.toString()}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(orderIntentRequestBody)
                    });

                    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
                    return await response.json();
                } catch (error) {
                    console.error('Error in placeOrderIntent:', error);
                    throw error;
                }
            },

            shouldSkipOrderIntent(quoteData) {
                // Check both component state and DOM for manual entry support
                const companyIdInput = document.getElementById("company_id");
                const companyId = this.companyId || companyIdInput?.value || '';
                return !companyId.trim();
            },

            buildOrderIntentRequestBody(quoteData) {
                // Read from DOM to support manual entry (component state only set for dropdown selection)
                const companyNameInput = document.getElementById("company_name");
                const companyIdInput = document.getElementById("company_id");
                const companyName = this.companyName || companyNameInput?.value || "";
                const companyId = this.companyId || companyIdInput?.value || "";

                let lineItems = quoteData.items?.map(item => ({
                    name: item.name,
                    description: item.description || '',
                    discount_amount: parseFloat(item.discount_amount || 0).toFixed(2),
                    gross_amount: parseFloat(item.row_total_incl_tax || 0).toFixed(2),
                    net_amount: parseFloat(item.row_total || 0).toFixed(2),
                    quantity: item.qty,
                    unit_price: parseFloat(item.price || 0).toFixed(2),
                    tax_amount: parseFloat(item.tax_amount || 0).toFixed(2),
                    tax_rate: (parseFloat(item.tax_percent || 0) / 100).toFixed(6),
                    tax_class_name: '',
                    quantity_unit: this.orderIntentConfig_weightUnit || '',
                    image_url: item.thumbnail,
                    type: item.is_virtual === '0' ? 'PHYSICAL' : 'DIGITAL'
                })) || [];

                lineItems.push({
                    name: 'Shipping',
                    description: 'Shipping fee',
                    gross_amount: parseFloat(quoteData.shipping_incl_tax || 0).toFixed(2),
                    net_amount: parseFloat(quoteData.shipping_amount || 0).toFixed(2),
                    quantity: 1,
                    unit_price: parseFloat(quoteData.shipping_amount || 0).toFixed(2),
                    tax_amount: parseFloat(quoteData.shipping_tax_amount || 0).toFixed(2),
                    tax_rate: isNaN(parseFloat(quoteData.shipping_tax_amount)) || isNaN(parseFloat(quoteData.shipping_amount)) || parseFloat(quoteData.shipping_amount) === 0
                        ? "0.000000"
                        : (parseFloat(quoteData.shipping_tax_amount) / parseFloat(quoteData.shipping_amount)).toFixed(6),
                    tax_class_name: '',
                    quantity_unit: 'unit',
                    type: 'SHIPPING_FEE'
                });

                // Get country code using centralized helper
                this.countryCode = window.twoGatewayGetCountryCode(quoteData);

                const gross_amount = parseFloat(quoteData.grand_total || 0);
                const tax_amount = parseFloat(quoteData.tax_amount) + parseFloat(quoteData.shipping_tax_amount);
                const net_amount = gross_amount - tax_amount;

                return {
                    gross_amount: gross_amount.toFixed(2),
                    net_amount: net_amount.toFixed(2),
                    tax_amount: tax_amount.toFixed(2),
                    currency: quoteData.quote_currency_code,
                    line_items: lineItems,
                    buyer: {
                        company: {
                            organization_number: companyId,
                            country_prefix: this.countryCode,
                            company_name: companyName
                        },
                        representative: {
                            email: quoteData.email,
                            first_name: quoteData.first_name,
                            last_name: quoteData.last_name,
                            phone_number: quoteData.telephone
                        }
                    },
                    merchant_id: this.orderIntentConfig_merchant_id,
                    merchant_short_name: this.orderIntentConfig_merchant_shortName
                };
            },

            /**
             * Resolve the intent-approved notice text for the current buyer.
             * Returns '' when the brand suppressed the notice, so callers can
             * assign the result unconditionally.
             *
             * The company name AND number are substituted here (TWO-25326
             * §7.3) because both are only known client-side. A replacer
             * *function* is used rather than a plain string so `$&` / `$1` in
             * a company name or number are taken literally instead of as
             * replacement patterns.
             */
            resolveOrderIntentApprovedNotice() {
                const copy = this.orderIntentApprovedNoticeCopy;
                if (!copy) return '';

                const companyName = (this.companyName || '').trim();
                if (!companyName) return copy.withoutCompany;

                const companyId = (this.companyId || '').trim();
                return copy.withCompany
                    .replace(copy.companyNameToken, () => companyName)
                    .replace(copy.companyNumberToken, () => companyId);
            },

            /**
             * Sibling of resolveOrderIntentApprovedNotice() for the "not
             * approved / no intent" wording (TWO-25326 §7.2/§7.3). Same
             * empty-brand-switch and substitution contract.
             */
            resolveOrderIntentNotAvailableNotice() {
                const copy = this.orderIntentNotAvailableCopy;
                if (!copy) return '';

                const companyName = (this.companyName || '').trim();
                if (!companyName) return copy.withoutCompany;

                const companyId = (this.companyId || '').trim();
                return copy.withCompany
                    .replace(copy.companyNameToken, () => companyName)
                    .replace(copy.companyNumberToken, () => companyId);
            },

            processOrderIntentSuccessResponse(response) {
                if (!response) return;

                // Track the company ID for which this order intent was processed
                this.lastOrderIntentCompanyId = this.companyId;

                if (response.approved) {
                    this.placeOrderIntentFlag = true;
                    // Persistent inline notice inside the payment tile, not a
                    // window.dispatchMessages() toast. The toast was visible
                    // but self-dismissed after 5 seconds, so a buyer still
                    // filling in the form never saw the reassurance at the
                    // moment it was useful.
                    this.orderIntentApprovedNotice = this.resolveOrderIntentApprovedNotice();
                    this.orderIntentNotAvailableNotice = '';
                } else {
                    this.placeOrderIntentFlag = false;
                    this.orderIntentApprovedNotice = '';
                    // Persistent inline "not available" text (TWO-25326 §7.2),
                    // alongside the existing self-dismissing toast rather than
                    // instead of it — the toast still serves the surfaces where
                    // the tile's own search control is showing (payment_tile
                    // location) and a buyer's attention is on the fields, not
                    // the text below them.
                    this.orderIntentNotAvailableNotice = this.resolveOrderIntentNotAvailableNotice();
                    window.dispatchMessages([{ type: 'error', text: this.orderIntentDeclinedMessage }], 5000);
                }
            },

            processOrderIntentErrorResponse(response) {
                this.placeOrderIntentFlag = false;
                // An intent that errored says nothing about approval; drop any
                // notice left over from a previous, successful intent.
                this.orderIntentApprovedNotice = '';
                this.orderIntentNotAvailableNotice = '';
                let message = this.generalErrorMessage;

                if (response?.responseJSON) {
                    const { error_code, error_message, error_details, error_json } = response.responseJSON;

                    switch (error_code) {
                        case 'SCHEMA_ERROR':
                            if (error_json) {
                                message = '';
                                error_json.forEach(error => {
                                    window.dispatchMessages([{ type: 'error', text: error.msg }], 3000);
                                });
                            }
                            break;
                        case 'JSON_MISSING_FIELD':
                            if (error_details) message = error_details;
                            break;
                        case 'MERCHANT_NOT_FOUND_ERROR':
                        case 'ORDER_INVALID':
                            message = error_message + (error_details ? ' - ' + error_details : '');
                            break;
                    }
                }

                if (message) {
                    window.dispatchMessages([{ type: 'error', text: message }], 3000);
                }
            },
        });
    }

    /**
     * The component the payment `<form>` mounts: the tile component's state
     * and derivations, plus the form's validation and autosave.
     *
     * TWO-25332: composed with DESCRIPTORS, not spread. This used to be
     *
     *     return { ...PaymentMethodBase(), ...twoValidatePaymentForm(…) };
     *
     * which evaluated each of PaymentMethodBase()'s getters once and copied
     * the frozen result, so on the component the form actually mounted
     * `orderIntentMessageVisible`, `companyTileLabelText`,
     * `companySearchBlockVisible`, `companyIdHintVisible`,
     * `companyIdHiddenClass` and `companyNumberBlockHiddenClass` were all
     * dead data properties holding
     * their pre-interaction value. Every §7 company-search behaviour tied to
     * them was inert in production, and no test saw it because the suites
     * mounted the BASE component, where the getters are real.
     * `payment-form-composition.test.js` mounts THIS factory for that reason
     * — do not let that suite go away.
     *
     * The validation object still wins on a name collision (`init`), exactly
     * as the spread ordering did.
     */
    function <?= $gwBase ?>PaymentFormWithValidation() {
        return twoGatewayComposeLive(
            <?= $gwBase ?>PaymentMethodBase(),
            twoValidatePaymentForm(this.$el, this.$wire)
        );
    }

    function <?= $gwBase ?>PaymentTermsComponent() {
        return <?= $gwBase ?>PaymentMethodBase();
    }

    // Per-chip component. Hyva loads alpine3-csp.min.js which forbids
    // function calls, comparisons, object literals, and boolean operators
    // in attribute expressions — so every chip is its own Alpine.data
    // component reading `days` from a data-* attribute and exposing
    // bare-identifier getters for the template to bind to.
    function <?= $gwBase ?>TermChip() {
        return {
            days: 0,
            labelSingular: '1 day',
            labelPlural: '%1 days',
            labelSingle: '',
            errorMessage: 'Could not update payment term. Please try again.',
            isUpdating: false,
            single: false,

            init() {
                this.days = parseInt(this.$el.dataset.days, 10) || 0;
                // `single` marks the sole-available-term chip: informational,
                // not clickable, distinct --single styling (matches Luma).
                this.single = this.$el.dataset.single === '1';
                // Translated labels sourced from PHP via __(); CSV strings
                // live in the plugin's i18n/<locale>.csv files.
                if (this.$el.dataset.labelSingular) this.labelSingular = this.$el.dataset.labelSingular;
                if (this.$el.dataset.labelPlural) this.labelPlural = this.$el.dataset.labelPlural;
                // Only the sole-term chip carries this: it names the term
                // inside the chip ('Payment Terms 30 days') because that
                // branch renders no heading above the chips.
                if (this.$el.dataset.labelSingle) this.labelSingle = this.$el.dataset.labelSingle;
                if (this.$el.dataset.errorMessage) this.errorMessage = this.$el.dataset.errorMessage;
            },

            get label() {
                // Sole-term chip: 'Payment Terms %1 days' — same string Luma's
                // singleTermLabel uses, including its 1-day plural quirk.
                if (this.single && this.labelSingle) {
                    return this.labelSingle.replace('%1', this.days);
                }
                return this.days === 1
                    ? this.labelSingular
                    : this.labelPlural.replace('%1', this.days);
            },

            get isSelected() {
                return this.days === (parseInt(this.$wire.selectedTerm, 10) || 0);
            },

            get isLoading() {
                return this.isUpdating;
            },

            // Shared busy flag — disables every chip while any one is
            // mid-round-trip. Prevents the buyer queueing multiple
            // selectTerm calls before the first resolves.
            get anyUpdating() {
                return Alpine.store('twoChip').busy;
            },

            get chipClasses() {
                if (this.single) {
                    return 'two-term-chip two-term-chip--single';
                }
                return this.isSelected
                    ? 'two-term-chip two-term-chip--selected'
                    : 'two-term-chip';
            },

            get ariaPressed() {
                return this.isSelected ? 'true' : 'false';
            },

            get surchargeText() {
                const surcharges = this.$wire.termSurcharges || {};
                const terms = Object.keys(surcharges);
                // Empty map → surcharges not yet loaded; show nothing.
                if (!terms.length) return '';
                const raw = surcharges[this.days];
                if (raw === undefined) return '';
                // Match Luma (gateway_method.js `termOptions`): if EVERY
                // term is ~zero, show no fee on any chip; if ANY term is
                // non-zero, show the fee on every chip — zero-fee chips
                // then render `+€ 0.00`. The `< 0.005` threshold and the
                // `+` prefix mirror the Luma renderer exactly so the two
                // checkouts display identically.
                const allZero = terms.every(function (days) {
                    return parseFloat(surcharges[days] || 0) < 0.005;
                });
                if (allZero) return '';
                const amount = parseFloat(raw || 0);
                const currency = this.$wire.currencyCode || 'EUR';
                // Use the Magento store-view locale piped from PHP
                // (`nl-NL`, `en-GB`, ...) so the chip's currency format
                // matches the order summary. Browser default would
                // produce `€16.03` while Magento formats `€ 16,03`.
                const locale = this.$wire.currencyLocale || undefined;
                try {
                    return '+' + new Intl.NumberFormat(locale, {
                        style: 'currency',
                        currency: currency
                    }).format(amount);
                } catch (e) {
                    return '+' + amount.toFixed(2);
                }
            },

            // CSP-friendly Alpine refuses boolean operators in attribute
            // expressions, so the chip template can't bind to
            // `x-if="!isLoading && surchargeText"` directly. Without
            // mutual exclusion the loading-dots span and the surcharge
            // span both render during a Magewire selectTerm round-trip,
            // adding a row to the chip and stretching it vertically
            // until the response lands. Exposed as a getter so the
            // template can bind via bare property access.
            get surchargeTextWhenNotLoading() {
                return this.isLoading ? '' : this.surchargeText;
            },

            async select() {
                if (this.single) return; // sole term — nothing to switch to
                if (Alpine.store('twoChip').busy) return;
                if (this.isSelected) return;

                this.isUpdating = true;
                Alpine.store('twoChip').busy = true;
                try {
                    await Promise.race([
                        this.$wire.selectTerm(this.days),
                        new Promise((_, reject) => setTimeout(
                            () => reject(new Error('selectTerm timeout')),
                            15000
                        ))
                    ]);
                } catch (e) {
                    console.warn('Two_GatewayHyva: selectTerm failed', e);
                    if (typeof window.dispatchMessages === 'function') {
                        window.dispatchMessages(
                            [{ type: 'error', text: this.errorMessage }],
                            5000
                        );
                    }
                } finally {
                    this.isUpdating = false;
                    Alpine.store('twoChip').busy = false;
                }
            }
        };
    }

    document.addEventListener('alpine:init', () => {
        Alpine.store('twoChip', { busy: false });
        Alpine.data('<?= $gwBase ?>PaymentMethodBase', <?= $gwBase ?>PaymentMethodBase);
        Alpine.data('<?= $gwBase ?>PaymentFormWithValidation', <?= $gwBase ?>PaymentFormWithValidation);
        Alpine.data('<?= $gwBase ?>PaymentTermsComponent', <?= $gwBase ?>PaymentTermsComponent);
        Alpine.data('<?= $gwBase ?>TermChip', <?= $gwBase ?>TermChip);
    });

    // Global reference to the payment component instance
    let twoPaymentComponentInstance = null;

    // Debounce timeout for order intent
    let orderIntentDebounceTimeout = null;

    // Track if an order intent request is currently in progress to prevent concurrent calls
    let orderIntentInProgress = false;

    // Global order intent event listener - only added once
    // Uses debouncing and locking to prevent multiple rapid calls and duplicate messages
    window.addEventListener("dispatch-order-intent", (event) => {
        if (orderIntentDebounceTimeout) {
            clearTimeout(orderIntentDebounceTimeout);
        }

        orderIntentDebounceTimeout = setTimeout(() => {
            // Prevent concurrent order intent calls
            if (orderIntentInProgress) {
                return;
            }

            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

            if (!activePaymentMethod) {
                return;
            }

            const selectedPaymentValue = activePaymentMethod.value;
            const isTwoPaymentSelected = selectedPaymentValue === "<?= $brandedViewModel->getMethodCode() ?>";

            if (!isTwoPaymentSelected) {
                return;
            }

            const executeOrderIntent = () => {
                if (!twoPaymentComponentInstance) {
                    return false;
                }

                if (!twoPaymentComponentInstance.isOrderIntentEnabled) {
                    return false;
                }

                // Get the current company ID from the component
                const currentCompanyId = twoPaymentComponentInstance.companyId ||
                    document.getElementById("company_id")?.value || '';

                // Skip if we already have an order intent result for this company
                if (currentCompanyId && currentCompanyId === twoPaymentComponentInstance.lastOrderIntentCompanyId) {
                    return true; // Already processed
                }

                // Skip if company ID is empty
                if (!currentCompanyId.trim()) {
                    return true; // Nothing to process
                }

                orderIntentInProgress = true;
                twoPaymentComponentInstance.placeOrderIntent()
                    .then(response => {
                        twoPaymentComponentInstance.processOrderIntentSuccessResponse(response);
                    })
                    .catch(error => {
                        twoPaymentComponentInstance.processOrderIntentErrorResponse(error);
                    })
                    .finally(() => {
                        orderIntentInProgress = false;
                    });
                return true;
            };

            if (!executeOrderIntent()) {
                setTimeout(() => {
                    executeOrderIntent();
                }, 100);
            }
        }, 500); // Increased debounce to 500ms for better deduplication
    });
</script>
