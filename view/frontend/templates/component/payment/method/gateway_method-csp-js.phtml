    document.addEventListener('alpine:init', () => {
        Alpine.store('twoChip', { busy: false });
        Alpine.data('<?= $gwBase ?>PaymentMethodBase', <?= $gwBase ?>PaymentMethodBase);
        Alpine.data('<?= $gwBase ?>PaymentFormWithValidation', <?= $gwBase ?>PaymentFormWithValidation);
        Alpine.data('<?= $gwBase ?>PaymentTermsComponent', <?= $gwBase ?>PaymentTermsComponent);
        Alpine.data('<?= $gwBase ?>TermChip', <?= $gwBase ?>TermChip);
    });

    // Global reference to the payment component instance
    let twoPaymentComponentInstance = null;

    // Debounce timeout for order intent
    let orderIntentDebounceTimeout = null;

    /*
     * TWO-25326 tile bugfix batch, bug 4.
     *
     * A monotonic sequence number, bumped by every intent request that actually
     * goes on the wire. A request may only publish its result — the verdict, the
     * notices, the "this company has been decided" record and the spinner coming
     * down — while it is still the newest one. It REPLACES a boolean
     * "in progress" mutex that used to sit here.
     *
     * The mutex was the reported bug, not a safeguard against it. Selecting
     * company A started a check; selecting a different company B while A's check
     * was still outstanding hit `if (inProgress) return` inside the debounce
     * callback and was DISCARDED — not queued, not retried — so B never got a
     * check at all, and the tile went on showing A's verdict. Worse, when A's
     * decision finally landed it was filed against whatever company was current
     * by then, which pinned the dedup gate to B and suppressed B's check for the
     * rest of the session even if the buyer tried again.
     *
     * Sequencing is the right shape for this: overlapping requests are allowed
     * (they are idempotent reads of a decision), and out-of-order REPLIES — the
     * thing that actually corrupts the tile — are dropped. Same guard, and the
     * same reasoning, as the one the PrestaShop plugin adopted for its own
     * order-intent leg on this ticket.
     */
    let orderIntentSeq = 0;

    // Global order intent event listener - only added once.
    window.addEventListener("dispatch-order-intent", (event) => {
        if (orderIntentDebounceTimeout) {
            clearTimeout(orderIntentDebounceTimeout);
        }

        orderIntentDebounceTimeout = setTimeout(() => {
            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

            if (!activePaymentMethod) {
                // The spinner was raised optimistically on the pick (bug 5), so
                // every path that then declines to make a request has to take it
                // back down. These two early returns did not, which left a
                // "Checking availability" row up forever — reachable by picking a
                // company and switching payment method inside the 500ms debounce.
                // Cheap before; a permanent bordered box now.
                if (twoPaymentComponentInstance) {
                    twoPaymentComponentInstance.setOrderIntentChecking(false);
                }
                return;
            }

            const selectedPaymentValue = activePaymentMethod.value;
            const isTwoPaymentSelected = selectedPaymentValue === "<?= $brandedViewModel->getMethodCode() ?>";

            if (!isTwoPaymentSelected) {
                if (twoPaymentComponentInstance) {
                    twoPaymentComponentInstance.setOrderIntentChecking(false);
                }
                return;
            }

            /**
             * @returns {boolean} false only when the component is not mountable
             *   yet, which is the one case worth retrying.
             */
            const executeOrderIntent = () => {
                const component = twoPaymentComponentInstance;
                if (!component) {
                    return false;
                }

                if (!component.isOrderIntentEnabled) {
                    component.setOrderIntentChecking(false);
                    return true;
                }

                // Get the current company ID from the component
                const currentCompanyId = component.companyId
                    || document.getElementById("company_id")?.value || '';

                // Nothing to check, or already decided for exactly this company.
                if (!currentCompanyId.trim()
                    || component.hasOrderIntentDecisionFor(currentCompanyId, component.companyName)) {
                    component.setOrderIntentChecking(false);
                    return true;
                }

                /*
                 * The request is now definitely going out — past every gate. Two
                 * things belong exactly here rather than at the call sites:
                 *
                 *   - no verdict may be on screen while a check runs. The tile's
                 *     own pick path clears too, but this event is dispatched from
                 *     four other places (the address-area company sync) that
                 *     change neither company name nor id, so no watcher fires and
                 *     nothing else would clear;
                 *   - the previous FAILURE for this company is forgotten, because
                 *     the question is being asked again. Only now, not when the
                 *     dispatch was requested: the gates above can decline to
                 *     send, and forgetting a failure for a request that never
                 *     leaves would leave a blocked order reporting nothing.
                 */
                component.clearOrderIntentNotices();
                component.forgetOrderIntentError(currentCompanyId);

                orderIntentSeq += 1;
                const seq = orderIntentSeq;
                const requestedCompanyId = currentCompanyId;
                // Captured with the id, for the same reason: a reply that lands
                // after the buyer has moved on must be filed under the company
                // it was ASKED about, name included. Read off the component
                // rather than the DOM so it matches the name the verdict's copy
                // will be built from.
                // `undefined` when there is no name, NOT ''. The two differ only
                // for a LATE reply, which is the case that matters: `undefined`
                // reaches the "name genuinely unknown" branch and records `null`,
                // which no live name can match, whereas '' is a value the record
                // WOULD match. For a reply about the company still on screen both
                // end up recording '' — that company is simply nameless, and the
                // gate then treats it as decided while it stays that way.
                const requestedCompanyName = component.companyName || undefined;
                component.setOrderIntentChecking(true);

                /*
                 * A second way a reply can be stale, beyond `seq` (review
                 * round 4): a MAGEWIRE REMOUNT. `initialize()` reassigns
                 * `twoPaymentComponentInstance` on every remount, but this
                 * closure captured the OLD `component` when the request went
                 * out. A re-render mid-flight (the tile's own comments
                 * elsewhere name totals/address/term changes as triggers)
                 * tears down that instance, and writing to it strands the
                 * verdict on a component nothing renders any more — the live
                 * one never learns it. Re-resolve against the CURRENT
                 * `twoPaymentComponentInstance` and drop the reply if it no
                 * longer matches, the same "fails closed" shape as the search
                 * control's own `searchStillValid`.
                 *
                 * What this does NOT catch: the buyer picking B (dispatches)
                 * then reverting to an already-decided A before B replies.
                 * The dedup gate above skips a new dispatch for that revert —
                 * by design, so re-selecting a decided company costs no
                 * request — which means `seq` is unchanged and this guard
                 * passes B's reply through. `processOrderIntentSuccessResponse()`
                 * itself is what refuses to paint that reply's verdict under
                 * A's live name; see its own comment.
                 *
                 * @returns {boolean} whether the reply is still safe to apply
                 */
                const stillLive = () => {
                    if (seq !== orderIntentSeq) return false;
                    if (twoPaymentComponentInstance !== component) return false;
                    return true;
                };

                component.placeOrderIntent()
                    .then(response => {
                        // Superseded by a newer selection or a remount: drop
                        // the result silently rather than writing it to a
                        // component nothing renders any more.
                        // `processOrderIntentSuccessResponse()` itself guards
                        // the NOTICE (not the dedup bookkeeping) against the
                        // dedup-skipped-revert case — see its own comment.
                        if (!stillLive()) return;
                        component.processOrderIntentSuccessResponse(
                            response,
                            requestedCompanyId,
                            requestedCompanyName
                        );
                    })
                    .catch(error => {
                        if (!stillLive()) return;
                        component.processOrderIntentErrorResponse(
                            error,
                            requestedCompanyId,
                            requestedCompanyName
                        );
                    })
                    .finally(() => {
                        // Only the CURRENT request on the CURRENT instance
                        // takes the spinner down. A stale one finishing late
                        // must not, or the tile stops showing progress while a
                        // live check is still running — and a dead instance
                        // has no spinner left to take down at all. Unlike the
                        // two branches above, this runs regardless of which
                        // company is live: the spinner belongs to "is a check
                        // in flight", not to any one company's verdict.
                        if (!stillLive()) return;
                        // Lowering the row IS the re-derive — see
                        // setOrderIntentChecking(). A second explicit refresh here
                        // was the same "two things to remember to pair" duality
                        // that rule exists to remove.
                        component.setOrderIntentChecking(false);
                    });
                return true;
            };

            if (!executeOrderIntent()) {
                setTimeout(() => {
                    // Second and last attempt. If the component still is not
                    // there, take the spinner down if we can reach one at all —
                    // a spinner with nothing behind it is worse than none.
                    if (!executeOrderIntent() && twoPaymentComponentInstance) {
                        twoPaymentComponentInstance.setOrderIntentChecking(false);
                    }
                }, 100);
            }
        }, 500); // 500ms debounce, for deduplication of rapid dispatches
    });
</script>
