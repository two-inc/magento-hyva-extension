                if (!record) return;

                if (record.kind === 'failure') {
                    if (!this.generalErrorMessage) return;
                    this.orderIntentErrorNotice = this.generalErrorMessage;
                    return;
                }

                /*
                 * A brand that switched this notice off resolves to '', and an
                 * empty string is not a verdict — so nothing is painted and the
                 * box stays hidden rather than becoming an empty bordered strip.
                 * (This used to also decide whether to lower the progress row;
                 * the row is the setter's business now, and only its business.)
                 */
                const text = record.approved
                    ? this.resolveOrderIntentApprovedNotice()
                    : this.resolveOrderIntentNotAvailableNotice();
                if (!text) return;

                if (record.approved) {
                    this.orderIntentApprovedNotice = text;
                } else {
                    this.orderIntentNotAvailableNotice = text;
                }
            },

            // "<name> (<number>)", built here rather than in the template:
            // bound attribute expressions are looked up as a KEY on the
            // component, never evaluated, so a concatenation in the markup
            // would resolve to nothing at all.
            //
            // The parts are guarded rather than assumed. Under the superseded
            // capture gate a non-empty `companyId` was guaranteed whenever this
            // was read; the intent-message gate does not guarantee it, so an
            // unguarded concatenation could paint "Example Ltd ()" or a bare
            // " (12345678)". Same shape as the sibling platforms' single-line
            // builders: no name at all means no label text.
            get companyTileLabelText() {
                const companyName = (this.companyName || '').trim();
                if (!companyName) return '';

                // `twoGatewayDisplayCompanyNumber()`, not the raw value: an
                // internal placeholder identifier (`TWO:` prefix) is never
                // shown to a buyer, and it answers '' for one — which is the
                // same case as "no number", so the BRACKETS disappear with it
                // rather than leaving `Example Ltd ()`.
                const companyId = window.twoGatewayDisplayCompanyNumber(this.companyId);
                return companyId ? companyName + ' (' + companyId + ')' : companyName;
            },

            // Companion to `companyIdHiddenClass`, hiding the whole Company
            // Number block — its static caption included — rather than only
            // the input. Class-NAME STRING for the same reason: `:class` here
            // is a key lookup, not expression evaluation. UNCHANGED by the
            // 2026-08-05 ruling above: that ruling is about the EDITABLE
            // search control and the "Change company" swap specifically, and
            // this block's own capture gate is not part of it — see the
            // comment on the markup that binds this.
            get companyNumberBlockHiddenClass() {
                return this.companyIdHintVisible ? 'hidden' : '';
            },

            fillCompanyData(companyId = '', companyName = '', triggerOrderIntent = true) {
                companyName = typeof companyName === 'string' && companyName ? companyName : '';
                companyId = typeof companyId === 'string' ? companyId : '';
                /*
                 * The NAME is what makes this call meaningful; the id is
                 * allowed to be empty, because the search response is allowed
                 * to omit the national identifier.
                 *
                 * It used to bail on an empty id, which left the buyer looking
                 * at the newly selected company's name beside the PREVIOUS
                 * company's id — in a disabled field they could not correct,
                 * and read straight back out by buildOrderIntentRequestBody()
                 * and by the checkout's own `payment[company_id]`. Writing both
                 * fields unconditionally is what keeps name and id describing
                 * the same company.
                 */
                if (!companyName) return;

                this.companyName = companyName;
                this.companyId = companyId;

                const companyNameInput = document.getElementById("company_name");
                if (companyNameInput) companyNameInput.value = companyName;

                // Value only. The locked state is `companyIdDisabled`, which
                // the field's `:disabled` is bound to and which
                // applyCompanyIdEditability() is the sole writer of — the
                // callers above set `companyIdEntryRequired` and call it
                // BEFORE getting here.
                const companyIdInput = document.getElementById("company_id");
                if (companyIdInput) companyIdInput.value = companyId;

                // Only trigger order intent if the company ID CHANGED — and
                // only when there IS one. An intent for an empty company id is a
                // request the listener would discard anyway; dispatching it just
                // makes the empty case look like a real submission in the event
                // log.
                //
                // This gate is per-company and stays: it suppresses a repeat
                // check for the company already decided, not a check for a new
                // one. A DECISION is recorded only when one has actually landed
                // for that exact company and name (see
                // processOrderIntentSuccessResponse), so picking a different
                // company, or renaming this one, always passes the gate.
                if (this.isOrderIntentEnabled && triggerOrderIntent && companyId
                    && !this.hasOrderIntentDecisionFor(companyId, companyName)) {
                    // Bug 5: the tile-local spinner goes up HERE rather than
                    // when the request leaves, because the listener debounces
                    // 500ms and half a second of a tile that has visibly not
                    // reacted to the pick is the complaint. Every path that
                    // then declines to make a request takes it back down.
                    /*
                     * A row going up means no verdict may be showing: "checking"
                     * and a conclusion cannot both be true of one company.
                     *
                     * Cleared HERE, beside the write that raises the row, rather
                     * than anywhere earlier. Round 5 tried to solve the same
                     * problem by forgetting the failure RECORD at this point,
                     * which cannot work: forgetting a record does not un-paint a
                     * notice that is already on screen, and the panel-closed
                     * repaint runs before this method (selectItem dismisses the
                     * panel, then commits). Clearing the notices is what actually
                     * removes it, and it does not depend on that ordering.
                     *
                     * The failure RECORD is deliberately not dropped here: the
                     * dispatcher has five gates that can still decline to send,
                     * and dropping the record for a request that never leaves
                     * would leave a blocked order with nothing on screen at all.
                     * It is dropped where the request goes on the wire instead.
                     */
                    this.clearOrderIntentNotices();
                    this.setOrderIntentChecking(true);
                    window.dispatchEvent(new Event("dispatch-order-intent"));
                } else {
                    /*
                     * No request is going out — either intent is off, or this
                     * company has already been decided. In the second case the
                     * verdict is known and must go back on screen: a search
                     * starting took the box down (see the control's
                     * `onLoaderStart`), and without this a buyer who searched
                     * again and re-picked the SAME company would be left with a
                     * blank box that nothing could ever refill, because the
                     * dedup gate above will never re-ask.
                     *
                     * Safe when intent is off or there is no decision: the
                     * method clears and then declines to paint anything.
                     */
                    this.refreshOrderIntentVerdict();
                }
            },

            // Order Intent methods
            async placeOrderIntent() {
                try {
                    const quoteData = JSON.parse(JSON.stringify(this.quote));

                    if (this.shouldSkipOrderIntent(quoteData)) return null;

                    const orderIntentRequestBody = this.buildOrderIntentRequestBody(quoteData);

                    // DEPRECATED — see twoGatewayCompanySearch.
                    if (this.isProxyAvailable !== true) {
                        const queryParams = new URLSearchParams({
                            client: this.orderIntentConfig_extensionPlatformName,
                            client_v: this.orderIntentConfig_extensionDBVersion,
                            merchant: this.orderIntentConfig_merchant_shortName
                        });

                        const response = await fetch(`${this.checkoutApiUrl}/v1/order_intent?${queryParams.toString()}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(orderIntentRequestBody)
                        });

                        if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
                        return await response.json();
                    }

                    const envelope = await window.twoGatewayProxyPost(
                        this.restBaseUrl,
                        '/rest/V1/two/order-intent',
                        { payload: JSON.stringify(orderIntentRequestBody) }
                    );

                    if (!envelope.ok) throw new Error(`HTTP error! Status: ${envelope.status}`);
                    return envelope.body;
                } catch (error) {
                    console.error('Error in placeOrderIntent:', error);
                    throw error;
                }
            },

            shouldSkipOrderIntent(quoteData) {
                // Check both component state and DOM for manual entry support
                const companyIdInput = document.getElementById("company_id");
                const companyId = this.companyId || companyIdInput?.value || '';
                return !companyId.trim();
            },

            buildOrderIntentRequestBody(quoteData) {
                // Read from DOM to support manual entry (component state only set for dropdown selection)
                const companyNameInput = document.getElementById("company_name");
                const companyIdInput = document.getElementById("company_id");
                const companyName = this.companyName || companyNameInput?.value || "";
                const companyId = this.companyId || companyIdInput?.value || "";

                let lineItems = quoteData.items?.map(item => ({
                    name: item.name,
                    description: item.description || '',
                    discount_amount: parseFloat(item.discount_amount || 0).toFixed(2),
                    gross_amount: parseFloat(item.row_total_incl_tax || 0).toFixed(2),
                    net_amount: parseFloat(item.row_total || 0).toFixed(2),
                    quantity: item.qty,
                    unit_price: parseFloat(item.price || 0).toFixed(2),
                    tax_amount: parseFloat(item.tax_amount || 0).toFixed(2),
                    tax_rate: (parseFloat(item.tax_percent || 0) / 100).toFixed(6),
                    tax_class_name: '',
                    quantity_unit: this.orderIntentConfig_weightUnit || '',
                    image_url: item.thumbnail,
                    type: item.is_virtual === '0' ? 'PHYSICAL' : 'DIGITAL'
                })) || [];

                lineItems.push({
                    name: 'Shipping',
                    description: 'Shipping fee',
                    gross_amount: parseFloat(quoteData.shipping_incl_tax || 0).toFixed(2),
                    net_amount: parseFloat(quoteData.shipping_amount || 0).toFixed(2),
                    quantity: 1,
                    unit_price: parseFloat(quoteData.shipping_amount || 0).toFixed(2),
                    tax_amount: parseFloat(quoteData.shipping_tax_amount || 0).toFixed(2),
                    tax_rate: isNaN(parseFloat(quoteData.shipping_tax_amount)) || isNaN(parseFloat(quoteData.shipping_amount)) || parseFloat(quoteData.shipping_amount) === 0
                        ? "0.000000"
                        : (parseFloat(quoteData.shipping_tax_amount) / parseFloat(quoteData.shipping_amount)).toFixed(6),
                    tax_class_name: '',
                    quantity_unit: 'unit',
                    type: 'SHIPPING_FEE'
                });

                // The same one resolution the search uses, so an order intent can
                // never be checked against a different country from the one the
                // company was found in.
                this.countryCode = this.resolveCountryCode(quoteData);

                const gross_amount = parseFloat(quoteData.grand_total || 0);
                const tax_amount = parseFloat(quoteData.tax_amount) + parseFloat(quoteData.shipping_tax_amount);
                const net_amount = gross_amount - tax_amount;

                return {
                    gross_amount: gross_amount.toFixed(2),
                    net_amount: net_amount.toFixed(2),
                    tax_amount: tax_amount.toFixed(2),
                    currency: quoteData.quote_currency_code,
                    line_items: lineItems,
                    buyer: {
                        company: {
                            organization_number: companyId,
                            country_prefix: this.countryCode,
                            company_name: companyName
                        },
                        representative: {
                            email: quoteData.email,
                            first_name: quoteData.first_name,
                            last_name: quoteData.last_name,
                            phone_number: quoteData.telephone
                        }
                    },
                    // The proxy resolves the merchant from the store's API key.
                    ...(this.isProxyAvailable === true ? {} : {
                        merchant_id: this.orderIntentConfig_merchant_id,
                        merchant_short_name: this.orderIntentConfig_merchant_shortName
                    })
                };
            },

            /**
             * Resolve the intent-approved notice text for the current buyer.
             * Returns '' when the brand suppressed the notice, so callers can
             * assign the result unconditionally.
             *
             * The company name AND number are substituted here (TWO-25326
             * §7.3) because both are only known client-side. A replacer
             * *function* is used rather than a plain string so `$&` / `$1` in
             * a company name or number are taken literally instead of as
             * replacement patterns.
             */
            resolveOrderIntentApprovedNotice() {
                const copy = this.orderIntentApprovedNoticeCopy;
                if (!copy) return '';

                const companyName = (this.companyName || '').trim();
                if (!companyName) {
                    return typeof copy.withoutCompany === 'string' ? copy.withoutCompany : '';
                }
                /*
                 * A copy object missing its `withCompany` sentence resolves to
                 * NOTHING, rather than throwing. This is reached from the
                 * dispatcher's `finally` now (the box is re-derived once a request
                 * settles), and a throw there is an unhandled rejection that takes
                 * the rest of that handler with it — including lowering the
                 * progress row. A brand supplies this copy through config; the
                 * tile must degrade to a silent box, not to a dead one.
                 */
                if (typeof copy.withCompany !== 'string') return '';

                // '' for an absent number AND for an internal placeholder one
                // (`TWO:` prefix), which must never reach a buyer — see
                // twoGatewayDisplayCompanyNumber().
                const companyId = window.twoGatewayDisplayCompanyNumber(this.companyId);
                const text = copy.withCompany
                    .replace(copy.companyNameToken, () => companyName)
                    .replace(copy.companyNumberToken, () => companyId);
                // With no number to substitute, the brackets the copy wraps the
                // token in have to go too: "Example Ltd ()" reads as a rendering
                // fault. Stripped from the RESULT rather than by keeping a
                // second bracket-less copy string per locale, so the four
                // translation catalogues carry one sentence each and cannot
                // drift apart. The pattern is deliberately narrow — an empty
                // bracket pair and the single space that precedes it, nothing
                // else.
                return companyId ? text : text.replace(/ ?\(\s*\)/g, '');
            },

            /**
             * Sibling of resolveOrderIntentApprovedNotice() for the "not
             * approved / no intent" wording (TWO-25326 §7.2/§7.3). Same
             * empty-brand-switch and substitution contract.
             */
            resolveOrderIntentNotAvailableNotice() {
                const copy = this.orderIntentNotAvailableCopy;
                if (!copy) return '';

                const companyName = (this.companyName || '').trim();
                if (!companyName) {
                    return typeof copy.withoutCompany === 'string' ? copy.withoutCompany : '';
                }
                /*
                 * A copy object missing its `withCompany` sentence resolves to
                 * NOTHING, rather than throwing. This is reached from the
                 * dispatcher's `finally` now (the box is re-derived once a request
                 * settles), and a throw there is an unhandled rejection that takes
                 * the rest of that handler with it — including lowering the
                 * progress row. A brand supplies this copy through config; the
                 * tile must degrade to a silent box, not to a dead one.
                 */
                if (typeof copy.withCompany !== 'string') return '';

                // '' for an absent number AND for an internal placeholder one
                // (`TWO:` prefix), which must never reach a buyer — see
                // twoGatewayDisplayCompanyNumber().
                const companyId = window.twoGatewayDisplayCompanyNumber(this.companyId);
                const text = copy.withCompany
                    .replace(copy.companyNameToken, () => companyName)
                    .replace(copy.companyNumberToken, () => companyId);
                // With no number to substitute, the brackets the copy wraps the
                // token in have to go too: "Example Ltd ()" reads as a rendering
                // fault. Stripped from the RESULT rather than by keeping a
                // second bracket-less copy string per locale, so the four
                // translation catalogues carry one sentence each and cannot
                // drift apart. The pattern is deliberately narrow — an empty
                // bracket pair and the single space that precedes it, nothing
                // else.
                return companyId ? text : text.replace(/ ?\(\s*\)/g, '');
            },

            /**
             * @param {Object|null} response
             * @param {string} [requestedCompanyId] the company this decision was
             *   REQUESTED for. Passed by the dispatcher rather than re-read off
             *   live state: the two agree under the sequence guard, but reading
             *   `this.companyId` here is what let a late decision for company A
             *   be filed against company B — and then permanently suppress B's
             *   own check, because the dedup gate compares against this value.
             * @param {string} [requestedCompanyName] the NAME that company had
             *   when the request went out, captured by the dispatcher for the
             *   same reason the id is. Omit it and the record's name is derived
             *   only when it provably belongs to the recorded id (the reply is
             *   about the company on screen); otherwise it is recorded as
             *   unknown, never guessed from live state.
             */
            processOrderIntentSuccessResponse(response, requestedCompanyId, requestedCompanyName) {
                if (!response) return;

                const decidedCompanyId = typeof requestedCompanyId === 'string'
                    && requestedCompanyId
                    ? requestedCompanyId
                    : this.companyId;

                // Recorded UNCONDITIONALLY, even if the reply arrives after the
                // buyer has moved on: this record is the dedup gate's memory as
                // well as what the box is painted from, so it has to advance for
                // `decidedCompanyId` regardless of what is on screen now, or that
                // company's own check would be permanently stuck pending — the
                // original bug 4 defect this whole mechanism exists to fix.
                // The verdict record — id, name and decision — advances as ONE
                // write, unconditionally. Writing the id here and the other two
                // below the paint guard was a real defect: pick A (approved),
                // pick B, revert to A before B replies, and B's reply advanced
                // the id to B while leaving A's name and A's decision in place. B
                // was then unreachable in both directions — the dedup gate
                // refused to re-ask because the id said B was decided, and
                // refresh() refused to paint because the name said A — and a
                // hand-edited number could pair B's id with A's approval on
                // screen, which is the wrong-company verdict the sequence guard
                // exists to prevent.
                //
                // The name comes from the DISPATCHER, captured when the request
                // went out, for the same reason the id does: `this.companyName`
                // here is whatever is on screen NOW, which for a late reply is
                // another company's.
                //
                // The invariant is that the recorded NAME always describes the
                // recorded ID. There are exactly three ways to satisfy it, and no
                // fallback to "whatever name is on screen" among them — that
                // guess is what let the record come apart, because for a LATE
                // reply the screen is showing another company.
                //
                //   - the dispatcher said which name it asked about: use it;
                //   - it did not, but this reply is about the company on screen,
                //     so the live name provably belongs to this id: use that;
                //   - it did not and the reply is late: the name is genuinely
                //     UNKNOWN, so record it as such.
                //
                // `null` is not a name any company has, so the record can never
                // be matched against a live name and the box stays empty —
                // fail-closed. The DEDUP memory still advances regardless, which
                // is what TWO-25345 needs so a decided company is never re-asked
                // about.
                const recordedName = typeof requestedCompanyName === 'string'
                    ? requestedCompanyName
                    : (decidedCompanyId === this.companyId ? this.companyName : null);

                if (!decidedCompanyId) return;
                this.orderIntentDecisions[decidedCompanyId] = {
                    name: recordedName,
                    approved: Boolean(response.approved),
                };
                // A decision supersedes any earlier FAILED check for the same
                // company: the question has been answered now.
                this.forgetOrderIntentError(decidedCompanyId);

                /*
                 * The VISIBLE verdict is a separate concern from the dedup
                 * bookkeeping above, and is guarded on its own (review round 4):
                 * the dedup gate deliberately skips dispatching (and does not
                 * advance `orderIntentSeq`) when the buyer re-picks a company
                 * already decided — so pick A (decided) → pick B (dispatches)
                 * → revert to A before B replies leaves this reply passing the
                 * dispatcher's sequence/liveness guard even though it is about
                 * a company no longer on screen. Painting it here would build
                 * `resolveOrderIntentApprovedNotice()` from LIVE
                 * `companyName`/`companyId` (A's) while filing the decision
                 * under B — a verdict for one company displayed with another's
                 * name on it. Dropping it here, after the bookkeeping above has
                 * already run, is what makes a later re-pick of B free (its
                 * decision record already landed) without ever
                 * showing the buyer a company/verdict pair that never happened
                 * together.
                 */
                if (decidedCompanyId !== this.companyId) return;

                // Past the guard, and only past it. This bit says whether THE
                // ORDER may be placed, and the order is for the company on
                // screen — so a late reply about a company the buyer has left
                // must not touch it (round 5). It is still set before the
                // panel-open guard below, because a reply that merely declines to
                // PAINT has still decided, and leaving it stale would let a
                // declined company through on a flag set by an earlier approval.
                this.placeOrderIntentFlag = Boolean(response.approved);

                /*
                 * ONE VERDICT, ONE NOTICE — and never the toast while the box
                 * exists (2026-08-06 ruling).
                 *
                 * A decline used to raise a 5-second `dispatchMessages()` toast
                 * AS WELL AS the in-tile "not available" box. Two notices for one
                 * verdict, and the toast is the weaker of the two: it
                 * self-dismisses, it lands at the top of the page rather than in
                 * the tile the buyer is reading, and it says the same thing the
                 * box beside their company already says and keeps saying.
                 *
                 * The box is not unconditional, though, which is why this is a
                 * FALLBACK rather than a deletion (review round 1). Its ELEMENT is
                 * only rendered when the brand has not switched the notice copy
                 * off (`getOrderIntentNotAvailableNotice()` — and a brand shipping
                 * today does switch it off), so on such a brand deleting the toast
                 * outright left a declined buyer with no signal whatsoever.
                 *
                 * Gated on the RESOLVED SENTENCE being empty, not on the copy
                 * being null (review round 2). The two agree for the brand switch,
                 * which is the case that matters — `resolveOrderIntentNotAvailable
                 * Notice()` returns '' for absent copy — but the resolver also
                 * returns '' for copy that is present and unusable (a malformed
                 * object missing its sentence, which it deliberately degrades to a
                 * silent box for rather than throwing). Asking "is there a
                 * sentence to show" covers both; asking "is the copy null" leaves
                 * the malformed case with a rendered-but-empty box and no toast,
                 * i.e. silence again, from the exact defensive branch that exists
                 * to avoid a dead tile.
                 *
                 * Reached only past the `decidedCompanyId !== this.companyId`
                 * guard above, so the resolver's reads of live `companyName` /
                 * `companyId` are provably about the company this reply decided.
                 *
                 * Above the panel-open guard below, deliberately: that guard
                 * defers only the BOX, and a brand with no box has nothing to
                 * defer.
                 *
                 * The FAILED-check path (processOrderIntentErrorResponse below)
                 * toasts unconditionally, for a different reason: it carries the
                 * API's own diagnostic detail, which the box deliberately does not
                 * show.
                 */
                if (!response.approved && this.resolveOrderIntentNotAvailableNotice() === '') {
                    // Guarded HERE, not "like every other call site" — three of
                    // the six in this file are unguarded, the failed-check toast
                    // below among them. The reason to guard this one is that it
                    // is the ONLY signal a declined buyer gets on a brand with
                    // no inline notice, so a missing global must not turn "you
                    // were declined" into a thrown error and nothing on screen.
                    if (typeof window.dispatchMessages === 'function') {
                        window.dispatchMessages(
                            [{ type: 'error', text: this.orderIntentDeclinedMessage }],
                            5000
                        );
                    }
                }

                /*
                 * RECORDED above, PAINTED by one place. This handler no longer
                 * writes a notice itself: it re-derives, and refresh() decides
                 * what may be on screen — nothing while a check is running,
                 * nothing under an open results panel, otherwise this company's
                 * own record.
                 *
                 * That is what makes the invariant one rule instead of two
                 * painters agreeing by hand. When this runs from the dispatcher a
                 * check is by definition still in flight, so refresh() paints
                 * nothing here and the dispatcher's own lowering of the row is
                 * what puts the verdict up a moment later.
                 */
                this.refreshOrderIntentVerdict();
            },

            /**
             * @param {Object} response
             * @param {string} [requestedCompanyId] same contract as
             *   `processOrderIntentSuccessResponse()`'s — but an ERROR never
             *   advances the DECISION record (a failed check must stay
             *   eligible to retry), so this is used for the notice guard only:
             *   a reply that arrives after the buyer has reverted to a
             *   different, already-decided company must not blank that
             *   company's approved notice on its way out.
             * @param {string} [requestedCompanyName] the NAME that company had
             *   when the request went out. Recorded with the failure so an
             *   abandoned search can put the report back under the name the check
             *   actually ran for, rather than one edited by hand since.
             */
            processOrderIntentErrorResponse(response, requestedCompanyId, requestedCompanyName) {
                if (typeof requestedCompanyId === 'string' && requestedCompanyId
                    && requestedCompanyId !== this.companyId) {
                    return;
                }
                this.placeOrderIntentFlag = false;
                // Any notice left over from a previous, successful intent is
                // dropped by refreshOrderIntentVerdict() at the end of this
                // method — it clears unconditionally before deciding what may be
                // shown. An explicit clear here was a second copy of that.
                let message = this.generalErrorMessage;

                if (response?.responseJSON) {
                    const { error_code, error_message, error_details, error_json } = response.responseJSON;

                    switch (error_code) {
                        case 'SCHEMA_ERROR':
                            if (error_json) {
                                message = '';
                                error_json.forEach(error => {
                                    window.dispatchMessages([{ type: 'error', text: error.msg }], 3000);
                                });
                            }
                            break;
                        case 'JSON_MISSING_FIELD':
                            if (error_details) message = error_details;
                            break;
                        case 'MERCHANT_NOT_FOUND_ERROR':
                        case 'ORDER_INVALID':
                            message = error_message + (error_details ? ' - ' + error_details : '');
                            break;
                    }
                }

                // The persistent box, alongside the toast this path still
                // raises rather than instead of it. A FAILED check is the one
                // verdict that keeps both: the toast carries the API's own
                // diagnostic detail, which the box deliberately does not show
                // (see below). A DECLINE has no toast any more — one verdict,
                // one notice (2026-08-06, see the success handler above).
                //
                // The box gets the GENERAL wording, never the API's own
                // `error_message`/`error_details`. Those are diagnostic strings
                // written for a developer, and the box does not self-dismiss —
                // parking raw upstream text permanently in a buyer's checkout is
                // not the same decision as flashing it for three seconds. The
                // toast below still carries the detail for whoever is watching.
                //
                // Empty (and so hidden) exactly when there is no sentence to
                // show: SCHEMA_ERROR sets `message` to '' and toasts one message
                // per offending field instead.
                /*
                 * RECORDING the failure and DISPLAYING it are two decisions.
                 *
                 * The record is what lets the panel closing report a failure that
                 * happened while the buyer was mid-search, so it is written
                 * whenever there is a sentence to show — independent of whether
                 * this moment is one where a box may appear. Gating them together
                 * is how an earlier attempt at this ended up writing neither.
                 *
                 * `boxText`, not `message`: the box carries the GENERAL wording
                 * (the API's own diagnostic strings are for the toast, which
                 * self-dismisses), and an empty `generalErrorMessage` must leave
                 * no record, or the record would be one nothing could ever paint.
                 */
                // Whether this failure is REPORTABLE at all: there must be
                // something to say (`message` — SCHEMA_ERROR clears it and toasts
                // per field instead) and wording to say it in. Deliberately not
                // "the text to paint": the painting is refresh's, and it reads
                // `generalErrorMessage` itself.
                const isReportable = Boolean(message && this.generalErrorMessage);

                if (isReportable && this.companyId) {
                    // In the FAILURES map, never in the dedup memory, so the check
                    // stays retryable.
                    this.orderIntentFailures[this.companyId] = {
                        // The name the check actually RAN for, not whatever the
                        // field holds now: the guard above pins the id, but a name
                        // hand-edited while the request was out would otherwise
                        // file the failure under a name it was never about.
                        name: typeof requestedCompanyName === 'string'
                            ? requestedCompanyName
                            : this.companyName,
                    };
                }

                // Same single painter as the success path: record above,
                // re-derive here, and refresh() decides whether a box may appear.
                this.refreshOrderIntentVerdict();

                if (message) {
                    window.dispatchMessages([{ type: 'error', text: message }], 3000);
                }
            },
        });
    }

    /**
     * The component the payment `<form>` mounts: the tile component's state
     * and derivations, plus the form's validation and autosave.
     *
     * TWO-25332: composed with DESCRIPTORS, not spread. This used to be
     *
     *     return { ...PaymentMethodBase(), ...twoValidatePaymentForm(…) };
     *
     * which evaluated each of PaymentMethodBase()'s getters once and copied
     * the frozen result, so on the component the form actually mounted
     * `orderIntentMessageVisible`, `companyTileLabelText`,
     * `companyIdHintVisible`, `companyIdHiddenClass` and
     * `companyNumberBlockHiddenClass` were all dead data properties holding
     * their pre-interaction value. Every §7 company-search behaviour tied to
     * them was inert in production, and no test saw it because the suites
     * mounted the BASE component, where the getters are real.
     * `payment-form-composition.test.js` mounts THIS factory for that reason
     * — do not let that suite go away.
     *
     * The validation object still wins on a name collision (`init`), exactly
     * as the spread ordering did.
     */
    function <?= $gwBase ?>PaymentFormWithValidation() {
        return twoGatewayComposeLive(
            <?= $gwBase ?>PaymentMethodBase(),
            twoValidatePaymentForm(this.$el, this.$wire)
        );
    }

    function <?= $gwBase ?>PaymentTermsComponent() {
        return <?= $gwBase ?>PaymentMethodBase();
    }

    // Per-chip component. Hyva loads alpine3-csp.min.js which forbids
    // function calls, comparisons, object literals, and boolean operators
    // in attribute expressions — so every chip is its own Alpine.data
    // component reading `days` from a data-* attribute and exposing
    // bare-identifier getters for the template to bind to.
    function <?= $gwBase ?>TermChip() {
        return {
            days: 0,
            labelSingular: '1 day',
            labelPlural: '%1 days',
            labelSingle: '',
            errorMessage: 'Could not update payment term. Please try again.',
            isUpdating: false,
            single: false,

            init() {
                this.days = parseInt(this.$el.dataset.days, 10) || 0;
                // `single` marks the sole-available-term chip: informational,
                // not clickable, distinct --single styling (matches Luma).
                this.single = this.$el.dataset.single === '1';
                // Translated labels sourced from PHP via __(); CSV strings
                // live in the plugin's i18n/<locale>.csv files.
                if (this.$el.dataset.labelSingular) this.labelSingular = this.$el.dataset.labelSingular;
                if (this.$el.dataset.labelPlural) this.labelPlural = this.$el.dataset.labelPlural;
                // Only the sole-term chip carries this: it names the term
                // inside the chip ('Payment Terms 30 days') because that
                // branch renders no heading above the chips.
                if (this.$el.dataset.labelSingle) this.labelSingle = this.$el.dataset.labelSingle;
                if (this.$el.dataset.errorMessage) this.errorMessage = this.$el.dataset.errorMessage;
            },

            get label() {
                // Sole-term chip: 'Payment Terms %1 days' — same string Luma's
                // singleTermLabel uses, including its 1-day plural quirk.
                if (this.single && this.labelSingle) {
                    return this.labelSingle.replace('%1', this.days);
                }
                return this.days === 1
                    ? this.labelSingular
                    : this.labelPlural.replace('%1', this.days);
            },

            get isSelected() {
                return this.days === (parseInt(this.$wire.selectedTerm, 10) || 0);
            },

            get isLoading() {
                return this.isUpdating;
            },

            // Shared busy flag — disables every chip while any one is
            // mid-round-trip. Prevents the buyer queueing multiple
            // selectTerm calls before the first resolves.
            get anyUpdating() {
                return Alpine.store('twoChip').busy;
            },

            get chipClasses() {
                if (this.single) {
                    return 'two-term-chip two-term-chip--single';
                }
                return this.isSelected
                    ? 'two-term-chip two-term-chip--selected'
                    : 'two-term-chip';
            },

            get ariaPressed() {
                return this.isSelected ? 'true' : 'false';
            },

            get surchargeText() {
                const surcharges = this.$wire.termSurcharges || {};
                const terms = Object.keys(surcharges);
                // Empty map → surcharges not yet loaded; show nothing.
                if (!terms.length) return '';
                const raw = surcharges[this.days];
                if (raw === undefined) return '';
                // Match Luma (gateway_method.js `termOptions`): if EVERY
                // term is ~zero, show no fee on any chip; if ANY term is
                // non-zero, show the fee on every chip — zero-fee chips
                // then render `+€ 0.00`. The `< 0.005` threshold and the
                // `+` prefix mirror the Luma renderer exactly so the two
                // checkouts display identically.
                const allZero = terms.every(function (days) {
                    return parseFloat(surcharges[days] || 0) < 0.005;
                });
                if (allZero) return '';
                const amount = parseFloat(raw || 0);
                const currency = this.$wire.currencyCode || 'EUR';
                // Use the Magento store-view locale piped from PHP
                // (`nl-NL`, `en-GB`, ...) so the chip's currency format
                // matches the order summary. Browser default would
                // produce `€16.03` while Magento formats `€ 16,03`.
                const locale = this.$wire.currencyLocale || undefined;
                try {
                    return '+' + new Intl.NumberFormat(locale, {
                        style: 'currency',
                        currency: currency
                    }).format(amount);
                } catch (e) {
                    return '+' + amount.toFixed(2);
