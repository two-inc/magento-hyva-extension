            },

            // --- address lookup (identical across every surface that offers it) ---
            async addressLookup(lookupId, container) {
                const data = await window.twoGatewayCompanyDetail(this.checkoutApiUrl, lookupId);
                if (data && data.addresses && data.addresses.length > 0) {
                    this.setAddressData(data.addresses[0], container);
                }
            },
            setAddressData(address, container) {
                if (!container) {
                    if (cfg.addressContainerWarning) console.warn(cfg.addressContainerWarning);
                    return;
                }
                const cityInput = container.querySelector('input[name="city"]');
                const postcodeInput = container.querySelector('input[name="postcode"]');
                const streetInput = container.querySelector('input[name="street[0]"]');
                if (cityInput) cityInput.value = address.city || "";
                if (postcodeInput) postcodeInput.value = address.postal_code || "";
                if (streetInput) streetInput.value = address.street_address || "";
                [cityInput, postcodeInput, streetInput].forEach((input) => {
                    if (input) input.dispatchEvent(new Event('input', { bubbles: false }));
                });
            },

            closeDropdown() {
                this.abortCompanySearch();
                this.endSearchInteraction();
                this.isSearchUnavailable = false;
                this.isOpen = false;
                this.items = [];
                this.selectedIndex = -1;
                this.query = '';
                this.searchCompletedFor = null;
                cfg.onDropdownClear.call(this);
            },
            closeCompanyList(event) {
                if (event.key === 'Tab') this.closeDropdown();
            },
        };
    };

    /**
     * Compose `source` onto `target` KEEPING ACCESSORS AS ACCESSORS.
     *
     * TWO-25332. Object spread and Object.assign copy own enumerable
     * properties BY VALUE: they invoke every getter once, at composition
     * time, and store the result as a plain data property. A component
     * composed that way carries a snapshot nothing ever updates again, so
     * every `x-show` / `x-text` / `:class` bound to a derived value paints
     * the value it had before the buyer did anything — silently, because a
     * frozen property reads exactly like a working one.
     *
     * Copying the property DESCRIPTORS instead keeps a getter a getter, so
     * it is re-evaluated on every read the way Alpine's reactivity assumes.
     *
     * @param {Object} target mutated and returned
     * @param {Object} source its own descriptors are copied onto target
     * @returns {Object} target
     */
    function twoGatewayComposeLive(target, source) {
        return Object.defineProperties(
            target,
            Object.getOwnPropertyDescriptors(source)
        );
    }

    function twoValidatePaymentForm(form, wire) {
        let timeout = null;
        let dirty = false;

        // hyva.formValidation() is third-party and is copied by value as
        // before, unchanged: we RELY on it exposing no accessors — nothing
        // in this repo can check that, Hyvä checkout being a commercial
        // package with no distribution here — and defining onto the object
        // it returns would mutate a Hyvä-owned value. THIS literal is
        // composed live, so a getter added to it later cannot be frozen the
        // way TWO-25332's were.
        return twoGatewayComposeLive(
            Object.assign({}, hyva.formValidation(form)), {
                init() {
                    const doSave = async (isWithValidation = true) => {
                        clearTimeout(timeout);

                        if (isWithValidation) {
                            // Clear stale flash messages from a prior attempt so a
                            // resubmit doesn't render outdated errors (mirrors the
                            // Luma renderer's messageContainer.clear()).
                            // Hyva's stepTo() fires the same event when navigating.
                            window.dispatchEvent(new Event('clear-messages'));

                            try {
                                await this.validate();
                            } catch (error) {
                                // Swallow so the autosave/navigation task resolves;
                                // the validator registered in init() is what blocks
                                // Place Order on an invalid form.
                                console.error("Form validation failed:", error);
                                return;
                            }
                        }
                        if (this.isOrderIntentEnabled) {
                            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

                            if (activePaymentMethod) {
                                const selectedPaymentValue = activePaymentMethod.value;
                                const isTwoPaymentSelected = selectedPaymentValue === "<?= $brandedViewModel->getMethodCode() ?>";

                                if (isTwoPaymentSelected) {
                                    const formRef = form;

                                    await new Promise((resolve, reject) => {
                                        const timeoutId = setTimeout(() => {
                                            reject("Order intent operation timed out");
                                        }, 5000);

                                        const checkAndProceed = () => {
                                            try {
                                                const formElements = [
                                                    'department',
                                                    'project',
                                                    'poNumber',
                                                    'orderNote',
                                                    'invoiceEmails',
                                                    'company_name',
                                                    'company_id'
                                                ];

                                                const paymentData = {
                                                    additionalData: Object.fromEntries(
                                                        formElements.map(field => {
                                                            const element = formRef.querySelector(`[name="payment[${field}]"]`);
                                                            return [field === 'company_name' ? 'companyName' : field === 'company_id' ? 'companyId' : field, element?.value || ""];
                                                        })
                                                    )
                                                };

                                                paymentData.additionalData.organization_number = paymentData.additionalData.companyId;

                                                Magewire.find("<?= $brandedViewModel->getMagewireBlockName() ?>")
                                                    .call('setPaymentData', paymentData)
                                                    .then(() => {
                                                        clearTimeout(timeoutId);
                                                        resolve();
                                                    })
                                                    .catch((error) => {
                                                        console.error("Error setting payment data:", error);
                                                        clearTimeout(timeoutId);
                                                        resolve();
                                                    });

                                            } catch (error) {
                                                console.error("Error in payment data processing:", error);
                                                clearTimeout(timeoutId);
                                                resolve();
                                            }
                                        };

                                        setTimeout(checkAndProceed, 1000);
                                    });
                                }
                            }
                        }

                        try {
                            if (!dirty) {
                                return;
                            }

                            dirty = false;
                            await wire.store();
                        } catch (exception) {
                            console.error("Error in wire.store():", exception);
                        }

                    }

                    const interactionCallback = () => {
                        dirty = true;

                        clearTimeout(timeout);

                        try {
                            timeout = setTimeout(() => {
                                doSave(false);
                            }, wire.autoSaveTimeout);
                        } catch (error) {
                            console.error("Error in interactionCallback setTimeout:", error);
                        }
                    }

                    hyvaCheckout.navigation.addTask(doSave, {
                        name: '<?= str_replace('checkout.payment.method.', '', $brandedViewModel->getMagewireBlockName()) ?>'
                    });

                    // Block Place Order while the payment form is invalid.
                    // The doSave task above swallows validation
                    // failures (a rejected navigation task would abort with
                    // Hyva's generic "Something went wrong" alert), so without
                    // this validator order.place() proceeds with
                    // setPaymentData skipped and the backend rejects the order
                    // with a raw "Invalid organization number: ''" banner. A
                    // false return aborts placement silently, leaving
                    // hyva.formValidation's field-level messages (e.g.
                    // terms-not-accepted) as the feedback.
                    hyvaCheckout.validation.register(
                        '<?= str_replace('checkout.payment.method.', '', $brandedViewModel->getMagewireBlockName()) ?>_form',
                        async () => {
                            const activePaymentMethod = document.querySelector('input[name="payment-method-option"]:checked');

                            if (!activePaymentMethod || activePaymentMethod.value !== "<?= $brandedViewModel->getMethodCode() ?>") {
                                return true;
                            }

                            try {
                                await this.validate();
                                return true;
                            } catch (error) {
                                return false;
                            }
                        },
                        form
                    );

                    const addEventListeners = (el) => {
                        if (el !== form) return;

                        this.$nextTick(() => {
                            Array.from(form.querySelectorAll('[wire\\:auto-save]')).forEach(field => {
                                ['input', 'change'].map(eventName => {
                                    field.removeEventListener(eventName, interactionCallback);
                                    field.addEventListener(eventName, interactionCallback);
                                })
                            })
                        })
                    }

                    addEventListeners(form);
                    Magewire.hook('element.updated', addEventListeners);
                }
            }
        )
    }

    function <?= $gwBase ?>PaymentMethodBase() {
        /*
         * TWO-25326 rebuild. Every bit of search/dropdown/manual-entry state
         * and behaviour below is composed live from the ONE shared engine
         * (twoGatewayCompanySearchEngine, defined above) — `manualMode`,
         * `isOpen`, `items`, `companyName`, `companyId`,
         * `companyIdEntryRequired`, `companyIdDisabled`, `selectItem()`,
         * `enterManually()`, `enableSearch()`, `nextItem()`/`prevItem()`,
         * `applyCompanyIdEditability()` and friends all come from there. What
         * follows is ONLY what is genuinely specific to this tile: the
         * dual-input id/name swap between the search- and manual-mode field
         * pair, order-intent dispatch/dedup, and the billing/shipping
         * storage split — three real features, not three copies of the
         * search box.
