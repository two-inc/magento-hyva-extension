$orderIntentNotAvailableNotice = $configModel->getOrderIntentNotAvailableNotice();
$orderIntentDeclinedMessage = $configModel->getOrderIntentDeclinedMessage();
$generalErrorMessage = $configModel->getGeneralErrorMessage();
