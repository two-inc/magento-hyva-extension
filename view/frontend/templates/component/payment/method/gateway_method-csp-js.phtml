$restBaseUrl = rtrim((string) $block->getBaseUrl(), "/");
$merchantDetails = $orderIntentConfig["merchant"] ?? [];
$merchantId = $merchantDetails["id"] ?? "";
$merchantName = $merchantDetails["short_name"] ?? "";
$clientName = $configModel->getClientName();
$clientVersion = $configModel->getClientVersion();

$quoteDetails = $quoteModel->getQuoteDetails();
$currentStoreId = $quoteModel->getCurrentStoreId();
// The HEX flags are load-bearing, not decoration. This lands inside a
// single-quoted JS string literal in an inline script and carries
// buyer-supplied values (email, telephone, address, product names). Without
// JSON_HEX_APOS a buyer's apostrophe closes the literal, and without
// JSON_HEX_TAG a buyer who types a script end tag terminates the whole block
// early — script injection on the checkout, and a second way to hijack the
// tag search that HyvaCsp uses to place the CSP token.
//
// What this is NOT is a JSON payload anything reads. The value below is the
// `quote` default, and initialize() replaces it with the object parsed from
// gateway_method.phtml's data-hyvacsp1 attribute before anything consumes it.
// It could not be parsed anyway: JSON_HEX_QUOT survives only as far as the JS
// string layer, which un-escapes it back to a bare double quote, so a product
// name containing one would break JSON.parse. That attribute is the live path
// and is protected by htmlspecialchars(ENT_QUOTES) instead, which is why the
// two templates pass different flag sets for the same data.
// Test/Unit/View/QuoteDetailsEncodingTest covers both.
$quoteDetails = json_encode(
    $quoteDetails,
    JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP
    | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE,
) ?: '{}';

