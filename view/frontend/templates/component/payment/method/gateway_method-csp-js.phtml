<script>
    /*
     * The company selection the checkout carries between its steps, keyed per
     * STORE VIEW.
     *
     * It used to be one global `shipping_company_selection`, and the quote is
     * shared across store views by design — so a buyer who changed store view
     * (typically a language switch) kept the same quote, no quote-id comparison
     * fired, and the company chosen in the other checkout survived the whole
     * quote. Scoping the key rather than clearing on a store change means each
     * store view keeps its OWN selection: a language toggle destroys nothing,
     * and there is no cross-store bleed left to clear up after.
     *
     * Read and write go through these two so the key is built in one place, and
     * so a write can never rebuild the blob from a partial key list — dropping
     * `quote_id` that way is what silently disarmed the new-order clear.
     *
     * Published from this template because it is where the other shared
     * `twoGateway*` helpers live, and because every consumer calls them after
     * load rather than at script-eval time.
     */
    window.TWO_GATEWAY_COMPANY_SELECTION_STORE = window.TWO_GATEWAY_COMPANY_SELECTION_STORE
        || '<?= $escaper->escapeJs((string) $currentStoreId) ?>';

    /*
     * '' when the store view could not be resolved at all. That must NOT become
     * `shipping_company_selection:` — a store-less bucket every store view would
     * share is the exact leak this keying removes. An empty key means "no
     * storage": reads answer {} and writes are dropped, so a degraded page
     * carries nothing over instead of carrying it everywhere.
     */
    window.TWO_GATEWAY_COMPANY_SELECTION_KEY = window.TWO_GATEWAY_COMPANY_SELECTION_KEY
        || (window.TWO_GATEWAY_COMPANY_SELECTION_STORE
            ? 'shipping_company_selection:' + window.TWO_GATEWAY_COMPANY_SELECTION_STORE
            : '');

    /**
     * Read the current store view's company selection.
     *
     * Also retires the pre-scoping global key on first sight. It is dropped
     * rather than adopted into the current store: adopting it would reproduce
     * the very cross-store leak this scoping removes, once, for every buyer
     * mid-checkout at deploy time. The cost is that such a buyer re-picks their
     * company once, from a dropdown that works.
     *
     * @returns {Object} the stored blob, or {} when absent or unparseable
     */
    window.twoGatewayReadCompanySelection = window.twoGatewayReadCompanySelection || function() {
        /*
         * The ENTIRE body is guarded, not just the JSON.parse.
         *
         * This runs inside the `alpine:init` and `DOMContentLoaded` handlers that
         * go on to call Alpine.data() and to start the payment-form
         * MutationObserver, so anything that throws here takes those
         * registrations with it and leaves a dead checkout step — the same outage
         * class as an inline block the CSP refuses. `hyva` or getBrowserStorage()
         * absent, a storage implementation with no removeItem, and getItem or
         * removeItem throwing (storage disabled, private browsing, quota) are all
         * reachable and all used to escape: an earlier revision guarded only the
         * parse, and a throwing storage stub left `searchInput` unregistered.
         */
        try {
            const key = window.TWO_GATEWAY_COMPANY_SELECTION_KEY;
            const storage = hyva.getBrowserStorage();

            // Retire the pre-scoping global key. Dropped, never adopted into the
            // current store: adopting would reproduce the cross-store leak once,
            // for every buyer mid-checkout at deploy.
            if (storage.getItem('shipping_company_selection') !== null) {
                storage.removeItem('shipping_company_selection');
            }

            if (!key) {
                return {};
            }

            // A stored primitive or array is not a selection. `|| {}` alone only
            // rescues a falsy parse, so `42` or `"x"` would flow out of here and
            // contradict the contract above.
            const parsed = JSON.parse(storage.getItem(key) || '{}');
            return (parsed && typeof parsed === 'object' && !Array.isArray(parsed))
                ? parsed
                : {};
        } catch (error) {
            return {};
        }
    };

    /**
     * Merge `patch` into the current store view's company selection.
     *
     * @param {Object} patch keys to overwrite; everything else is preserved
     * @returns {Object} the merged blob as written
     */
    window.twoGatewayWriteCompanySelection = window.twoGatewayWriteCompanySelection || function(patch) {
        const merged = Object.assign({}, window.twoGatewayReadCompanySelection(), patch || {});
        // Guarded for the same reason as the read, and dropped entirely when
        // there is no key to write to.
        try {
            const key = window.TWO_GATEWAY_COMPANY_SELECTION_KEY;
            if (key) {
                hyva.getBrowserStorage().setItem(key, JSON.stringify(merged));
            }
        } catch (error) {
            // Nothing to do: the caller's own state is already updated, and the
            // only loss is carry-over to the next checkout step.
        }
        return merged;
    };

    /*
     * The BILLING company's own storage key (TWO-25326 review round 3).
     *
     * The key above is the SHIPPING company's, and until now it was the only
     * one — so the payment tile and the address step both merged into it. That
     * is a data-corruption bug rather than an inconvenience: this checkout can
     * legitimately hold two different companies at once, because unticking
     * "billing same as shipping" lets the buyer name a different billing
     * company, and one record cannot describe both. Every symptom rounds 2 and
     * 3 chased — a tile pick overwriting the address step's number, an untick
     * clearing the shipping company for good, `init()` restoring a pair that
     * contradicted the field beside it — was a guess at which company a given
     * read belonged to. With two keys there is nothing to guess.
     *
     * Same store-view scoping and same empty-key-means-no-storage contract as
     * the shipping key; see the note above for why '' must not become a shared
     * store-less bucket.
     */
    window.TWO_GATEWAY_BILLING_COMPANY_KEY = window.TWO_GATEWAY_BILLING_COMPANY_KEY
        || (window.TWO_GATEWAY_COMPANY_SELECTION_STORE
            ? 'billing_company_selection:' + window.TWO_GATEWAY_COMPANY_SELECTION_STORE
            : '');

    /**
     * Read the current store view's BILLING company selection.
     *
     * Guarded exactly as the shipping read is, and for the same reason: this
     * runs inside the handlers that go on to register Alpine components, so
     * anything thrown here leaves a dead checkout step.
     *
     * @returns {Object} the stored blob, or {} when absent or unparseable
     */
    window.twoGatewayReadBillingCompany = window.twoGatewayReadBillingCompany || function() {
        try {
            const key = window.TWO_GATEWAY_BILLING_COMPANY_KEY;
            if (!key) {
                return {};
            }
            const parsed = JSON.parse(hyva.getBrowserStorage().getItem(key) || '{}');
            return (parsed && typeof parsed === 'object' && !Array.isArray(parsed))
                ? parsed
                : {};
        } catch (error) {
            return {};
        }
    };

    /**
     * Merge `patch` into the current store view's BILLING company selection.
     *
     * Written ONLY by the payment tile. The address step must never reach this
     * key — it captures the shipping company, and the whole point of the split
     * is that the two records cannot overwrite one another.
     *
     * @param {Object} patch keys to overwrite; everything else is preserved
     * @returns {Object} the merged blob as written
     */
    window.twoGatewayWriteBillingCompany = window.twoGatewayWriteBillingCompany || function(patch) {
        const merged = Object.assign({}, window.twoGatewayReadBillingCompany(), patch || {});
        try {
            const key = window.TWO_GATEWAY_BILLING_COMPANY_KEY;
            if (key) {
                hyva.getBrowserStorage().setItem(key, JSON.stringify(merged));
            }
        } catch (error) {
            // Same as the shipping write: the caller's own state is already
            // updated and the only loss is carry-over between steps.
        }
        return merged;
    };

    /**
     * Drop the BILLING company record entirely.
     *
     * A removal, not a write of empty strings. An empty-but-present blob is
     * indistinguishable from "the buyer deliberately cleared the billing
     * company", and the tile's fallback-to-shipping rule keys on the record
     * being ABSENT — so writing blanks here would permanently suppress the
     * fallback for the rest of the checkout.
     *
     * @returns {void}
     */
    window.twoGatewayClearBillingCompany = window.twoGatewayClearBillingCompany || function() {
        try {
            const key = window.TWO_GATEWAY_BILLING_COMPANY_KEY;
            if (key) {
                hyva.getBrowserStorage().removeItem(key);
            }
        } catch (error) {
            // Nothing to do; the caller has already cleared its own state.
        }
    };

    /**
     * Is the buyer's billing address the shipping address?
     *
     * Hoisted here from company-name-payment.phtml (review round 3) so the
     * surfaces that depend on it cannot answer it differently — three of them
     * since TWO-25461, which added twoGatewayInvoiceRoleCountryField(). Defaults to
     * TRUE when the checkbox is absent, which is the pre-existing behaviour and
     * the safe direction: on a checkout with no such toggle there is only one
     * address, so the shipping company IS the billing company.
     *
     * @returns {boolean}
     */
    window.twoGatewayIsBillingAsShipping = window.twoGatewayIsBillingAsShipping || function() {
        const checkbox = document.querySelector('#billing-as-shipping');
        return checkbox ? checkbox.checked : true;
    };

    /**
     * Is this country field one the buyer can actually have used?
     *
     * Review round 1 on the 2026-08-06 batch: broadening the lookup to
     * `country_id` BY NAME also picks up fields the buyer has never seen — a
     * logged-in checkout's address-book "add address" form is in the DOM with
     * its country select pre-selected to the store's own country, so an
     * unfiltered lookup would let that hidden field outrank the quote's real
     * shipping country and re-enter the very bug this batch fixes, from a field
     * nobody touched.
     *
     * `disabled` and hidden-ness only. Deliberately NOT `offsetParent === null`,
     * the usual idiom: `x-show` hides with an inline `display: none`, this
     * codebase also hides with the `hidden` class, `offsetParent` answers null
     * for a `position: fixed` element that IS visible, and it is unimplemented
     * in jsdom — so a test written against it would pass while proving nothing.
     *
     * `disabled` is tested on every ANCESTOR too, not only the field: a
     * `<fieldset disabled>` disables everything inside it without setting the
     * attribute on any of them (review round 2), and Hyvä's forms do disable
     * fieldsets while a step is saving.
     *
     * Applied ONLY to fields matched by NAME — see twoGatewayCountryFields()
     * for why the two known ids are exempt.
     *
     * @param {HTMLElement} field
     * @returns {boolean}
     */
    window.twoGatewayCountryFieldUsable = window.twoGatewayCountryFieldUsable || function(field) {
        if (!field) return false;
        /*
         * A `type="hidden"` input is the one kind of hidden this walk cannot see
         * (review round 5): `hidden` is false on it, its inline `display` is
         * empty, and the three checks below all pass — so a hidden MIRROR of a
         * chosen country, which is exactly a field the buyer never saw, would
         * have outranked the quote's real shipping country. Tested on the field
         * itself only; an ancestor cannot be a hidden input.
         */
        if (field.tagName === 'INPUT' && field.type === 'hidden') return false;
        let node = field;
        while (node && node.style) {
            if (node.disabled) return false;
            if (node.style.display === 'none') return false;
            if (node.hidden) return false;
            if (node.classList && node.classList.contains('hidden')) return false;
            node = node.parentElement;
        }
        return true;
    };

    /**
     * Every country selector the buyer could have chosen a country in, in
     * priority order: the two ids Hyvä's own address forms use, then any
     * `country_id` field regardless of the id shape.
     *
     * SCOPED TO ONE FORM WHEN THE CALLER HAS ONE (TWO-25461). `context` is any
     * element belonging to the control that is asking — its own root, or a
     * country field it has already resolved by role. The document-wide,
     * shipping-before-billing list below is what answers for a caller with no
     * form of its own, and only for such a caller: a control mounted in the
     * INVOICE address form asking a document-global resolver got the SHIPPING
     * country, because the resolver had no way to know which form it was inside.
     * The company-search field renderer is registered globally on
     * `entity-form.field-renderers`, so it mounts on whichever address forms the
     * checkout renders and that mis-read is reachable on any checkout with two
     * addresses in different countries.
     *
     * The name-based selectors are not decoration (2026-08-06). The two exact
     * ids only exist while an address FORM is on screen and named the way the
     * checkout's shipping/billing namespaces name it; an address form rendered
     * under any other namespace — a modal, an address-book "add address" form,
     * a brand's own form component — has the same `country_id` field under a
     * different id, and reading only the two ids silently missed it and fell
     * through to the quote.
     *
     * THE VISIBILITY FILTER APPLIES ONLY TO THE NAME MATCHES (review round 2).
     * The two known ids were read unconditionally by every version of this
     * helper before this batch, and this checkout does hide a step's form
     * subtree rather than unmounting it in at least some states — so filtering
     * them would change behaviour that was already correct, in the direction of
     * the wrong-country bug this batch exists to close, on a surface no test
     * here can see. Whether that state is reachable is a question about a
     * closed-source theme, and the honest answer to a question like that is to
     * not move the thing that already worked. The filter therefore covers
     * exactly what this batch ADDED: fields found by name, none of which any
     * previous version consulted, where a hidden pre-filled address-book form
     * is a known and reachable false positive.
     *
     * Built by hand rather than as one `querySelectorAll` because that returns
     * DOCUMENT order, not selector order: the historical priority is shipping
     * BEFORE billing whatever order the two forms happen to render in, and a
     * single query would have quietly handed that decision to the theme.
     *
     * @param {HTMLElement} [context] an element belonging to the control that is
     *   asking. Its own address form answers when it has one; otherwise the
     *   document-wide list does.
     * @returns {Array<HTMLElement>}
     */
    window.twoGatewayCountryFields = window.twoGatewayCountryFields || function(context) {
        const scope = window.twoGatewayCountryFieldScope(context);
        return window.twoGatewayCountryFieldsWithin(scope);
    };

    /**
     * The country fields inside `scope` — or the whole document when `scope` is
     * null — in the same priority order and under the same filtering rule as
     * ever: the two known ids unfiltered (see the note above on why), name
     * matches filtered.
     *
     * `scope` may BE a country field rather than contain one: that is how the
     * payment tile names the invoice-role address field it wants read, having
     * resolved it by role rather than by position in the DOM.
     *
     * @param {HTMLElement|null} scope
     * @returns {Array<HTMLElement>}
     */
    window.twoGatewayCountryFieldsWithin = window.twoGatewayCountryFieldsWithin || function(scope) {
        // A country field found BY NAME, in either shape an address form
        // namespaces it under. Local to this function rather than a global or a
        // file-scope const: nothing outside consumes it, and this inline block is
        // re-evaluated (by a second payment method's render, and by every Jest
        // suite that loads the template twice) — where a top-level `const` throws
        // on redeclaration, which is why every published name here is
        // `window.X = window.X || …`.
        const NAME_SELECTOR = '[name="country_id"], [name$="[country_id]"]';
        const fields = [];
        const push = (el, filtered) => {
            if (!el || fields.indexOf(el) !== -1) return;
            if (filtered && !window.twoGatewayCountryFieldUsable(el)) return;
            fields.push(el);
        };
        const root = scope || document;
        if (scope) {
            if (scope.id === 'shipping-country_id' || scope.id === 'billing-country_id') {
                push(scope, false);
            } else if (scope.matches && scope.matches(NAME_SELECTOR)) {
                push(scope, true);
            }
        }
        push(root.querySelector('#shipping-country_id'), false);
        push(root.querySelector('#billing-country_id'), false);
        Array.prototype.forEach.call(
            root.querySelectorAll(NAME_SELECTOR),
            (el) => push(el, true)
        );
        return fields;
    };

    /**
     * Which form owns `context`'s country — the nearest ancestor (or `context`
     * itself) that has a country field of its own. `null` means the caller has
     * no address form of its own to read, and the document-wide list answers.
     *
     * The walk stops at a `<form>` that has no country field the list would
     * return — which is how the address-book modal exits it while closed. It also
     * guards a case no surface reaches today: a by-root caller inside some other
     * country-less form would otherwise climb out of it into whatever container
     * holds the address forms too, and be handed a "scope" that is the whole
     * checkout — the document-wide list by another name and by accident.
     *
     * Scope-hood asks for a field the list would actually return, so it inherits
     * that list's filtering EXACTLY — name matches filtered, the two known ids
     * not. A form whose only country field is a hidden NAME match is therefore
     * not a scope and its caller falls through to the document-wide list, which
     * is what the address-book modal is while it is closed. A form holding one of
     * the two KNOWN ids IS a scope even hidden, deliberately: those ids have been
     * read unconditionally by every version of this helper, this checkout hides a
     * step's form subtree rather than unmounting it, and refusing them here would
     * move already-correct behaviour on a surface no test can see. Filter what
     * you ADD.
     *
     * @param {HTMLElement} [context]
     * @returns {HTMLElement|null}
     */
    window.twoGatewayCountryFieldScope = window.twoGatewayCountryFieldScope || function(context) {
        let node = context && context.nodeType === 1 ? context : null;
        while (node) {
            /*
             * `<body>` is tested BEFORE asking whether it holds a country field,
             * and it very often does. Answering "the whole body is your scope"
             * is the document-wide list under another name, reached by accident
             * — the same thing this walk's `<form>` boundary exists to refuse.
             * Saying null says it deliberately.
             */
            if (node.tagName === 'BODY' || node.tagName === 'HTML') return null;
            if (window.twoGatewayCountryFieldsWithin(node).length) return node;
            if (node.tagName === 'FORM') return null;
            node = node.parentElement;
        }
        return null;
    };

    /**
     * The country field of the address in the INVOICE role, for a caller that is
     * not mounted in an address form at all — the payment tile (porting guide
     * §1(a.3)).
     *
     * The tile's company IS the invoice-role company: it reads and writes the
     * BILLING company record. So the country it must search in is the billing
     * address's, which is the shipping address only while the buyer has said the
     * two are the same. Reading `#shipping-country_id` unconditionally, which is
     * what a document-global shipping-first lookup did, was correct only by
     * coincidence of that checkbox's default.
     *
     * `null` when the field is not on the page — a checkout whose billing form
     * has not been rendered yet, or one that namespaces its ids differently —
     * and the document-wide list answers, as before.
     *
     * @returns {HTMLElement|null}
     */
    window.twoGatewayInvoiceRoleCountryField = window.twoGatewayInvoiceRoleCountryField || function() {
        return document.getElementById(
            window.twoGatewayIsBillingAsShipping() ? 'shipping-country_id' : 'billing-country_id'
        );
    };

    /**
     * Is there a country SELECTOR on the page at all — i.e. somewhere the
     * buyer picks their country themselves?
     *
     * `select` only. A hidden input mirroring a chosen country is not a
     * selector, and the question this answers is whether the store leaves the
     * country to the buyer.
     *
     * Reads the same list, so it inherits the same filtering: NAME matches only
     * (review round 2). A name-matched select the buyer cannot reach does not
     * count — suppressing the store default on the strength of one leaves
     * company search saying "Please select a country first" with nothing on
     * screen to satisfy it, a dead end where the store default would merely have
     * been a guess. A hidden select under one of the two KNOWN ids does still
     * count, and should: that is the checkout's own address form with its step
     * currently off screen — the buyer's country selector one step away, not an
     * absent one.
     *
     * DELIBERATELY NOT SCOPED to the calling form (TWO-25461), unlike the field
     * read it guards. "Does the buyer get to pick their country" is a property of
     * the STORE, not of one form — and the direction the two answers differ in is
     * the dangerous one: a form whose own country field is not a `<select>`, on a
     * store where other forms have one, would stop suppressing the store default
     * and go back to silently searching the store's country. Scoping this would
     * reintroduce the bug the suppression exists to prevent, so the question stays
     * exactly as document-wide as it was.
     *
     * @returns {boolean}
     */
    window.twoGatewayHasCountrySelector = window.twoGatewayHasCountrySelector || function() {
        return window.twoGatewayCountryFields().some(function(field) {
            return field.tagName === 'SELECT';
        });
    };

    /**
     * Every field the default→non-default mirror can write, for ONE address role.
     *
     * TWO-25461 §2.5. The set is not "the fields we happen to sync today": it is
     * every field a mirrored write could land in, because the pin below asks
     * whether the BUYER has edited this address and a buyer typing into address
     * line 2 says that exactly as loudly as one retyping the company. The
     * previous model tracked company name/id alone, so an address the buyer had
     * genuinely made their own — different region, different second line — went
     * on being overwritten from the default one.
     *
     * Resolved by Hyvä's own `<role>-<field>` id convention, the same one
     * `twoGatewayCountryFields()` reads `shipping-country_id` /
     * `billing-country_id` by. `region` is two candidate fields, not one: an
     * address format with a known region list renders a `region_id` select and
     * one without renders a free-text `region`, and which of the two a country
     * gets is the country's business.
     *
     * A key whose field is absent is OMITTED, not recorded empty — "this form
     * has no such field" and "the buyer left it blank" are different facts and
     * the pin treats them differently.
     *
     * Kept as five keys rather than trimmed to the two that matter most on
     * today's checkouts. `company_name`/`company_id` are the ones that can
     * ALWAYS produce a mismatch here — `twoGatewayIsBillingAddressPinned()`
     * backfills both from stored selection when the DOM field is absent, so
     * they compare even in the company-search-in-tile configuration where
     * neither address form carries a company field at all. `country`/
     * `street2`/`region` have no such backfill: they only compare when a
     * separate billing address FORM is actually rendered (billing-as-shipping
     * unticked) with Hyvä's own `<role>-<field>` ids, which this repo cannot
     * independently verify — Hyvä Checkout's own address markup is
     * closed-source and not installed anywhere testable from here. Dropping
     * them to simplify would be betting on an unverified absence; keeping
     * them costs nothing when they are absent and catches a real edit when
     * they are not.
     *
     * @param {string} role 'shipping' or 'billing'
     * @returns {Object} tracked key → current trimmed value
     */
    window.twoGatewayAddressMirrorFields = window.twoGatewayAddressMirrorFields || function(role) {
        const snapshot = {};
        const pick = function(key, ids) {
            for (let i = 0; i < ids.length; i++) {
                const el = document.getElementById(role + '-' + ids[i]);
                if (!el) continue;
                /*
                 * A field the buyer could not have reached cannot be evidence
                 * that they edited it, and this is the question
                 * twoGatewayCountryFieldUsable() already answers — disabled
                 * anywhere up the tree, or hidden by any of the three idioms
                 * this checkout uses. Reused rather than reimplemented.
                 *
                 * This is NOT the rule that says the two known country ids are
                 * read unfiltered. That rule is about the country RESOLVER's
                 * priority list, where filtering a hidden step's form would
                 * lose a country the buyer really did choose. Here the filter
                 * is the load-bearing part: it is what makes collapsing to one
                 * address resume the sync (§2.4), because a billing form the
                 * checkout has hidden stops holding the buyer's edits against
                 * them.
                 */
                if (!window.twoGatewayCountryFieldUsable(el)) continue;
                snapshot[key] = String(el.value || '').trim();
                return;
            }
        };
        pick('country', ['country_id']);
        pick('company_name', ['company']);
        pick('company_id', ['company_id']);
        // Line 2 only. Line 1 is not a mirrored field: nothing propagates a
        // street address between the two forms, so it cannot pin.
        pick('street2', ['street1']);
        pick('region', ['region_id', 'region']);
        return snapshot;
    };

    /**
     * Has the buyer made the BILLING address their own — i.e. is it pinned?
     *
     * TWO-25461 §2.3/§2.4. This replaces a record-existence test (was: "a
     * billing company record exists at all"), and the difference is the whole
     * point. Record existence latched: the first billing write ever made
     * stopped the sync for the rest of the checkout, with nothing that could
     * ever restart it. This is a pure CONTENT MATCH, recomputed at every read,
     * so it un-pins by itself the moment the two addresses agree again —
     * which is what makes "collapse to one address and reopen" resume the sync
     * with no resume control to press (§2.4 rejected building one).
     *
     * Two rules that look like details and are not:
     *
     * WHOLE-ADDRESS GRANULARITY. One field differing pins the WHOLE address,
     * including the fields the buyer never touched. Explicit ruling, not an
     * approximation of a per-field pin: a buyer who has corrected the region on
     * their billing address is telling us this address is theirs, and
     * overwriting its company from the shipping one because *that* field still
     * matched is the bug, not the safe half of it.
     *
     * AN EMPTY TARGET FIELD IS NOT A MISMATCH. It is a field waiting to be
     * filled, and the mirror filling it is the propagation §2.2 asks for.
     * Counting blank-vs-populated as a difference would pin every freshly
     * opened billing form on the spot and mean nothing ever propagated at all.
     * The cost is that a field the buyer deliberately CLEARED reads as
     * unedited; that is the safe direction, and the direction the whole-address
     * rule mostly covers anyway, since clearing one field of an address they
     * are working in rarely leaves the other four matching.
     *
     * Trimmed and case-insensitive, per §2.3 — the buyer retyping their own
     * company with different capitalisation has not made a different address.
     *
     * @returns {boolean} true when the billing address must not be overwritten
     */
    window.twoGatewayIsBillingAddressPinned = window.twoGatewayIsBillingAddressPinned || function() {
        const source = window.twoGatewayAddressMirrorFields('shipping');
        const target = window.twoGatewayAddressMirrorFields('billing');

        /*
         * The shipping ADDRESS FORM does not always carry the company pair:
         * with company search mounted in the payment tile it has no company
         * field at all. The mirror still has a company to write in that
         * configuration — it writes the stored shipping selection — so the
         * comparison has to see the same value the mirror would use, or a
         * billing company the buyer typed would be compared against nothing
         * and read as unedited.
         *
         * Filled only where the form left a gap. A rendered field is the
         * fresher of the two by definition: it is what the buyer is looking at.
         */
        const fillCompanyGaps = function(snapshot, record) {
            ['company_name', 'company_id'].forEach(function(key) {
                if (Object.prototype.hasOwnProperty.call(snapshot, key)) return;
                if (!record[key]) return;
                snapshot[key] = String(record[key]).trim();
            });
        };
        fillCompanyGaps(source, window.twoGatewayReadCompanySelection());
        /*
         * And the same substitution on the TARGET side, for the same reason and
         * with more at stake. A company the buyer picked ON THE PAYMENT TILE is
         * an edit of the billing role — the strongest one there is, since they
         * named it while looking at the billing step — but it lands in the
         * billing RECORD, not in an address-form field, and in the tile
         * configuration there is no billing company field for it to land in.
         * Reading only the form would make that pick invisible to the pin, and
         * the shipping company would overwrite it on the next Magewire
         * re-render. That precise bug is what the two-key split was introduced
         * to fix; the pin has to keep it fixed.
         *
         * It is not a latch: the record is REMOVED when the buyer collapses
         * back to one address (see the billing-as-shipping handler in
         * company-name-payment.phtml), which is what leaves the pin nothing to
         * hold and resumes the sync.
         */
        fillCompanyGaps(target, window.twoGatewayReadBillingCompany());
        const normalise = function(value) {
            return String(value === undefined ? '' : value).trim().toLowerCase();
        };
        return Object.keys(target).some(function(key) {
            const current = normalise(target[key]);
            // Nothing there to protect, and nothing to compare against: in
            // either case the mirror may write.
            if (!current) return false;
            if (!Object.prototype.hasOwnProperty.call(source, key)) return false;
            return current !== normalise(source[key]);
        });
    };

    /**
     * Global helper to get country code from multiple sources with fallbacks.
     *
     * Fallback order:
     * 1. The buyer's own country selection, live out of the DOM (see
     *    twoGatewayCountryFields() for which elements and in what order)
     * 2. Shipping address country from quote
     * 3. Billing address country from quote
     * 4. Legacy country_id from quote (backward compatibility)
     * 5. Store's default country — ONLY on a checkout with no country
     *    selector at all
     *
     * WHY THE STORE DEFAULT IS CONDITIONAL (2026-08-06). It was the
     * unconditional last resort, and that is what produced the reported bug:
     * company search returning US companies on the first visit to a checkout
     * whose buyer had selected a different country, then correcting itself the
     * moment they changed the country. Both halves are this fallback. The quote
     * snapshot is rendered by PHP at page load, so on a first visit — before
     * any address has been saved — it carries no country at all and the store
     * default (US, for the brand this was found on) answered instead; changing
     * the country afterwards puts a value in the DOM field, which outranks it,
     * so the symptom looked like a country-change handler that worked and a
     * first mount that did not.
     *
     * Searching the wrong country is worse than not searching: the buyer is
     * shown a list of real companies that are not theirs, with no indication
     * the country is wrong. So where the buyer HAS a country selector and has
     * not yet chosen, this answers '' and the callers show "Please select a
     * country first" — the existing, already-wired behaviour for no country.
     * The fallback is preserved exactly where its own comment always said it
     * was for: a checkout with no country selector, where the store default is
     * the only answer there is.
     *
     * THE QUOTE TERMS ARE NOT SCOPED, only the live DOM read above them
     * (TWO-25461). They are a page-load snapshot of saved addresses, and
     * re-ordering them per calling form would change what a checkout with no
     * country field on screen answers — a different question, on a surface no
     * test here can see, from the one this scoping fixes. A form whose own
     * country field is present but empty therefore still falls through to the
     * quote's shipping country: it is not that form's country, but it is not
     * another LIVE form's either, and it is what every version of this helper
     * has answered.
     *
     * @param {Object} quoteData - Quote details object from PHP
     * @param {HTMLElement} [context] see twoGatewayCountryFields()
     * @returns {string} Country code or empty string
     */
    window.twoGatewayGetCountryCode = window.twoGatewayGetCountryCode || function(quoteData, context) {
        const fields = window.twoGatewayCountryFields(context);
        for (let i = 0; i < fields.length; i++) {
            // `.value` and not `getAttribute('value')`: on a `<select>` the
            // attribute does not exist, and on an input it holds the
            // server-rendered default rather than what the buyer changed it to.
            if (fields[i].value) return fields[i].value;
        }

        return quoteData?.shipping_country_id ||
               quoteData?.billing_country_id ||
               quoteData?.country_id ||
               (window.twoGatewayHasCountrySelector() ? '' : quoteData?.default_country_id) ||
               '';
    };

    /**
     * Client-side ceiling for every company-search / company-detail request.
     *
     * 30s deliberately sits OUTSIDE the checkout API's own retry envelope
     * (`stop_after_delay(10)`), so the client never abandons a request the
     * server is still legitimately retrying — while still bounding the
     * browser default of "hang until the socket dies".
     */
    window.TWO_GATEWAY_COMPANY_SEARCH_TIMEOUT_MS = 30000;

    /**
     * Fallback config for a helper reached without one; else it builds a host-less relative URL that 404s as "no addresses".
     */
    window.TWO_GATEWAY_DIRECT_CALL_CONFIG = window.TWO_GATEWAY_DIRECT_CALL_CONFIG || {
        checkoutApiUrl: '<?= $escaper->escapeJs($checkoutApiUrl) ?>',
        client: '<?= $escaper->escapeJs((string) $clientName) ?>',
        clientV: '<?= $escaper->escapeJs((string) $clientVersion) ?>',
        merchant: '<?= $escaper->escapeJs($merchantName) ?>',
    };

    /**
     * Search-result cache, shared by all three Hyvä company pickers (the
     * address-form field, the shipping-step component and the payment-step
     * component). Deliberately hung off `window` rather than held in Alpine
     * component state: Magewire re-renders destroy and rebuild those
     * components, and a component-owned cache would be discarded exactly
     * when re-issuing searches hurts most. Keyed by request URL on the direct
     * path; by `search|<country>|<query>` on the proxy path, which has no URL
     * — no limit there, the server owns paging.
     *
     * Entries never expire, and because the cache is window-scoped it also
     * survives every Magewire re-render for the life of the page — so a
     * company registered mid-session stays absent from an already-searched
     * term until the buyer reloads. Deliberate, not a bug: buyers search for
     * their own company, which is already registered, so a TTL would spend
     * API calls on a case that essentially never happens.
     */
    window.twoGatewayCompanySearchCache = window.twoGatewayCompanySearchCache || new Map();

    /**
     * Is this response the API telling us it could not answer properly?
     *
     * The API returns HTTP 200 with near-empty results when its upstream
     * provider timed out, flagged as `degraded: true`. Read defensively with
     * a strict identity check: the field may not be deployed yet, and an
     * absent or truthy-but-not-true value must mean "not degraded" so
     * today's healthy responses keep working unchanged.
     *
     * @param {Object} response - parsed search response
     * @returns {boolean}
     */
    window.twoGatewayIsDegradedResponse = window.twoGatewayIsDegradedResponse || function(response) {
        return Boolean(response) && response.degraded === true;
    };

    /**
     * The ONE decision about whether an organisation number may be SHOWN.
     *
     * A company that has no number in its home registry is given an INTERNAL
     * placeholder identifier, recognisable by a literal `TWO:` prefix. It is a
     * real identifier as far as every API call is concerned — it is what
     * `payment[company_id]` submits and what the order-intent request carries —
     * but it is meaningless to a buyer, who reads it as a registry number their
     * company does not have. It must therefore never reach the screen.
     *
     * Every display site funnels through here rather than testing the prefix
     * itself: the results rows, the address step's number display, the payment
     * tile's `<name> (<number>)` label, and both intent notices. Four separate
     * prefix checks is how one of them silently stops agreeing with the others.
     *
     * Returns '' for anything that must not be shown, so a caller can treat
     * "nothing to show" and "no number at all" as the same case — which is what
     * makes the surrounding parentheses disappear as a unit instead of
     * rendering `Example Ltd ()`.
     *
     * @param {*} value the raw identifier
     * @returns {string} the identifier to display, or '' when there is none
     */
    window.twoGatewayDisplayCompanyNumber = window.twoGatewayDisplayCompanyNumber || function(value) {
        const raw = typeof value === 'string' ? value.trim() : '';
        if (!raw) return '';
        // Case-sensitive on purpose: the prefix is minted by us, always in this
        // exact form, and a case-insensitive test would also swallow a genuine
        // registry number that happened to start with the same three letters.
        if (raw.indexOf('TWO:') === 0) return '';
        return raw;
    };

    /**
     * Unwrap a proxy `{ok, status, body}` — a one-element array on some Magento serialisation paths, a string on others.
     * @param {*} raw
     * @returns {{ok: boolean, status: number, body: *}}
     */
    window.twoGatewayUnwrapProxyResponse = window.twoGatewayUnwrapProxyResponse || function(raw) {
        const first = Array.isArray(raw) ? raw[0] : raw;
        let parsed = first;
        if (typeof first === 'string') {
            try {
                parsed = JSON.parse(first);
            } catch (error) {
                return { ok: false, status: 0, body: null };
            }
        }
        if (!parsed || typeof parsed !== 'object') return { ok: false, status: 0, body: null };
        // Identity, not Boolean(): a truthy `"false"` would read as "no matches".
        return { ok: parsed.ok === true, status: parsed.status || 0, body: parsed.body };
    };

    /**
     * POST to a plugin proxy route; the base module owns paths, bodies, envelope.
     * @param {string} restBaseUrl Magento link base URL, no trailing slash
     * @param {string} path route path, leading slash
     * @param {Object} body
     * @param {AbortSignal} [signal]
     * @returns {Promise<{ok: boolean, status: number, body: *}>}
     */
    window.twoGatewayProxyPost = window.twoGatewayProxyPost || async function(restBaseUrl, path, body, signal) {
        const response = await fetch(restBaseUrl + path, {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: signal,
        });
        if (!response.ok) {
            // Stale webapi route cache, not "base too old"; no fallback, which would hide the missed flush.
            if (response.status === 404) {
                console.warn(
                    'Two: proxy route ' + path + ' is unregistered despite the base module '
                    + 'exposing it — run setup:upgrade and cache:flush on the store.'
                );
            }
            throw new Error('Error response from ' + path + ': ' + response.status);
        }
        return window.twoGatewayUnwrapProxyResponse(await response.json());
    };

    /**
     * Run one company search with a timeout, a cache and a failure signal
     * the buyer can actually see.
     *
     * Returns a discriminated result rather than throwing, because the three
     * outcomes need three different UIs and the previous code collapsed all
     * of them into `items = []` — pixel-identical to "no companies matched",
     * which is how a buyer with a valid company concludes the shop won't
     * take them.
     *
     *   { status: 'ok',        items }  render the results
     *   { status: 'empty',     items }  render "no matches"
     *   { status: 'degraded',  items }  render results AND the unavailable notice
     *   { status: 'failed',    items }  render the unavailable notice
     *   { status: 'aborted',   items }  render NOTHING — superseded or torn down
     *
     * @param {Object} options
     * @param {boolean} options.useProxy read by identity here and at the other three
     *   proxy-selection sites, so anything but `true` takes the deprecated direct
     *   fallback — see CheckoutConfig::getIsProxyAvailable().
     * @param {string} options.restBaseUrl Magento link base URL, no trailing slash
     * @param {string} options.checkoutApiUrl fallback path only
     * @param {string} options.countryCode
     * @param {string} options.query
     * @param {number|string} [options.limit] fallback path only
     * @param {string} [options.client] fallback path only
     * @param {string} [options.clientV] fallback path only
     * @param {string} [options.merchant] fallback path only
     * @param {AbortSignal} [options.signal] caller's abort signal
     * @returns {Promise<{status: string, items: Array}>}
     */
    window.twoGatewayCompanySearch = window.twoGatewayCompanySearch || async function(options) {
        const country = (options.countryCode || '').toUpperCase();
        const term = unescape(options.query);
        const useProxy = options.useProxy === true;
        const directUrl = useProxy ? '' : options.checkoutApiUrl + '/companies/v2/company?' + new URLSearchParams({
            country: country,
            limit: options.limit,
            offset: 0,
            q: term,
            client: options.client || '',
            client_v: options.clientV || '',
            merchant: options.merchant || '',
        });
        const cacheKey = useProxy ? 'search|' + country + '|' + term : directUrl;

        /*
         * `national_identifier` is OPTIONAL in the search response — the
         * company may have none in its home registry, internal identifier
         * types are stripped from the field, and the object itself may be
         * absent, null, or carry a null/empty `id`. (The field inside is
         * `id`, not `value`.)
         *
         * Reading it unguarded threw a TypeError on a legitimate hit, and a
         * throw here lands inside the dropdown's own query pipeline: it takes
         * the WHOLE result list down, not just this one hit, and leaves the
         * field stuck on "Searching…" with no error the buyer can act on.
         *
         * So render the company with whatever it has. The identifier is only
         * the buyer's disambiguator between two similarly-named companies;
         * dropping the hit instead would remove a company they then cannot
         * select at all. Without one they see the name alone, and selectItem()
         * hands them an empty, editable company-id field to type the
         * organisation number into themselves.
         *
         * `item` itself is NOT guarded. A null element in `items` would throw
         * on `item.name` in mapItems() one line below either way, so a guard
         * here would buy nothing but the appearance of one.
         *
         * `id != null` rather than a truthiness test: an identifier of `0` is
         * a value, not an absence. An empty-string `id` is treated as absent,
         * which is what it means.
         */
        const identifierOf = (item) =>
            item.national_identifier && item.national_identifier.id != null
                ? String(item.national_identifier.id)
                : '';

        const mapItems = (data) => ((data && data.items) || []).map(item => {
            const identifier = identifierOf(item);
            // `companyId` keeps the raw identifier — it is what the order and
            // the intent request carry — but the row a buyer READS shows only
            // what may be shown. An internal placeholder (`TWO:` prefix)
            // therefore renders as the name alone, brackets included, exactly
            // like a company with no identifier at all.
            const displayIdentifier = window.twoGatewayDisplayCompanyNumber(identifier);

            return {
                companyName: item.name,
                // The no-identifier branch stays a template literal rather
                // than a bare `item.highlight` so this field keeps being a
                // string in every branch: it is bound with `x-html`, where a
                // bare `undefined` would render the word "undefined" anyway,
                // and a caller reading `.length` off it would throw.
                companyDisplayName: displayIdentifier
                    ? `${item.highlight} (${displayIdentifier})`
                    : `${item.highlight}`,
                companyId: identifier,
                lookupId: item.lookup_id,
                item: item,
            };
        });

        const cached = window.twoGatewayCompanySearchCache.get(cacheKey);
        if (cached) {
            const items = mapItems(cached);
            return { status: items.length ? 'ok' : 'empty', items: items };
        }

        // Two signals: the caller's (next keystroke / teardown) and our own
        // timeout. Whichever fires first aborts the fetch. The catch below
        // tells them apart by asking the CALLER's signal whether it aborted,
        // not by inspecting the error — the error is an AbortError either
        // way, so a reason argument would be decoration. Ordering is safe:
        // once our timer calls abort(), the fetch rejection drains as a
        // microtask before any later task can abort the caller's signal.
        const controller = new AbortController();
        const timer = setTimeout(
            () => controller.abort(),
            window.TWO_GATEWAY_COMPANY_SEARCH_TIMEOUT_MS
        );
        const onCallerAbort = () => controller.abort();
        if (options.signal) {
            if (options.signal.aborted) {
                clearTimeout(timer);
                return { status: 'aborted', items: [] };
            }
            options.signal.addEventListener('abort', onCallerAbort);
        }

        try {
            let data;
            if (useProxy) {
                const envelope = await window.twoGatewayProxyPost(
                    options.restBaseUrl,
                    '/rest/V1/two/company-search',
                    { country: country, query: term },
                    controller.signal
                );
                if (!envelope.ok) throw new Error('Company search responded ' + envelope.status);
                data = envelope.body;
            } else {
                const response = await fetch(directUrl, { signal: controller.signal });
                if (!response.ok) throw new Error('Company search responded ' + response.status);
                data = await response.json();
            }
            const items = mapItems(data);

            if (window.twoGatewayIsDegradedResponse(data)) {
                // Never cache a degraded answer — it is a transient upstream
                // failure, and caching it would pin the buyer to an empty
                // result set for the rest of the session.
                return { status: 'degraded', items: items };
            }

            if (window.twoGatewayCompanySearchCache.size >= 50) {
                const oldest = window.twoGatewayCompanySearchCache.keys().next().value;
                window.twoGatewayCompanySearchCache.delete(oldest);
            }
            window.twoGatewayCompanySearchCache.set(cacheKey, data);

            return { status: items.length ? 'ok' : 'empty', items: items };
        } catch (error) {
            // A caller-driven abort is the buyer typing on, or the component
            // being torn down — expected, and silent by design. A timeout is
            // NOT an abort as far as the buyer is concerned and must be
            // reported as a failure.
            const isCallerAbort = options.signal && options.signal.aborted;
            if (isCallerAbort) return { status: 'aborted', items: [] };

            console.error('Error fetching companies:', error);
            return { status: 'failed', items: [] };
        } finally {
            clearTimeout(timer);
            if (options.signal) options.signal.removeEventListener('abort', onCallerAbort);
        }
    };

    /**
     * Fetch one company's detail record, with the same timeout.
     *
     * @param {string} restBaseUrl Magento link base URL, no trailing slash
     * @param {string} lookupId
     * @param {Object|null} [direct] fallback config, or exactly `null` for the
     *   proxy route — fail closed per twoGatewayCompanySearch's useProxy.
     * @returns {Promise<Object|null>} the record, or null on any failure
     */
    window.twoGatewayCompanyDetail = window.twoGatewayCompanyDetail || async function(restBaseUrl, lookupId, direct) {
        // A non-object third argument carries no host; the store's config avoids a relative URL that 404s as "no addresses".
        const useProxy = direct === null;
        let cfg = direct;
        if (!useProxy && typeof direct !== 'object') {
            console.warn(
                'Two: twoGatewayCompanyDetail is (restBaseUrl, lookupId, direct); '
                + 'it was called with no direct config, so the direct call falls '
                + "back to the store's own direct-call config."
            );
            cfg = window.TWO_GATEWAY_DIRECT_CALL_CONFIG || {};
        }
        const controller = new AbortController();
        // No reason argument: nothing reads it, and the sibling search helper
        // does not pass one either.
        const timer = setTimeout(
            () => controller.abort(),
            window.TWO_GATEWAY_COMPANY_SEARCH_TIMEOUT_MS
        );
        try {
            // Without these checks an error body parses as an address payload
            // and silently produces "no addresses".
            if (!useProxy) {
                const queryParams = new URLSearchParams({
                    client: cfg.client || '',
                    client_v: cfg.clientV || '',
                    merchant: cfg.merchant || '',
                });
                const response = await fetch(`${cfg.checkoutApiUrl || ''}/companies/v2/company/${lookupId}?${queryParams}`, {
                    signal: controller.signal,
                });
                if (!response.ok) throw new Error('Company detail responded ' + response.status);
                return await response.json();
            }
            const envelope = await window.twoGatewayProxyPost(
                restBaseUrl,
                '/rest/V1/two/company',
                { lookupId: lookupId },
                controller.signal
            );
            if (!envelope.ok) throw new Error('Company detail responded ' + envelope.status);
            return envelope.body;
        } catch (error) {
            console.error('Error fetching address:', error);
            return null;
        } finally {
            clearTimeout(timer);
        }
    };

    /**
     * The address form holding the INVOICE role, for a caller that is not
     * mounted in an address form at all — the payment tile.
     *
     * Resolved by walking up from that role's country field to the first
     * ancestor that also holds the address inputs `setAddressData()` writes,
     * so a checkout that nests its address fields differently still resolves.
     * `<body>` is refused for the same reason `twoGatewayCountryFieldScope()`
     * refuses it: the whole document is not a scope.
     *
     * @returns {HTMLElement|null}
     */
    window.twoGatewayInvoiceRoleAddressForm = window.twoGatewayInvoiceRoleAddressForm
        || function() {
        let node = window.twoGatewayInvoiceRoleCountryField();
        while (node) {
            if (node.tagName === 'BODY' || node.tagName === 'HTML') return null;
            if (node.querySelector('input[name="city"], input[name="postcode"], input[name="street[0]"]')) {
                return node;
            }
            node = node.parentElement;
        }
        return null;
    };

    /**
     * TWO-25326 rebuild: the ONE company-search implementation, mirroring
     * PrestaShop's `TwoCompanySearch` class. Every surface that offers
     * company search — the address step's field, the payment tile, and the
     * shipping/address-book field — is a thin adapter around THIS factory.
     * Nothing below is duplicated anywhere else in this module; a second
     * copy of any of this logic outside this function is a regression of
     * this rebuild, not a legitimate per-surface variation.
     *
     * What is genuinely per-surface (and therefore NOT here, by design) is
     * the DOM shape each surface submits and the business logic that reads
     * a captured company — the payment tile's dual-input id/name swap
     * between search- and manual-mode fields, its order-intent dispatch, and
     * the billing/shipping storage split. Those stay in each surface's own
     * wrapper as hook functions passed in `options`, because they are three
     * different FEATURES that happen to sit next to a search box, not three
     * copies of the search box itself. Folding them in here would be exactly
     * the "correct by accident" abstraction that produced several of the
     * bugs this file's comments already document.
     *
     * @param {Object} options
     * @param {string} options.checkoutApiUrl
     * @param {string} options.restBaseUrl Magento link base URL, no trailing slash
     * @param {number} options.minSearchChars
     * @param {boolean} options.isCompanySearchEnabled
     * @param {boolean} [options.isAddressSearchEnabled]
     * @param {boolean} [options.manualModeSupported=false] whether this surface
     *   offers a manual/search toggle at all (shipping does not: it has no
     *   markup of its own to hang a toggle link on — its visible input is
     *   rendered by Hyvä Checkout's own address-book form).
     * @param {boolean} [options.querySplit=false] set by
     *   `twoGatewayCaptureSurfaceMixin()`, so both surfaces that mount the
     *   control get it (TWO-25326 §1): the visible name field and the panel's
     *   own query box are different state, so a keystroke in the panel never
     *   overwrites the captured name until a result is picked. Only the
     *   address-book modal, which composes this engine directly, leaves it off.
     * @param {boolean} [options.editableCompanyId=false] whether this
     *   surface owns a company-number input whose lock state this engine
     *   should compute (address + tile; shipping has none).
     * @param {Function} [options.editableCompanyIdExtraUnlock] extra
     *   unlock term folded into the id-lock formula (address unlocks whenever
     *   search itself is switched off; tile has no such term because the tile
     *   only ever renders with search on).
     * @param {string} options.dropdownSelector CSS selector for the
     *   scrollable results container (adjustScroll()).
     * @param {string} options.itemSelector CSS selector for one result row.
     * @param {string} [options.countrySelectionMessage]
     * @param {string} [options.searchUnavailableMessage]
     * @param {Function} [options.dispatchSearchUnavailableToast=true] whether
     *   a failed/degraded search toasts `searchUnavailableMessage` itself
     *   (address + tile render their own inline notice instead — see
     *   `isSearchUnavailable` — and must not ALSO toast; shipping renders no
     *   notice of its own, so the toast is its only signal, exactly as
     *   before).
     * @param {Function} options.getQuote `() => quoteObject`, called with the
     *   component as `this`.
     * @param {Function} options.readSelection `() => storedBlob`
     * @param {Function} options.writeSelection `(patch) => mergedBlob`
     * @param {string} [options.selectEventName] custom event name dispatched
     *   after a pick or a manual commit, `detail` = the merged storage blob.
     * @param {Function} [options.resolveNameField] `() => HTMLInputElement|null`
     *   the field selectItem() and the manual commit read/write the
     *   captured name through. Defaults to `this.$el` (the field the search is bound to).
     * @param {Function} [options.onCompanyCommitted] `(companyName, companyId,
     *   source) => void`, called with the component as `this` after
     *   selectItem() or a manual-entry commit has updated state, written
     *   storage and dispatched the selection event — this is where a
     *   surface's own business logic (order-intent dispatch, dual-input
     *   id/name resolution refresh) hooks in.
     * @param {Function} [options.afterManualToggle] `(enteringManual) => void`
     *   focus-placement hook run after enterManually()/enableSearch() flips
     *   mode — each surface's manual-entry field is a different element.
     * @param {Function} [options.onLoaderStart] fired before a network search
     *   starts. Shipping uses it for its magewire loader; address and tile render
     *   their own in-field spinner off `isSearching` instead, and the TILE also
     *   uses it as the "a new search has begun" signal that takes its
     *   order-intent verdict off screen.
     * @param {Function} [options.onLoaderDone] sibling of onLoaderStart, fired
     *   exactly once per OWNING start — never for a search that was
     *   superseded, always for one that was aborted with no successor. See
     *   the loader-ownership note on shipping's own historical version of
     *   this comment; the invariant is unchanged, only its home is.
     * @returns {Object} the engine's own members, meant to be layered under a
     *   surface's own via `twoGatewayComposeLive(surfaceOwn, engine)` so a
     *   name the surface defines itself always wins.
     */
    window.twoGatewayCompanySearchEngine = window.twoGatewayCompanySearchEngine || function twoGatewayCompanySearchEngine(options) {
        const cfg = Object.assign({
            checkoutApiUrl: '',
            restBaseUrl: '',
            // Fail closed — see twoGatewayCompanySearch's useProxy.
            isProxyAvailable: false,
            client: '',
            clientV: '',
            merchant: '',
            companySearchLimit: 10,
            minSearchChars: 3,
            isCompanySearchEnabled: true,
            isAddressSearchEnabled: false,
            manualModeSupported: false,
            querySplit: false,
            editableCompanyId: false,
            editableCompanyIdExtraUnlock: function () { return false; },
            dropdownSelector: '.company-results',
            itemSelector: 'div.cursor-pointer',
            scopeItemLookupToRoot: false,
            countrySelectionMessage: '',
            searchUnavailableMessage: '',
            dispatchSearchUnavailableToast: false,
            getQuote: function () { return {}; },
            readSelection: function () { return {}; },
            writeSelection: function () { return {}; },
            resolveNameField: function () { return this.$el || null; },
            // Container `setAddressData()` writes city/postcode/street into,
            // resolved fresh per surface since none of the three agree on
            // where that container is relative to the search field. `null`
            // (the default) makes `addressLookup()`/`setAddressData()` safe
            // no-ops on a surface (the tile) that offers no address lookup.
            resolveAddressContainer: function () { return null; },
            addressContainerWarning: '',
            // Which form's country this surface reads, named by the surface
            // itself: its own root, a field it resolved by role, whatever
            // anchors it to one address form (see
            // twoGatewayCountryFieldScope()). `null` — the default, like
            // resolveAddressContainer's above — means "I have no address form of
            // my own", which resolves through the document-wide, shipping-first
            // list exactly as every caller did before this option existed.
            resolveCountryContext: function () { return null; },
            // null/'' disables the DOM CustomEvent dispatch entirely — the
            // payment tile has never dispatched one from selectItem() (its
            // own business logic runs off onCompanyCommitted instead), and
            // adding one it never had is a new event nothing on the tile's
            // surface is written to expect.
            selectEventName: null,
            onCompanyCommitted: function () {},
            afterManualToggle: function () {},
            // Fired whenever the engine tears the dropdown state down
            // (selectItem, enterManually, closeDropdown) — the address
            // step's query box is a SEPARATE uncontrolled DOM element (see
            // `querySplit`), so the engine clearing `this.query` alone does
            // not blank what is actually on screen; this hook is where a
            // surface with such an element clears it.
            onDropdownClear: function () {},
            onLoaderStart: function () {},
            onLoaderDone: function () {},
            // Checked right after a search resolves, before writing `items`.
            // Default true (nothing to check); the address step overrides it
            // to confirm `$root` is still connected — see the doc comment on
            // that surface's own options for why Magewire re-renders make
            // this necessary there and not elsewhere.
            searchStillValid: function () { return true; },
        }, options || {});

        return {
            // --- state ---
            // These are seeded from `options` but, unlike the rest of
            // `options`, are live INSTANCE properties rather than values
            // closed over in `cfg` — every historical surface exposed them
            // as plain mutable state (a lookup-off store flips
            // `isCompanySearchEnabled` at RUNTIME, and several suites mutate
            // it post-mount to simulate exactly that), so the engine's own
            // methods read `this.X` for these, never `cfg.X`.
            checkoutApiUrl: cfg.checkoutApiUrl,
            restBaseUrl: cfg.restBaseUrl,
            isProxyAvailable: cfg.isProxyAvailable,
            client: cfg.client,
            clientV: cfg.clientV,
            merchant: cfg.merchant,
            companySearchLimit: cfg.companySearchLimit,
            minSearchChars: cfg.minSearchChars,
            isCompanySearchEnabled: cfg.isCompanySearchEnabled,
            isAddressSearchEnabled: cfg.isAddressSearchEnabled,
            isOpen: false,
            search: '',
            query: '',
            items: [],
            selectedIndex: -1,
            isSearching: false,
            isSearchUnavailable: false,
            searchAbortController: null,
            countryCode: '',
            countrySelectionShown: false,
            // Latches a search-unavailable TOAST (`dispatchSearchUnavailableToast`)
            // to once per interaction — shipping's own historical state,
            // inert (never read) on a surface that renders its own inline
            // notice instead. Reset by `endSearchInteraction()`.
            searchUnavailableShown: false,
            manualMode: false,
            isCompanySelected: false,
            companyName: '',
            companyId: '',
            companyIdSource: '',
            companyIdEntryRequired: false,
            companyIdDisabled: true,
            searchCompletedFor: null,

            /** Cancel any in-flight company search. Safe to call repeatedly. */
            abortCompanySearch() {
                if (this.searchAbortController) {
                    this.searchAbortController.abort();
                    this.searchAbortController = null;
                }
                this.isSearching = false;
            },

            /**
             * Is there an identifier that something other than the buyer
             * vouched for? Only a registry hit can; a hand-typed number is the
             * buyer's own and stays theirs to correct.
             */
            hasVouchedCompanyId() {
                return Boolean(this.companyId) && this.companyIdSource === 'registry';
            },

            /**
             * Recompute the company-number field's locked state. One derived
             * state, one writer, shared by every surface that has such a
             * field. `editableCompanyIdExtraUnlock` is where the address
             * step's search-switched-off term lives without leaking into the
             * tile's formula, which has none.
             */
            applyCompanyIdEditability() {
                if (!cfg.editableCompanyId) return;
                this.companyIdDisabled = !(
                    cfg.editableCompanyIdExtraUnlock.call(this)
                    || this.manualMode
                    || this.companyIdEntryRequired
                );
            },

            /**
             * Drop a registry-supplied identifier that no longer belongs to
             * the name currently held, from state AND storage together — see
             * the address step's historical note on why both have to move as
             * one (the payment step derives its own editability from
             * `company_id` in the same blob).
             *
             * A CALLER MUST WRITE `this.search` FIRST. This compares it against
             * `companyName`, and `search` also carries what the popover repaints
             * the field from — so a caller that has not just set it can be
             * comparing against a DOM-seeded or stale value and drop a
             * registry-vouched identifier. `commitManualCompany()` is the only
             * caller today and does set it immediately before.
             */
            forgetStaleCompanyId() {
                if (!this.companyId) return;
                if (this.search === this.companyName) return;

                this.companyId = '';
                this.companyIdSource = '';
                this.companyIdEntryRequired = true;
                cfg.writeSelection.call(this, { company_id: '', company_id_source: '' });
            },

            /**
             * The buyer's country, resolved the ONE way (TWO-25461) — this is
             * the only place any surface's country comes from, and the only
             * thing that varies between surfaces is which form is asking.
             *
             * @param {Object} quoteData
             * @returns {string}
             */
            resolveCountryCode(quoteData) {
                return window.twoGatewayGetCountryCode(
                    quoteData,
                    cfg.resolveCountryContext.call(this)
                );
            },

            /**
             * Run a company search for `term` against the API, populating
             * `items` / `isSearching` / `isSearchUnavailable` / `countryCode`.
             * Cancels any prior in-flight search first (supersession) and is
             * itself safe to abandon mid-flight (a later call, or a teardown,
             * simply supersedes it).
             *
             * Callers own the min-chars gate and what `isOpen` should do
             * afterwards, because that differs by surface (auto-open on the
             * tile, no such term at all on the address step which opens on
             * click/keypress instead).
             *
             * @param {string} term
             * @returns {Promise<void>}
             */
            async runCompanySearch(term) {
                this.selectedIndex = -1;
                this.isSearchUnavailable = false;
                const quoteData = cfg.getQuote.call(this);
                this.countryCode = this.resolveCountryCode(quoteData);

                if (this.countryCode) this.countrySelectionShown = false;

                if (!this.countryCode) {
                    this.abortCompanySearch();
                    this.endSearchInteraction();
                    if (!this.countrySelectionShown && term.length >= this.minSearchChars) {
                        this.countrySelectionShown = true;
                        window.dispatchMessages([{
                            type: 'warning',
                            text: cfg.countrySelectionMessage,
                        }], 5000);
                    }
                    return;
                }
                this.countrySelectionShown = false;

                if (term.length < this.minSearchChars) {
                    this.abortCompanySearch();
                    this.endSearchInteraction();
                    this.items = [];
                    this.searchCompletedFor = null;
                    return;
                }

                this.abortCompanySearch();
                const controller = new AbortController();
                this.searchAbortController = controller;
                this.isSearching = true;
                cfg.onLoaderStart.call(this);

                let result;
                try {
                    result = await window.twoGatewayCompanySearch({
                        useProxy: this.isProxyAvailable,
                        restBaseUrl: this.restBaseUrl,
                        checkoutApiUrl: this.checkoutApiUrl,
                        countryCode: this.countryCode,
                        query: term,
                        limit: this.companySearchLimit,
                        client: this.client,
                        clientV: this.clientV,
                        merchant: this.merchant,
                        signal: controller.signal,
                    });
                } catch (error) {
                    console.error('Company search failed:', error);
                    result = { status: 'failed', items: [] };
                } finally {
                    // Loader-done fires exactly once per OWNING start: never
                    // for a search a newer one has already superseded, always
                    // for one aborted with no successor. `null` unambiguously
                    // means "nothing in flight" — abortCompanySearch() nulls
                    // it synchronously and a successor assigns it
                    // synchronously in the same task.
                    if (!this.searchAbortController || this.searchAbortController === controller) {
                        cfg.onLoaderDone.call(this);
                    }
                }

                if (result.status === 'aborted' || this.searchAbortController !== controller) return;

                // enterManually() (or equivalent) may have fired while this
                // was in flight — writing `items` now would leave a
                // populated result list behind the manual-entry fields.
                // `searchStillValid` is also where a surface bound to a
                // Magewire-rendered subtree (the address step) checks it has
                // not been torn down and rebuilt while the request was on
                // the wire; writing into a detached component is silently
                // inert on the page and leaves a dead copy holding state.
                if (this.manualMode || !cfg.searchStillValid.call(this)) {
                    this.searchAbortController = null;
                    this.isSearching = false;
                    return;
                }

                this.searchAbortController = null;
                this.isSearching = false;
                this.items = result.items;
                this.isSearchUnavailable = result.status === 'failed' || result.status === 'degraded';
                if (!this.isSearchUnavailable) {
                    this.searchCompletedFor = term;
                    // A good result ends the "unavailable" run, so the next
                    // failure toasts again rather than staying silenced by an
                    // earlier one.
                    this.searchUnavailableShown = false;
                } else if (cfg.dispatchSearchUnavailableToast && cfg.searchUnavailableMessage) {
                    // Latched once per interaction: the search is debounced
                    // per keystroke, so an unlatched toast would fire on
                    // every one of them while an API stays down.
                    if (!this.searchUnavailableShown) {
                        this.searchUnavailableShown = true;
                        // Guarded: this runs on a failure path whose whole point
                        // is surviving a missing global, so it must not become
                        // the thing that throws.
                        if (typeof window.dispatchMessages === 'function') {
                            window.dispatchMessages([{
                                type: 'warning',
                                text: cfg.searchUnavailableMessage,
                            }], 5000);
                        }
                    }
                }
            },

            /**
             * End of one search interaction: allow a latched
             * "unavailable" toast to fire again next time. No-op on a
             * surface that renders its own inline notice instead of a
             * toast (nothing reads `searchUnavailableShown` there).
             */
            endSearchInteraction() {
                this.searchUnavailableShown = false;
            },

            // --- keyboard navigation (identical across every surface) ---
            nextItem() {
                if (this.selectedIndex < this.items.length - 1) {
                    this.selectedIndex++;
                    this.adjustScroll();
                }
            },
            prevItem() {
                if (this.selectedIndex > 0) {
                    this.selectedIndex--;
                    this.adjustScroll();
                }
            },
            adjustScroll() {
                this.$nextTick(() => {
                    // Scoped to `$root` only where configured (the address
                    // step, which shares a page with other company-search
                    // instances — the shipping/address-book field in
                    // particular). The payment tile's own historical version
                    // of this method queried `document` unscoped; preserved
                    // exactly, not tightened, since this tile is the only
                    // one of its kind on any page it renders on.
                    const scope = (cfg.scopeItemLookupToRoot && this.$root) || document;
                    const dropdown = scope.querySelector(cfg.dropdownSelector);
                    const highlighted = scope.querySelectorAll(cfg.itemSelector)[this.selectedIndex];
                    if (dropdown && highlighted) {
                        const dropdownRect = dropdown.getBoundingClientRect();
                        const itemRect = highlighted.getBoundingClientRect();
                        if (itemRect.bottom > dropdownRect.bottom) {
                            dropdown.scrollTop += itemRect.bottom - dropdownRect.bottom;
                        } else if (itemRect.top < dropdownRect.top) {
                            dropdown.scrollTop -= dropdownRect.top - itemRect.top;
                        }
                    }
                });
            },
            handleItemClick(event) {
                const index = event.currentTarget.dataset.index;
                if (index !== undefined && this.items[index]) {
                    this.selectItem(this.items[index]);
                }
            },
            selectHighlightedItem() {
                if (this.selectedIndex >= 0 && this.items.length > 0 && this.items[this.selectedIndex]) {
                    this.selectItem(this.items[this.selectedIndex]);
                }
            },

            /**
             * The ONE pick path every surface funnels through. Clears dropdown
             * state, writes the captured pair into component state AND the
             * resolved name field, persists it, dispatches the selection
             * event, then hands off to `onCompanyCommitted` for whatever is
             * surface-specific about "a company was just captured" (order
             * intent, id/name field-pair resolution, address lookup).
             *
             * @param {{companyName: string, companyId?: string, lookupId?: string}} item
             */
            selectItem(item) {
                this.abortCompanySearch();
                this.endSearchInteraction();
                this.isSearchUnavailable = false;
                this.isOpen = false;
                this.items = [];
                this.selectedIndex = -1;
                this.query = '';
                this.searchCompletedFor = null;

                this.search = item.companyName;
                this.isCompanySelected = true;
                this.manualMode = false;

                this.companyName = item.companyName;
                this.companyId = item.companyId || '';
                this.companyIdSource = this.companyId ? 'registry' : '';
                this.companyIdEntryRequired = !this.hasVouchedCompanyId();
                this.applyCompanyIdEditability();

                /*
                 * The panel is dismissed AFTER the pick's own state is written,
                 * not before it (review round 5). `onDropdownClear` is a hook a
                 * SURFACE can chain onto — the payment tile does, to put back an
                 * order-intent verdict a search took down — and firing it while
                 * `companyName`/`companyId` still held the OUTGOING company meant
                 * every such hook evaluated the company the buyer was replacing.
                 * The tile's did exactly that, briefly painting the previous
                 * company's verdict over the new one. (The row is not at risk:
                 * refreshOrderIntentVerdict() never touches it — only
                 * setOrderIntentChecking() does — so the surviving symptom is the
                 * transient paint, not a lost progress row.)
                 *
                 * Ordering, not deferral, is the fix. A `$nextTick` here would
                 * paper over it, leave the wrong-company window open for anything
                 * running in between, and be untestable under a harness whose
                 * `$nextTick` is synchronous. Nothing between the old call site
                 * and this one touches the DOM or the query box, so moving it is
                 * inert for the engine's own use of the hook.
                 */
                cfg.onDropdownClear.call(this);

                const field = cfg.resolveNameField.call(this);
                if (field) {
                    field.value = item.companyName;
                    field.dispatchEvent(new Event('input', { bubbles: false }));
                }

                const selectionData = cfg.writeSelection.call(this, {
                    company_name: item.companyName,
                    company_id: item.companyId || '',
                    company_id_source: this.companyIdSource,
                    manual_mode: false,
                });

                if (cfg.selectEventName) {
                    window.dispatchEvent(new CustomEvent(cfg.selectEventName, {
                        detail: selectionData,
                    }));
                }

                cfg.onCompanyCommitted.call(this, this.companyName, this.companyId, this.companyIdSource);

                if (this.isAddressSearchEnabled && item.lookupId) {
                    this.addressLookup(item.lookupId, cfg.resolveAddressContainer.call(this));
                }
            },

            /**
             * Commit whatever is in the name field as the captured company
             * with NO identifier vouched for it — the manual-entry / lookup-off
             * path. Same funnel as selectItem(): writes state, storage, the
             * selection event, and the commit hook.
             *
             * @param {string} name
             */
            commitManualCompany(name) {
                this.search = name;
                // NOT an unconditional `companyIdEntryRequired = true`: a
                // name edit that still matches the name a registry number
                // was written for must leave that number LOCKED —
                // forgetStaleCompanyId() is the only writer of this flag on
                // this path, and only when the text has actually diverged.
                this.forgetStaleCompanyId();
                this.isCompanySelected = false;
                this.applyCompanyIdEditability();

                const selectionData = cfg.writeSelection.call(this, { company_name: name });
                if (cfg.selectEventName) {
                    window.dispatchEvent(new CustomEvent(cfg.selectEventName, {
                        detail: selectionData,
                    }));
                }
                cfg.onCompanyCommitted.call(this, name, this.companyId, this.companyIdSource);
            },

            // --- manual / search mode toggle (only where the surface supports it) ---
            enterManually(event) {
                if (!cfg.manualModeSupported) return;
                if (event) {
                    event.stopPropagation();
                    if (event.stopImmediatePropagation) event.stopImmediatePropagation();
                }
                this.abortCompanySearch();
                this.isSearchUnavailable = false;
                this.manualMode = true;
                this.isOpen = false;
                this.items = [];
                this.selectedIndex = -1;
                this.query = '';
                this.searchCompletedFor = null;
                cfg.onDropdownClear.call(this);
                cfg.writeSelection.call(this, { manual_mode: true });
                this.applyCompanyIdEditability();
                cfg.afterManualToggle.call(this, true);
            },
            enableSearch(event) {
                if (!cfg.manualModeSupported) return;
                if (event) {
                    event.stopPropagation();
                    if (event.stopImmediatePropagation) event.stopImmediatePropagation();
                }
                this.manualMode = false;
                cfg.writeSelection.call(this, { manual_mode: false });
                this.applyCompanyIdEditability();
                cfg.afterManualToggle.call(this, false);
            },

            // --- address lookup (identical across every surface that offers it) ---
            async addressLookup(lookupId, container) {
                const data = await window.twoGatewayCompanyDetail(
                    this.restBaseUrl,
                    lookupId,
                    this.isProxyAvailable === true ? null : {
                        checkoutApiUrl: this.checkoutApiUrl,
                        client: this.client,
                        clientV: this.clientV,
                        merchant: this.merchant,
                    }
                );
                if (data && data.addresses && data.addresses.length > 0) {
                    this.setAddressData(data.addresses[0], container);
                }
            },
            /**
             * Write an address from an external payload into an address form.
             *
             * TWO-25461 §2.6. The routing rules below are the same for every
             * payload this can receive — a registered-company search result, a
             * sole-trader autofill — deliberately, because special-casing the
             * source is how the two drift apart.
             *
             *   building/apartment present → LINE 1, and `street` → LINE 2
             *   building/apartment absent  → `street` → LINE 1, line 2 untouched
             *
             * Which reads backwards until you picture the address it describes:
             * where a payload names a building, the building IS the first line a
             * postal service wants and the street is its qualifier. It used to
             * put `street` in line 1 unconditionally and never write line 2 at
             * all, so a building name was simply dropped.
             *
             * NO DEDUP between the two lines even when the text is identical —
             * some real addresses legitimately repeat, and a form that silently
             * swallows the second line of one is wrong in a way the buyer cannot
             * see or correct.
             *
             * `region` goes to a state/county field where the address format has
             * one — a `region_id` select is matched by option TEXT, which is
             * lossy and known to be, hence best-effort — and otherwise is
             * appended to `city` after a comma, because dropping it loses part
             * of the address entirely.
             */
            setAddressData(address, container) {
                if (!container) {
                    if (cfg.addressContainerWarning) console.warn(cfg.addressContainerWarning);
                    return;
                }
                const text = (value) => String(value === undefined || value === null ? '' : value).trim();

                const cityInput = container.querySelector('input[name="city"]');
                const postcodeInput = container.querySelector('input[name="postcode"]');
                const line1Input = container.querySelector('input[name="street[0]"]');
                const line2Input = container.querySelector('input[name="street[1]"]');

                const street = text(address.street_address);
                // Either name, joined when the payload carries both: they are two
                // halves of one premises identifier, not alternatives to choose
                // between.
                const premises = [text(address.building), text(address.apartment)]
                    .filter((part) => part !== '')
                    .join(' ');

                const line1 = premises || street;
                // Only ever populated by the premises branch. `''` on the other
                // branch is not a write of empty — see the guard below.
                const line2 = premises ? street : '';

                if (line1Input) line1Input.value = line1;
                /*
                 * Line 2 is left ALONE, not blanked, when there is nothing to put
                 * in it. Blanking would make an autofill that happens to carry no
                 * building silently delete an apartment number the buyer typed
                 * themselves, which is a worse failure than not filling a field.
                 */
                if (line2Input && line2) line2Input.value = line2;

                const region = text(address.region);
                let city = text(address.city);
                // The comma is a SEPARATOR, so it only exists where there are two
                // things to separate. An address whose payload names a region and
                // no city would otherwise arrive with a leading comma.
                const cityWithRegion = () => (city ? city + ', ' + region : region);
                if (region) {
                    const regionSelect = container.querySelector('select[name="region_id"]');
                    const regionInput = container.querySelector('input[name="region"]');
                    if (regionSelect) {
                        const match = Array.prototype.find.call(
                            regionSelect.options || [],
                            (option) => text(option.textContent).toLowerCase() === region.toLowerCase()
                        );
                        // A select with no matching option gets nothing: writing
                        // an unmatched value onto a `region_id` select stores an
                        // id the store does not have. The comma fallback carries
                        // the region instead, so it is not lost either way.
                        if (match) {
                            regionSelect.value = match.value;
                            regionSelect.dispatchEvent(new Event('change', { bubbles: false }));
                        } else {
                            city = cityWithRegion();
                        }
                    } else if (regionInput) {
                        regionInput.value = region;
                        regionInput.dispatchEvent(new Event('input', { bubbles: false }));
                    } else {
                        city = cityWithRegion();
                    }
                }

                if (cityInput) cityInput.value = city;
                if (postcodeInput) postcodeInput.value = text(address.postal_code);

                [cityInput, postcodeInput, line1Input, line2Input].forEach((input) => {
                    if (input) input.dispatchEvent(new Event('input', { bubbles: false }));
                });
            },

            closeDropdown() {
                this.abortCompanySearch();
                this.endSearchInteraction();
                this.isSearchUnavailable = false;
                this.isOpen = false;
                this.items = [];
                this.selectedIndex = -1;
                this.query = '';
                this.searchCompletedFor = null;
                cfg.onDropdownClear.call(this);
            },
            closeCompanyList(event) {
                if (event.key === 'Tab') this.closeDropdown();
            },
        };
    };

    /**
     * Compose `source` onto `target` KEEPING ACCESSORS AS ACCESSORS.
     *
     * TWO-25332. Object spread and Object.assign copy own enumerable
     * properties BY VALUE: they invoke every getter once, at composition
     * time, and store the result as a plain data property. A component
     * composed that way carries a snapshot nothing ever updates again, so
     * every `x-show` / `x-text` / `:class` bound to a derived value paints
     * the value it had before the buyer did anything — silently, because a
     * frozen property reads exactly like a working one.
     *
     * Copying the property DESCRIPTORS instead keeps a getter a getter, so
     * it is re-evaluated on every read the way Alpine's reactivity assumes.
     *
     * @param {Object} target mutated and returned
     * @param {Object} source its own descriptors are copied onto target
     * @returns {Object} target
     */
    function twoGatewayComposeLive(target, source) {
        return Object.defineProperties(
            target,
            Object.getOwnPropertyDescriptors(source)
        );
    }

    /*
     * The shared popover's copy, translated.
     *
     * `company-search-panel.js` is framework-free by design — it reaches no
     * Magento translator — so its strings are English literals it hands back to
     * the host. This is the one place they are translated, rather than once per
     * mount point, so the two surfaces cannot say different things.
     *
     * The keys are the panel's own literals and must match them EXACTLY; a
     * mismatch is silent, degrading to the untranslated English.
     */
    window.twoGatewayPanelStrings = window.twoGatewayPanelStrings || {
        'Search for company': '<?= $escaper->escapeJs(__('Search for company')) ?>',
        'Enter %1 or more characters': '<?= $escaper->escapeJs(__('Enter %1 or more characters')) ?>',
        'No matches found': '<?= $escaper->escapeJs(__('No matches found')) ?>',
        'Company search is unavailable right now. Please try again shortly.':
            '<?= $escaper->escapeJs(__('Company search is unavailable right now. Please try again shortly.')) ?>',
        'Registered company': '<?= $escaper->escapeJs(__('Registered company')) ?>',
        'Sole trader': '<?= $escaper->escapeJs(__('Sole trader')) ?>',
        'Enter manually': '<?= $escaper->escapeJs(__('Enter manually')) ?>',
    };

    /*
     * Every live company control on the page, so a Magewire re-render can put
     * its popover back.
     *
     * TWO-25503. A re-render MORPHS the server markup over the live DOM, and
     * the popover's `span.two-company-field-wrap` is built at runtime and is in
     * no server markup, so the morph deletes it — while KEEPING the element
     * carrying this component's `x-data`, so Alpine never re-runs `init()` and
     * nothing rebuilds it. This host withholds the panel's own observer (a
     * MutationObserver per mount is how this checkout froze earlier on this
     * ticket), so the re-render's own hook is the signal.
     */
    window.twoGatewayCompanyMounts = window.twoGatewayCompanyMounts || [];

    /**
     * Dispose the identity subscription of every surface no longer in the
     * document.
     *
     * The registry is keyed on the surface's root node, so a departed root can
     * never be reached to dispose again and its subscription would go on
     * writing storage and dispatching cross-step events on every notification.
     * Driven by the re-render hook below, which is the event that actually
     * removes a surface — not by the next surface's mount.
     */
    function twoGatewayReapCaptureIdentityWatchers() {
        const registry = window.twoGatewayCaptureIdentityWatchers;
        if (!(registry instanceof Map)) return;
        registry.forEach(function (watcher, node) {
            if (!node || node.isConnected !== false) return;
            watcher.dispose();
            registry.delete(node);
        });
    }

    window.twoGatewayReapCaptureIdentityWatchers = twoGatewayReapCaptureIdentityWatchers;

    /** Rebuild every popover a re-render has just swept away, and drop dead mounts. */
    function twoGatewayRemountCompanyPopovers() {
        twoGatewayReapCaptureIdentityWatchers();
        // Over a SNAPSHOT: a remount can register a new mount, and an entry
        // appended to the array being filtered is never visited and so is
        // dropped by the assignment.
        const live = window.twoGatewayCompanyMounts.filter(function (mount) {
            if (!mount.root.isConnected) return false;
            mount.remount();
            return true;
        });
        window.twoGatewayCompanyMounts = window.twoGatewayCompanyMounts
            .filter(function (mount) {
                return live.indexOf(mount) !== -1 || mount.root.isConnected;
            });
    }

    /**
     * Watch for re-renders, once per page.
     *
     * `element.updated` fires many times per re-render and the sweep is a no-op
     * for a popover the morph left alone, so the LAST update of a cycle is what
     * settles it — which is what makes this correct without knowing where in the
     * cycle the wrapper was removed.
     */
    function twoGatewayWatchCompanyMorphs() {
        if (window.twoGatewayCompanyMorphHooked) return;
        if (!window.Magewire || typeof window.Magewire.hook !== 'function') {
            // A mount can run before Magewire has published itself, and the
            // next re-render would then reap the popover with nothing watching.
            if (window.twoGatewayCompanyMorphDeferred) return;
            window.twoGatewayCompanyMorphDeferred = true;
            window.addEventListener('load', twoGatewayWatchCompanyMorphs);
            return;
        }
        window.twoGatewayCompanyMorphHooked = true;
        window.Magewire.hook('element.updated', twoGatewayRemountCompanyPopovers);
    }

    /**
     * THE HYVÄ HALF of the shared company-capture controller (TWO-25503).
     *
     * The controller is not here and must never be again: it is
     * `Two_Gateway/js/model/company-capture-component.js`, loaded by
     * `hyva_checkout_index_index.xml` with the identity, the sole-trader flow
     * and the popover it drives. What follows is the Alpine-shaped half those
     * four ask for by name.
     *
     * One controller per PAGE, held on `window` rather than in an Alpine
     * component: Magewire rebuilds the surface on every totals, address and term
     * change, and a controller living inside one would take the buyer's captured
     * company, their minted tokens and their open signup popup down with it.
     */

    /** The live surface. Every host function reads it fresh: the component is
     * replaced on every re-render while the controller is not. */
    window.twoGatewayCaptureSurfaceCurrent = window.twoGatewayCaptureSurfaceCurrent || null;

    function twoGatewayCaptureSurface() {
        return window.twoGatewayCaptureSurfaceCurrent;
    }

    function twoGatewayOnSurface(member, args, fallback) {
        const surface = twoGatewayCaptureSurface();
        if (!surface || typeof surface[member] !== 'function') return fallback;
        return surface[member].apply(surface, args || []);
    }

    /**
     * The company-capture controller for this page, built on first use.
     *
     * @param {Object} settings the surface's own config — the same values it
     *        passes the engine, plus which of the two hosts it is.
     * @returns {Object} the shared `CompanyCaptureComponent`
     */
    window.twoGatewayCompanyCapture = window.twoGatewayCompanyCapture || function(settings) {
        if (window.twoGatewayCompanyCaptureInstance) {
            return window.twoGatewayCompanyCaptureInstance;
        }
        const Controller = window.TwoCompanyCaptureComponent;
        const identity = window.TwoCompanyIdentity;
        const Panel = window.TwoCompanySearchPanel;
        const SoleTraderFlow = window.TwoSoleTrader;
        // A CSP or deploy failure on the base module must degrade the company
        // field to a plain input, not throw out of an Alpine init().
        if (typeof Controller !== 'function'
            || typeof Panel !== 'function'
            || typeof SoleTraderFlow !== 'function'
            || !identity) {
            console.error('Two: company-capture modules are not loaded');
            return null;
        }

        const restBaseUrl = settings.restBaseUrl || '';
        let retrySignup = function () {};

        const controller = new Controller({
            config: {
                checkoutApiUrl: settings.checkoutApiUrl,
                checkoutPageUrl: settings.checkoutPageUrl,
                brand: settings.brand,
                brandVersion: settings.brandVersion,
                // WHERE the one control lives is decided server-side here — the
                // address step renders it or the tile does, never both — so this
                // answers only the controller's other question: whether "Enter
                // manually" has a later lookup to supply the number it captures.
                isCompanySearchEnabled: !!settings.manualEntryOffered,
                // The sole-trader buyer read is the one call that cannot be
                // proxied — it is authenticated by the buyer's own cookie on the
                // API's domain — so it carries this instead, and only where a
                // merchant enabled it for the browser.
                firewallToken: settings.firewallToken
            },
            Panel: Panel,
            SoleTraderFlow: SoleTraderFlow,
            identity: identity,
            search: {
                get MIN_INPUT_LENGTH() {
                    return twoGatewayOnSurface('capturePanelMinChars', [], 3);
                },
                SEARCH_DEBOUNCE_MS: 300,
                minInputLengthMessage() {
                    return twoGatewayOnSurface('capturePanelMinCharsMessage', [], '');
                },
                noResultsMessage() {
                    return twoGatewayOnSurface('capturePanelNoResultsMessage', [], '');
                },
                searchCompanies(request) {
                    return twoGatewayOnSurface(
                        'capturePanelSearch',
                        [request],
                        Promise.resolve({ items: [], unavailable: false, aborted: true })
                    );
                },
                abortActiveRequest() {
                    return twoGatewayOnSurface('capturePanelAbort', [], false);
                }
            },
            translate(text) {
                return twoGatewayOnSurface('translatePanelString', [text], text);
            },
            // Magewire has no `$.async` equivalent, and a MutationObserver per
            // mount is how this checkout froze on this ticket in the first
            // place. Each surface re-drives `refreshMount()` from its own init()
            // instead, which Magewire re-runs on every rebuild.
            observe: null,

            // `data-two-capture-active`, not `data-two-capture-field`: the
            // address-step field renderer is registered globally and mounts on
            // the delivery form AND the invoice form, so a page can hold two
            // address hosts while the controller owns exactly one popover.
            // claimCaptureField() decides which one carries the attribute.
            addressFieldSelector: '[data-two-capture-host="address"] input[data-two-capture-active]',
            tileFieldSelector: '[data-two-capture-host="tile"] input[data-two-capture-active]',
            fieldExists(selector) {
                return !!document.querySelector(selector);
            },
            // Which host renders is a server-side decision on this checkout, so
            // a virtual cart has already been accounted for by the time either
            // field exists.
            isVirtualCart() {
                return false;
            },

            // `twoGatewayGetCountryCode()` is the ONE country resolution on this
            // checkout (TWO-25461) and already falls back to the quote, so the
            // controller's own quote and last-resort reads route to it too.
            getAdjacentCountry() {
                return String(twoGatewayOnSurface('captureCountryCode', [], '') || '').toLowerCase();
            },
            getQuoteCountry() {
                return String(twoGatewayOnSurface('captureCountryCode', [], '') || '').toLowerCase();
            },
            getFallbackCountry() {
                return '';
            },
            watchCountryChanges(onChange) {
                // Captured, because Magewire replaces the address form's nodes
                // freely and a listener bound to one would not survive.
                document.addEventListener('change', function (event) {
                    const target = event.target;
                    // NAME as well as id, for the reason twoGatewayResolveCountry()
                    // gives: an address form rendered under any other namespace —
                    // a modal, an address-book form, a brand's own component —
                    // carries the same field under a different id.
                    if (!target) return;
                    const key = target.id || target.name || '';
                    if (!/country_id$/.test(key)) return;
                    onChange(String(target.value || '').toLowerCase());
                }, true);
            },

            supportedCompanyTypesUrl(country) {
                return restBaseUrl + '/rest/V1/two/supported-company-types/'
                    + encodeURIComponent(country);
            },
            applyCompanyAddress(selectedItem) {
                twoGatewayOnSurface('captureAddressLookup', [selectedItem]);
            },
            // This checkout keeps no record of what an autofill wrote, so there
            // is nothing to take back out; a buyer who changes country after an
            // autofill corrects the address themselves.
            revertAutofilledAddress() {},
            clearField(selector) {
                const field = document.querySelector(selector);
                if (!field) return;
                field.value = '';
                field.dispatchEvent(new Event('input', { bubbles: false }));
                field.focus();
                twoGatewayOnSurface('captureFieldCleared');
            },

            tokensUrl() {
                return restBaseUrl + '/rest/V1/two/get-tokens';
            },
            quoteId() {
                return twoGatewayOnSurface('captureQuoteId', [], '');
            },
            // This checkout's buyer read carries no client identification.
            apiClientParams() {
                return {};
            },
            signupPrefill() {
                return twoGatewayOnSurface('captureSignupPrefill', [], {});
            },
            signupCountry() {
                return twoGatewayOnSurface('captureSignupCountry', [], '');
            },
            applyBuyerAddress(source) {
                twoGatewayOnSurface('captureApplyBuyerAddress', [source]);
            },
            applyTelephone(phoneNumber) {
                twoGatewayOnSurface('captureApplyTelephone', [phoneNumber]);
            },
            showError(message) {
                if (typeof window.dispatchMessages !== 'function') return;
                // The merchant's own wording wins where a brand supplies one.
                const text = settings.soleTraderErrorMessage || message;
                window.dispatchMessages([{ type: 'error', text: text }], 5000);
            },
            /**
             * The blocked-popup fallback is a bound element on the tile rather
             * than DOM this builds, so the flag is all that moves here.
             */
            renderSignupPrompt(show, onRetry) {
                retrySignup = onRetry;
                twoGatewayOnSurface('captureSignupPromptVisible', [show]);
            }
        });

        controller.retrySignup = function () {
            retrySignup();
        };
        window.twoGatewayCompanyCaptureInstance = controller;
        return controller;
    };

    /**
     * The Alpine mixin every capture surface composes over its engine.
     *
     * @param {Object} options the surface's engine options, plus `restBaseUrl`,
     *        `checkoutPageUrl`, `manualEntryOffered` and `translations`.
     * @returns {Object} compose a surface's own members OVER it with
     *          `twoGatewayComposeLive`.
     */
    window.twoGatewayCaptureSurfaceMixin = window.twoGatewayCaptureSurfaceMixin || function(options) {
        const opts = options || {};
        const strings = opts.translations || window.twoGatewayPanelStrings || {};
        const surfaceCommitted = typeof opts.onCompanyCommitted === 'function'
            ? opts.onCompanyCommitted
            : function () {};
        const surfaceDropdownClear = typeof opts.onDropdownClear === 'function'
            ? opts.onDropdownClear
            : function () {};
        const surfaceCountryContext = typeof opts.resolveCountryContext === 'function'
            ? opts.resolveCountryContext
            : function () { return this.controlRoot(); };

        const engineOptions = Object.assign({}, opts, {
            resolveCountryContext: surfaceCountryContext,
            // Fixed by the shared panel, not per surface: it renders its own
            // query box and owns every mode route.
            querySplit: true,
            manualModeSupported: false,
            // The panel renders an inline "unavailable" line inside itself, so a
            // toast on top of it would say the same thing twice.
            dispatchSearchUnavailableToast: false,
            resolveNameField: function () { return this.companyNameField(); },
            // Magewire may destroy and rebuild the subtree this is mounted in
            // while a search is on the wire. Fails CLOSED: once Alpine has torn
            // the subtree down there is no root to resolve.
            searchStillValid: function () {
                const root = this.controlRoot();
                return Boolean(root) && root.isConnected;
            },
            onDropdownClear: function () {
                surfaceDropdownClear.call(this);
            }
        });

        return twoGatewayComposeLive(window.twoGatewayCompanySearchEngine(engineOptions), {
            // Mirrors of the shared identity, so the templates bind reactive
            // Alpine state rather than reaching into the controller.
            manualMode: false,
            showSoleTrader: false,
            showPopupMessage: false,
            soleTraderBusy: false,

            /**
             * NOT `$root` unconditionally: on the address step the control IS
             * the Alpine component, while in the payment tile it is a subtree of
             * the payment form's, whose `$root` is the whole `<form>`.
             *
             * @returns {HTMLElement|null}
             */
            controlRoot() {
                const root = this.$root;
                if (!root) return null;
                if (root.classList && root.classList.contains('two-company-search')) {
                    return root;
                }
                return typeof root.querySelector === 'function'
                    ? root.querySelector('.two-company-search')
                    : null;
            },

            /**
             * `$el` FIRST, then a lookup under the control root: Alpine resolves
             * `$el` per expression, so it is the input only when a method is
             * reached from the field's own `@input` binding.
             *
             * @returns {HTMLInputElement|null}
             */
            companyNameField() {
                const selector = 'input[data-two-capture-field]';
                const el = this.$el;
                if (el && typeof el.matches === 'function' && el.matches(selector)) {
                    return el;
                }
                const root = this.controlRoot();
                return root ? root.querySelector(selector) : null;
            },

            /**
             * @param {string} text one of the shared popover's English literals
             * @returns {string}
             */
            translatePanelString(text) {
                return Object.prototype.hasOwnProperty.call(strings, text)
                    ? strings[text]
                    : text;
            },

            capturePanelMinChars() {
                return this.minSearchChars;
            },
            capturePanelMinCharsMessage() {
                return this.translatePanelString('Enter %1 or more characters')
                    .replace('%1', this.minSearchChars);
            },
            capturePanelNoResultsMessage() {
                return this.translatePanelString('No matches found');
            },
            /**
             * `runCompanySearch()` populates state and resolves void, so the
             * answer is read off the engine afterwards rather than returned.
             *
             * @param {{term: string}} request
             * @returns {Promise<{items: Array, unavailable: boolean, aborted: boolean}>}
             */
            async capturePanelSearch(request) {
                // With company search off — an admin setting, or an API key that
                // has not verified — nothing was asked, so `aborted` rather than
                // empty results: there is nothing to report.
                if (!this.isCompanySearchEnabled || this.manualMode) {
                    return { items: [], unavailable: false, aborted: true };
                }
                await this.runCompanySearch(request.term);
                // Still searching means a later call superseded this one and
                // owns the state now; painting from it would show the buyer
                // results for a term they typed past.
                if (this.isSearching) {
                    return { items: [], unavailable: false, aborted: true };
                }
                return {
                    items: (this.items || []).map(function (item) {
                        return {
                            text: item.companyName,
                            html: item.companyDisplayName,
                            companyId: item.companyId,
                            // Never synthesised: an absent lookupId is what
                            // disables address autofill.
                            lookupId: item.lookupId
                        };
                    }),
                    unavailable: Boolean(this.isSearchUnavailable),
                    aborted: false
                };
            },
            /** @returns {boolean} whether anything was actually in flight */
            capturePanelAbort() {
                const wasInFlight = Boolean(this.searchAbortController);
                this.abortCompanySearch();
                return wasInFlight;
            },

            captureCountryCode() {
                return this.resolveCountryCode(this.getCaptureQuote());
            },
            captureQuoteId() {
                return String(this.getCaptureQuote().quote_id || '');
            },
            captureAddressLookup(selectedItem) {
                if (!this.isAddressSearchEnabled || !selectedItem.lookupId) return;
                this.addressLookup(selectedItem.lookupId, this.resolveCaptureAddressContainer());
            },
            captureApplyBuyerAddress(source) {
                this.setAddressData(source, window.twoGatewayInvoiceRoleAddressForm());
            },
            /**
             * A phone number is not part of the address the buyer is being shown
             * a company for, so unlike the address itself this one field follows
             * the merchant's autopopulation setting (TWO-25461 §5).
             */
            captureApplyTelephone(phoneNumber) {
                const phone = String(phoneNumber || '').trim();
                if (!phone || !this.isAddressAutopopulationEnabled) return;
                const container = window.twoGatewayInvoiceRoleAddressForm();
                const field = container && container.querySelector('input[name="telephone"]');
                if (!field) return;
                field.value = phone;
                field.dispatchEvent(new Event('input', { bubbles: false }));
            },
            /**
             * Every value is the quote's, so the hosted form the buyer lands on
             * describes the order they are placing.
             */
            captureSignupPrefill() {
                const quote = this.getCaptureQuote();
                return {
                    email: String(quote.email || '').trim().toLowerCase(),
                    first_name: quote.first_name || '',
                    last_name: quote.last_name || '',
                    company_name: this.companyName || '',
                    phone_number: quote.telephone || '',
                    billing_address: { country_code: this.captureSignupCountry() }
                };
            },
            /**
             * SERVER-RESOLVED, off the quote and never an address-form field:
             * PDEV-4669 makes this the country whose identity checks the buyer
             * faces, so a DOM read would let them pick their own.
             */
            captureSignupCountry() {
                const quote = this.getCaptureQuote();
                return String(quote.billing_country_id || quote.country_id || '')
                    .trim()
                    .toUpperCase();
            },
            captureSignupPromptVisible(show) {
                this.showPopupMessage = !!show;
            },
            captureFieldCleared() {
                this.search = '';
                this.captureFieldReleased();
            },

            /** @returns {Object} the quote this surface reads, plain and detached */
            getCaptureQuote() {
                const quote = this.quote || this.quoteData || {};
                return quote;
            },
            resolveCaptureAddressContainer() {
                return typeof opts.resolveAddressContainer === 'function'
                    ? opts.resolveAddressContainer.call(this)
                    : null;
            },

            /**
             * Point the one page-level controller at this surface. Called from
             * each surface's init(), which Magewire re-runs on every rebuild, so
             * this re-points rather than building a second controller.
             */
            mountCompanyPopover() {
                // NO POPOVER AT ALL where the lookup is switched off. The field
                // still renders, because the checkout needs one either way, but
                // the popover must not take it: it moves every keystroke into a
                // query box whose searches can never run, and the way out is shut
                // too because the manual chip is withheld for the same reason.
                if (!this.isCompanySearchEnabled) return;
                // The tile's `isCompanySearchEnabled` is a constant, so where
                // the address step owns the control the CLAIM is the only thing
                // stopping the tile pointing every host function at itself.
                const owns = this.claimCaptureField();
                // Mirrored either way. Where the ADDRESS step owns the control
                // this tile still paints from the identity — the sole-trader
                // progress row, the "select a different sole trader" link and the
                // order-intent verdict all read state only the mirror writes.
                // After the claim, never before: the mirror re-reads ownership on
                // every notification and the claim is what answers it.
                this.followCapturedIdentity();
