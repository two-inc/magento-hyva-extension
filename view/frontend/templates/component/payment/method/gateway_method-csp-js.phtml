                 * A second way a reply can be stale, beyond `seq` (review
                 * round 4): a MAGEWIRE REMOUNT. `initialize()` reassigns
                 * `twoPaymentComponentInstance` on every remount, but this
                 * closure captured the OLD `component` when the request went
                 * out. A re-render mid-flight (the tile's own comments
                 * elsewhere name totals/address/term changes as triggers)
                 * tears down that instance, and writing to it strands the
                 * verdict on a component nothing renders any more — the live
                 * one never learns it. Re-resolve against the CURRENT
                 * `twoPaymentComponentInstance` and drop the reply if it no
                 * longer matches, the same "fails closed" shape as the search
                 * control's own `searchStillValid`.
                 *
                 * What this does NOT catch: the buyer picking B (dispatches)
                 * then reverting to an already-decided A before B replies.
                 * The dedup gate above skips a new dispatch for that revert —
                 * by design, so re-selecting a decided company costs no
                 * request — which means `seq` is unchanged and this guard
                 * passes B's reply through. `processOrderIntentSuccessResponse()`
                 * itself is what refuses to paint that reply's verdict under
                 * A's live name; see its own comment.
                 *
                 * @returns {boolean} whether the reply is still safe to apply
                 */
                const stillLive = () => {
                    if (seq !== orderIntentSeq) return false;
                    if (twoPaymentComponentInstance !== component) return false;
                    return true;
                };

                component.placeOrderIntent()
                    .then(response => {
                        // Superseded by a newer selection or a remount: drop
                        // the result silently rather than writing it to a
                        // component nothing renders any more.
                        // `processOrderIntentSuccessResponse()` itself guards
                        // the NOTICE (not the dedup bookkeeping) against the
                        // dedup-skipped-revert case — see its own comment.
                        if (!stillLive()) return;
                        component.processOrderIntentSuccessResponse(
                            response,
                            requestedCompanyId,
                            requestedCompanyName
                        );
                    })
                    .catch(error => {
                        if (!stillLive()) return;
                        component.processOrderIntentErrorResponse(
                            error,
                            requestedCompanyId,
                            requestedCompanyName
                        );
                    })
                    .finally(() => {
                        // Only the CURRENT request on the CURRENT instance
                        // takes the spinner down. A stale one finishing late
                        // must not, or the tile stops showing progress while a
                        // live check is still running — and a dead instance
                        // has no spinner left to take down at all. Unlike the
                        // two branches above, this runs regardless of which
                        // company is live: the spinner belongs to "is a check
                        // in flight", not to any one company's verdict.
                        if (!stillLive()) return;
                        // Lowering the row IS the re-derive — see
                        // setOrderIntentChecking(). A second explicit refresh here
                        // was the same "two things to remember to pair" duality
                        // that rule exists to remove.
                        component.setOrderIntentChecking(false);
                    });
                return true;
            };

            if (!executeOrderIntent()) {
                setTimeout(() => {
                    // Second and last attempt. If the component still is not
                    // there, take the spinner down if we can reach one at all —
                    // a spinner with nothing behind it is worse than none.
                    if (!executeOrderIntent() && twoPaymentComponentInstance) {
                        twoPaymentComponentInstance.setOrderIntentChecking(false);
                    }
                }, 100);
            }
        }, 500); // 500ms debounce, for deduplication of rapid dispatches
    });
