                const component = twoPaymentComponentInstance;
                if (!component) {
                    return false;
                }

                if (!component.isOrderIntentEnabled) {
                    component.setOrderIntentChecking(false);
                    return true;
                }

                // Get the current company ID from the component
                const currentCompanyId = component.companyId
                    || document.getElementById("company_id")?.value || '';

                // Nothing to check, or already decided for exactly this company.
