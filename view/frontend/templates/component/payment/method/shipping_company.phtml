declare(strict_types=1);

use Two\GatewayHyva\ViewModel\CheckoutConfig;
use Two\GatewayHyva\ViewModel\GetQuoteDetails;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var ViewModelRegistry $viewModels */
/** @var CheckoutConfig $viewModel */
/** @var HyvaCsp $hyvaCsp */
/** @var Escaper $escaper */

$configModel = $viewModels->require(CheckoutConfig::class);
$quoteModel = $viewModels->require(GetQuoteDetails::class);
$hyvaCsp = $viewModels->require(HyvaCsp::class);

$checkoutApiUrl = $configModel->getCheckoutApiUrl();
$companySearchLimit = $configModel->getCompanySearchLimit();
$isAddressSearchEnabled = $configModel->getIsAddressSearchEnabled();
$isCompanySearchEnabled = $configModel->getIsCompanySearchEnabled();
$checkoutPageUrl = $configModel->getCheckoutPageUrl();
$quoteDetails = $quoteModel->getQuoteDetails() ?? [];
$quoteDetailsJson = json_encode($quoteDetails, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
?>
<input type="hidden" class="shipping-company_id" name="shipping-company_id" id="shipping-company_id" value="">
<input type="hidden" id="shipping-company" name="shipping-company" value="" autocomplete="off"/>
<script>
document.addEventListener('alpine:init', () => {

    /**
     * Initialize shipping company selection storage for new checkout sessions.
     * We detect a new session by checking if the current quote ID differs from the stored one.
     * This ensures stale company data from previous orders is cleared.
     */
    const initShippingCompanyStorage = () => {
        const quoteData = <?= $quoteDetailsJson ?>;
        const currentQuoteId = quoteData.quote_id || '';
        const storedData = JSON.parse(hyva.getBrowserStorage().getItem('shipping_company_selection') || "{}");
        const storedQuoteId = storedData.quote_id || '';

        // Clear storage if quote ID changed (new order) or if storage is empty
        if (!storedQuoteId || storedQuoteId !== currentQuoteId) {
            hyva.getBrowserStorage().setItem('shipping_company_selection', JSON.stringify({
                quote_id: currentQuoteId,
                company_name: '',
                company_id: '',
                manual_mode: false
            }));
        }
    };
    initShippingCompanyStorage();

    Alpine.data('searchInput', window['searchInput'] = () => ({
        isOpen: false,
        search: document.getElementById('shipping-company') ? document.getElementById('shipping-company').value : '',
        items: [],
        companyName: '',
        companyId: '',
        lookupId: '',
        checkoutApiUrl: '<?= $escaper->escapeJs($checkoutApiUrl) ?>',
        companySearchLimit: '<?= $escaper->escapeJs((string) $companySearchLimit) ?>',
        countryCode : "",
        isAddressSearchEnabled : '<?= $isAddressSearchEnabled ?>',
        isCompanySearchEnabled : '<?= $isCompanySearchEnabled ?>',
        quote : '<?= $quoteDetailsJson ?>',
        countrySelectionMessage : "<?= $escaper->escapeJs(__('Please select a country first')) ?>",
        searchUnavailableMessage : "<?= $escaper->escapeJs(__('Company search is unavailable. Try again, or enter details manually.')) ?>",
        countrySelectionShown: false,
        searchUnavailableShown: false,
        selectedIndex: -1,
        // Company-search request state. `isSearching` is for an in-field
        // spinner and `isSearchUnavailable` for the "try again / enter
        // manually" notice, so a failed search is never rendered as a
        // genuine zero-result one. `searchAbortController` supersedes an
        // in-flight search when the buyer types on or the component is
        // destroyed by a DOM morph.
        isSearching: false,
        isSearchUnavailable: false,
        searchAbortController: null,
        /** Cancel any in-flight company search. Safe to call repeatedly. */
        abortCompanySearch() {
            if (this.searchAbortController) {
                this.searchAbortController.abort();
                this.searchAbortController = null;
            }
            this.isSearching = false;
        },

        /**
         * End of one search interaction: allow the "unavailable" toast to fire
         * again next time.
         *
         * Deliberately NOT folded into abortCompanySearch(), which also runs at
         * the TOP of every search to supersede the previous request — resetting
         * there would re-toast on every debounced keystroke, which is the
         * throttle this latch exists to provide. It is also not reset only on a
         * successful result: that made it once per PAGE LOAD, and once the 5s
         * toast expired the buyer was back to an inert field with no signal.
         */
        endSearchInteraction() {
            this.searchUnavailableShown = false;
        },
        async getItems() {
            // Guard: Don't run if element is disconnected (being destroyed during DOM morph)
            if (!this.$el || !this.$el.isConnected) {
                // Still cancel: otherwise a fetch stays on the wire for a
                // detached instance and its controller is never released.
                this.abortCompanySearch();
                return;
            }

            this.search = this.$el.value;
            this.selectedIndex = -1;
            if (!this.isCompanySearchEnabled) {
                this.abortCompanySearch();
                return;
            }

            // Get country code using centralized helper (defined in gateway_method-csp-js.phtml)
            const quoteData = JSON.parse(this.quote);
            this.countryCode = window.twoGatewayGetCountryCode(quoteData);

            if (this.countryCode) {
                this.countrySelectionShown = false; // Reset flag when country becomes available
            }

            // Reset BEFORE the country split: clearing the country after a
            // failed search would otherwise leave this latched true, stacked
            // under the "select a country" warning.
            this.isSearchUnavailable = false;

            if (this.countryCode) {
                if (this.search.length < 3) {
                    this.abortCompanySearch();
                    this.endSearchInteraction();
                    this.items = [];
                    return;
                }

                // The second-stage setTimeout(200) that used to wrap this is
                // gone: the caller's @input.debounce already throttles
                // keystrokes, and stacking a second delay on top only made
                // the field feel slow. Cancellation is now the abort signal
                // rather than a cleared timer, which also covers a request
                // that is already on the wire.
                this.abortCompanySearch();
                const controller = new AbortController();
                this.searchAbortController = controller;
                this.isSearching = true;

                // This picker has no inline spinner markup of its own (its
                // template lives outside this module — see the note on
                // isSearchUnavailable below), so the magewire loader stays as
                // its only progress signal rather than being removed and
                // replaced with nothing.
                window.dispatchEvent(new Event('magewire:loader:start'));
                let result;
                try {
                    result = await window.twoGatewayCompanySearch({
                        checkoutApiUrl: this.checkoutApiUrl,
                        countryCode: this.countryCode,
                        query: this.search,
                        limit: this.companySearchLimit,
                        signal: controller.signal,
                    });
                } catch (error) {
                    // The helper swallows request failures itself, so reaching
                    // here means something structural (a missing global). Fail
                    // visibly rather than as an unhandled rejection, which is
                    // what the old local try/catch degraded to.
                    console.error('Company search failed:', error);
                    result = { status: 'failed', items: [] };

                } finally {
                    // Retire the loader unless a NEWER search now owns it.
                    //
                    // The magewire loader is a boolean, not a counter, so two
                    // rules have to hold at once:
                    //   - a SUPERSEDED search must not dispatch done, or it
                    //     hides the overlay while its replacement runs
                    //     (start(A), abort(A), start(B), done(A));
                    //   - a search that was aborted with NO successor MUST
                    //     dispatch done, or the overlay latches on forever and
                    //     blocks checkout. Every dismissal path — backspacing
                    //     below three characters, tab-out, picking a result,
                    //     clearing the country, a DOM-morph disconnect — is
                    //     exactly this case.
                    // `abortCompanySearch()` nulls the field synchronously and
                    // a successor assigns it synchronously in the same task, so
                    // null unambiguously means "nothing in flight".
                    if (!this.searchAbortController || this.searchAbortController === controller) {
                        window.dispatchEvent(new Event('magewire:loader:done'));
                    }
                }

                // Superseded by a newer search, or the component was
                // destroyed by a DOM morph while this was in flight. Writing
                // to a detached instance is the bug the isConnected guards
                // above were added for; stay silent — but clear our own state
                // first so the next search doesn't inherit a latched spinner.
                if (result.status === 'aborted' || this.searchAbortController !== controller) return;
                if (!this.$el || !this.$el.isConnected) {
                    this.searchAbortController = null;
                    this.isSearching = false;
                    return;
                }

                this.searchAbortController = null;
                this.isSearching = false;
                this.items = result.items;
                // This picker renders no unavailable notice of its own (see the
                // note below), so a flash message is the ONLY signal a buyer
                // gets. It has to fire on the common failure modes — timeout,
                // non-2xx, network error, degraded 200 — not just on the
                // structural error the catch above handles: those return a
                // status without throwing. Without it the buyer sees an inert
                // field, and since only selectItem() writes the hidden
                // shipping-company fields they cannot set a company at all.
                //
                // Latched once per interaction, mirroring countrySelectionShown
                // below: the search is debounced per keystroke, so a down API
                // would otherwise toast on every one.
                if (result.status === 'failed' || result.status === 'degraded') {
                    if (!this.searchUnavailableShown) {
                        this.searchUnavailableShown = true;
                        // Guarded: this runs on a failure path whose whole point
                        // is surviving a missing global, so it must not become
                        // the thing that throws.
                        if (typeof window.dispatchMessages === 'function') {
                            window.dispatchMessages([{
                                type: 'warning',
                                text: this.searchUnavailableMessage,
                            }], 5000);
                        }
                    }
                } else {
                    this.searchUnavailableShown = false;
                }
                // A timeout, non-2xx, network error or degraded 200 must not
                // be rendered as "no companies found".
                //
                // NOTE: nothing in THIS module binds `isSearchUnavailable` —
                // `searchInput` is registered into head.additional and its
                // markup lives elsewhere (and the branded overlay ships its
                // own fork of this template). So the dropdown is deliberately
                // NOT forced open on a failure here: doing so would show an
                // empty box with no explanation. The state is exposed for
                // whichever template renders it.
                this.isSearchUnavailable = result.status === 'failed' || result.status === 'degraded';
                if (this.items.length > 0) {
                    this.isOpen = true;
                }
            } else {
                // The country was cleared while a search was on the wire. Without
                // the abort, `searchAbortController` still matches and the
                // response writes items + opens the dropdown for a country the
                // buyer no longer has selected.
                this.abortCompanySearch();
                this.endSearchInteraction();
                // Only show the message once per interaction to avoid spamming
                if (!this.countrySelectionShown && this.search.length >= 3) {
                    this.countrySelectionShown = true;
                    window.dispatchMessages([{
                        type: 'warning',
                        text: this.countrySelectionMessage,
                    }], 5000);
                }
            }
        },

        selectItem(item) {
            // The buyer has chosen; anything still on the wire is stale and
            // would reopen a dropdown they have just dismissed.
            this.abortCompanySearch();
            this.endSearchInteraction();
            this.isSearchUnavailable = false;
            this.isOpen = false;
            this.items = [];
            this.selectedIndex = -1;
            this.search = item.companyName;

            // Update shipping company hidden fields only
            const shippingCompanyInput = document.getElementById('shipping-company');
            const shippingCompanyIdInput = document.getElementById('shipping-company_id');

            if (shippingCompanyInput) {
                shippingCompanyInput.value = item.companyName;
            }

            if (shippingCompanyIdInput) {
                shippingCompanyIdInput.value = item.companyId;
            }

            // Store shipping company selection data (preserve quote_id for session detection)
            const existingData = JSON.parse(hyva.getBrowserStorage().getItem('shipping_company_selection') || "{}");
            const shippingCompanySelectionData = {
                quote_id: existingData.quote_id || '',
                company_name: item.companyName,
                company_id: item.companyId,
                manual_mode: false
            };

            hyva.getBrowserStorage().setItem('shipping_company_selection', JSON.stringify(shippingCompanySelectionData));

            // Dispatch event to notify other components (payment fields will handle their own sync)
            window.dispatchEvent(new CustomEvent("shipping-company-selected", {
                detail: shippingCompanySelectionData
            }));

            const inputField = document.querySelector("#shipping-company");

            if (inputField) {
                // Dispatch a non-bubbling input event to prevent modal closure
                inputField.dispatchEvent(new Event("input", { bubbles: false }));
            }

            if (this.isAddressSearchEnabled) {
                this.addressLookup(item.lookupId);
            }

        },
        nextItem() {
            if (this.selectedIndex < this.items.length - 1) {
                this.selectedIndex++;
                this.adjustScroll();
            }
        },
        prevItem() {
            if (this.selectedIndex > 0) {
                this.selectedIndex--;
                this.adjustScroll();
            }
        },
        adjustScroll() {
            this.$nextTick(() => {
                let dropdown = document.querySelector(".max-h-select");
                let selectedItem = document.querySelectorAll("div.cursor-pointer")[this.selectedIndex];

                if (dropdown && selectedItem) {
                    let dropdownRect = dropdown.getBoundingClientRect();
                    let itemRect = selectedItem.getBoundingClientRect();

                    if (itemRect.bottom > dropdownRect.bottom) {
                        dropdown.scrollTop += itemRect.bottom - dropdownRect.bottom;
                    } else if (itemRect.top < dropdownRect.top) {
                        dropdown.scrollTop -= dropdownRect.top - itemRect.top;
                    }
                }
            });
        },
        selectHighlightedItem() {
            if (this.selectedIndex >= 0 && this.items.length > 0) {
                this.selectItem(this.items[this.selectedIndex]);
            }
        },
        closeCompanyList(event) {
            if (event.key === 'Tab') {
                // Without the abort, an in-flight search lands after the
                // buyer has tabbed away and reopens the dropdown.
                this.abortCompanySearch();
                this.endSearchInteraction();
                this.isSearchUnavailable = false;
                this.isOpen = false;
                this.items = [];
            }
        },
        async addressLookup(lookupId) {
            // Shared helper: carries the same 30s timeout as the search and
            // checks response.ok, so an error body can no longer be parsed
            // as an address payload and silently produce "no addresses".
            const data = await window.twoGatewayCompanyDetail(this.checkoutApiUrl, lookupId);
            if (data && data.addresses && data.addresses.length > 0) {
                this.setAddressData(data.addresses[0]);
            }
        },
        setAddressData(address) {
            // Find the shipping address form by traversing up from the company search field
            // This ensures we only update shipping address fields, not billing
            const shippingForm = this.$el.closest('form');

            if (!shippingForm) {
                console.warn('Could not find shipping form container');
                return;
            }

            const cityInput = shippingForm.querySelector('input[name="city"]');
            const postcodeInput = shippingForm.querySelector('input[name="postcode"]');
            const streetInput = shippingForm.querySelector('input[name="street[0]"]');

            if (cityInput) {
                cityInput.value = address.city || "";
            }

            if (postcodeInput) {
                postcodeInput.value = address.postal_code || "";
            }

            if (streetInput) {
                streetInput.value = address.street_address || "";
            }

            // Trigger 'input' event manually with controlled bubbling
            // Only trigger on fields we actually found and updated
            [cityInput, postcodeInput, streetInput].forEach(input => {
                if (input) {
                    input.dispatchEvent(new Event('input', { bubbles: false }));
                }
            });
        },
    }));


});
</script>
<?php $hyvaCsp->registerInlineScript(); ?>
