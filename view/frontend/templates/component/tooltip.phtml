declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Two\GatewayHyva\ViewModel\CheckoutConfig;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

$configModel = $viewModels->require(CheckoutConfig::class);
$aboutLinkUrl = $configModel->getAboutLinkUrl();
$aboutLinkText = $configModel->getAboutLinkText();
$aboutTooltipHtml = $configModel->getAboutTooltipHtml();
$aboutTooltipId = $configModel->getAboutTooltipId();
$aboutIconUrl = $block->getViewFileUrl('Two_GatewayHyva::images/cc/tooltip-icon.png');
?>
<?php if ($configModel->getShowAboutLink()): ?>
<div class="two-tooltip-icon">
    <?php /* noopener without noreferrer: the Referer is how the brand's own about page attributes the visit. */ ?>
    <a class="two-about-icon"
       href="<?= $escaper->escapeUrl($aboutLinkUrl) ?>"
       target="_blank"
       rel="noopener"
       aria-label="<?= $escaper->escapeHtmlAttr($aboutLinkText) ?>"
       aria-describedby="<?= $escaper->escapeHtmlAttr($aboutTooltipId) ?>"
    ><img alt="" width="20" src="<?= $escaper->escapeUrl($aboutIconUrl) ?>"></a>
    <?php /* No aria-hidden: the closed box is kept in the accessibility tree on purpose
             (custom.css fades it with opacity) so the description resolves the same
             way everywhere, and aria-hidden here would withhold it outright. */ ?>
    <?php /* Escaped and assembled by the base module — render unescaped. */ ?>
    <div class="two-tooltip-box"
         role="tooltip"
         id="<?= $escaper->escapeHtmlAttr($aboutTooltipId) ?>"><?= /* @noEscape */ $aboutTooltipHtml ?></div>
</div>
<?php endif; ?>
