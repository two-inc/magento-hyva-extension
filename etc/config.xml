<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <two_hyva>
            <general>
                <version>2.1.0</version>
            </general>
        </two_hyva>
        <!--
            Position the payment-terms surcharge in the Hyvä PHP cart totals.
            Hyvä sorts the rendered segments by sales/totals_sort (admin:
            Sales > Sales > Checkout Totals Sort Order); core defaults are
            subtotal=10, discount=20, shipping=30, tax=40, grand_total=100.
            Without an entry, a code sorts to 0 and renders above the
            subtotal. 38/39 keep both surcharge rows after shipping,
            adjacent to each other, and before tax (only integers are
            accepted, so both can't sit between 39 and 40). In "both"
            display mode the collector emits both codes; otherwise only
            two_surcharge, so two_surcharge_incl's entry is inert but
            harmless. two_other_totals (any quote total with no dedicated
            block, e.g. an unregistered fee extension) sorts at 90, after
            tax and before grand_total. Ignored by the Luma theme, which
            orders totals via jsLayout sortOrder.
        -->
        <sales>
            <totals_sort>
                <two_surcharge>38</two_surcharge>
                <two_surcharge_incl>39</two_surcharge_incl>
                <two_other_totals>90</two_other_totals>
            </totals_sort>
        </sales>
    </default>
</config>
