#!/bin/bash
# Shared local-dev admin login (TWO-25757). Magento rejects a duplicate
# username, which on a re-run is the desired end state, not a failure.
set -u

out=$(php bin/magento admin:user:create \
	--admin-user=exampleuser@two.inc \
	--admin-password=examplepassword123 \
	--admin-email=exampleuser@two.inc \
	--admin-firstname=Example \
	--admin-lastname=User 2>&1)
status=$?

echo "$out"

if [ "$status" -ne 0 ] && ! printf '%s' "$out" | grep -qi 'already exists'; then
	exit "$status"
fi
