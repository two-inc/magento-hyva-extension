+    });
+
+    afterEach(() => {
+      fetchStub.restore();
+      jest.useRealTimers();
+    });
+
+    test("leaves the tile able to search", async () => {
+      seed({
+        quote_id: CURRENT_QUOTE,
+        company_name: "",
+        company_id: "",
+        manual_mode: true,
+      });
